  --border-strong: rgba(18, 20, 26, 0.18) rgba(240, 237, 229, 0.14)
  --gold: #A9822F #D6B269
  --card-accent-consulting: #A9822F var(--accent-color)
  --card-accent-industrial: #A9822F var(--accent-color)
  --card-accent-self: #A9822F var(--accent-color)
  --card-accent-healthcare: #A9822F var(--accent-color)
  --card-accent-ai: #A9822F var(--accent-color)
  --card-accent-incident: #A9822F var(--accent-color)
  --card-accent-telecom: #A9822F var(--accent-color)
  --card-accent-predictive: #A9822F var(--accent-color)

  --btn-content: var(--accent-color) var(--accent-color)

  --btn-regular-bg: unquote("color-mix(in srgb, var(--accent-color) 10%, white)") #201B14
  --btn-regular-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 16%, white)") #201B14
  --btn-regular-bg-active: unquote("color-mix(in srgb, var(--accent-color) 22%, white)") #171410

  --btn-plain-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 9%, white)") #201B14
