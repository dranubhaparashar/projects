  --admonitions-color-tip: #0F766E #D6B269
  --admonitions-color-note: #1E3A5F #D6B269
  --admonitions-color-important: #5B4B8A #D6B269
  --admonitions-color-warning: #9A6414 #D6B269
  --admonitions-color-caution: #7F1D3A #D6B269

  --toc-badge-bg: var(--btn-regular-bg) var(--btn-regular-bg)
