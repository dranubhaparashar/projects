/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

premium-accent-slider = unquote("linear-gradient(to right, #0B132B 0%, #0F3460 16.7%, #334155 33.3%, #475569 50%, #0D6EFD 66.7%, #0891B2 83.3%, #22D3EE 100%)")

:root
  --radius-large 1rem
  --content-delay 150ms
  --accent-color #2862B9
  --premium-accent-slider premium-accent-slider

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: var(--accent-color) var(--accent-color)
  --theme-accent: var(--accent-color) var(--accent-color)
  --theme-accent-soft: unquote("color-mix(in srgb, var(--accent-color) 11%, white)") unquote("color-mix(in srgb, var(--accent-color) 24%, #101418)")
  --theme-accent-border: unquote("color-mix(in srgb, var(--accent-color) 30%, #E4E7EC)") unquote("color-mix(in srgb, var(--accent-color) 42%, rgba(255, 255, 255, 0.14))")
  --theme-accent-text: unquote("color-mix(in srgb, var(--accent-color) 88%, #17191C)") unquote("color-mix(in srgb, var(--accent-color) 62%, white)")

  --text-primary: #17191C #F2F4F7
  --text-secondary: #667085 #D0D5DD
  --text-muted: #98A2B3 #98A2B3
  --text-subtle: #B8C0CC #667085

  --page-bg: #F5F7FA #0A1017
  --card-bg: #FFFFFF #17212D
  --card-border: #D9E2EC #2D4054
  --card-shadow: 0 12px 28px rgba(15, 23, 42, 0.06) 0 16px 36px rgba(0, 0, 0, 0.24)
  --card-bg-hover: #FBFCFE #1D2A38
  --card-media-bg: #F1F5F9 #111A24
  --card-accent-consulting: #D6A84B #D6A84B
  --card-accent-industrial: #4A9EFF #4A9EFF
  --card-accent-self: #8B7CF6 #8B7CF6
  --card-accent-healthcare: #55B89B #55B89B
  --card-accent-ai: #4EC5D4 #4EC5D4

  --btn-content: var(--accent-color) unquote("color-mix(in srgb, var(--accent-color) 68%, white)")

  --btn-regular-bg: unquote("color-mix(in srgb, var(--accent-color) 10%, white)") unquote("color-mix(in srgb, var(--accent-color) 22%, #111827)")
  --btn-regular-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 16%, white)") unquote("color-mix(in srgb, var(--accent-color) 30%, #111827)")
  --btn-regular-bg-active: unquote("color-mix(in srgb, var(--accent-color) 22%, white)") unquote("color-mix(in srgb, var(--accent-color) 38%, #111827)")

  --btn-plain-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 9%, white)") unquote("color-mix(in srgb, var(--accent-color) 20%, #111827)")
  --btn-plain-bg-active: unquote("color-mix(in srgb, var(--accent-color) 6%, white)") unquote("color-mix(in srgb, var(--accent-color) 16%, #111827)")

  --btn-card-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 7%, white)") unquote("color-mix(in srgb, var(--accent-color) 18%, #111827)")
  --btn-card-bg-active: unquote("color-mix(in srgb, var(--accent-color) 14%, white)") unquote("color-mix(in srgb, var(--accent-color) 28%, #111827)")

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #17191C #F2F4F7

  --title-active: unquote("color-mix(in srgb, var(--accent-color) 88%, #17191C)") unquote("color-mix(in srgb, var(--accent-color) 68%, white)")

  --line-divider: #E4E7EC rgba(255, 255, 255, 0.10)

  --line-color: unquote("color-mix(in srgb, var(--accent-color) 18%, #E4E7EC)") rgba(255, 255, 255, 0.12)
  --meta-divider: #98A2B3 rgba(255, 255, 255, 0.24)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: unquote("color-mix(in srgb, var(--accent-color) 18%, white)") unquote("color-mix(in srgb, var(--accent-color) 34%, #111827)")
  --codeblock-selection: unquote("color-mix(in srgb, var(--accent-color) 34%, #111827)")
  --codeblock-bg: #111827 #0B1018
  --codeblock-topbar-bg: #1F2937 #111827

  --license-block-bg: rgba(16, 24, 40, 0.04) var(--codeblock-bg)

  --link-underline: unquote("color-mix(in srgb, var(--accent-color) 26%, white)") unquote("color-mix(in srgb, var(--accent-color) 44%, #111827)")
  --link-hover: unquote("color-mix(in srgb, var(--accent-color) 18%, white)") unquote("color-mix(in srgb, var(--accent-color) 36%, #111827)")
  --link-active: unquote("color-mix(in srgb, var(--accent-color) 24%, white)") unquote("color-mix(in srgb, var(--accent-color) 44%, #111827)")

  --float-panel-bg: rgba(255, 255, 255, 0.98) rgba(17, 24, 39, 0.96)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: premium-accent-slider premium-accent-slider

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: #0F766E unquote("color-mix(in srgb, #0F766E 72%, white)")
  --admonitions-color-note: #1E3A5F unquote("color-mix(in srgb, #1E3A5F 68%, white)")
  --admonitions-color-important: #5B4B8A unquote("color-mix(in srgb, #5B4B8A 72%, white)")
  --admonitions-color-warning: #9A6414 unquote("color-mix(in srgb, #9A6414 72%, white)")
  --admonitions-color-caution: #7F1D3A unquote("color-mix(in srgb, #7F1D3A 72%, white)")

  --toc-badge-bg: var(--btn-regular-bg) var(--btn-regular-bg)
  --toc-btn-hover: unquote("color-mix(in srgb, var(--accent-color) 10%, white)") unquote("color-mix(in srgb, var(--accent-color) 18%, #111827)")
  --toc-btn-active: unquote("color-mix(in srgb, var(--accent-color) 16%, white)") unquote("color-mix(in srgb, var(--accent-color) 26%, #111827)")
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--accent-color) unquote("color-mix(in srgb, var(--accent-color) 70%, white)")
})
