/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

premium-accent-slider = unquote("linear-gradient(to right, #5E1F33 0%, #822B41 20%, #B32545 40%, #C99A3F 60%, #D6B269 70%, #1F7A55 80%, #2F5FA8 100%)")

:root
  --radius-large 1rem
  --radius-card 1.125rem
  --radius-control 0.7rem
  --content-delay 150ms
  --accent-color #822B41
  --premium-accent-slider premium-accent-slider

:root.dark
  /* Gold is the default; a deliberate dark picker value remains authoritative. */
  --accent-color #D6B269
  --premium-accent-slider premium-accent-slider

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: var(--accent-color) var(--accent-color)
  --theme-accent: var(--accent-color) var(--accent-color)
  --accent-hover: #A7445D #E2C27C
  --theme-accent-hover: var(--accent-hover) var(--accent-hover)
  --text-on-accent: #FFFFFF #0D0C0A
  --theme-accent-soft: unquote("color-mix(in srgb, var(--accent-color) 11%, white)") #201B14
  --theme-accent-border: unquote("color-mix(in srgb, var(--accent-color) 30%, rgba(18, 20, 26, 0.10))") rgba(240, 237, 229, 0.14)
  --theme-accent-text: unquote("color-mix(in srgb, var(--accent-color) 88%, #16181D)") var(--accent-color)

  --text-primary: #16181D #F0EDE6
  --text-secondary: #5B6069 #A19C90
  --text-muted: #8A9098 #6E685C
  --text-subtle: #8A9098 #6E685C

  --page-bg: #F8F6F1 #0D0C0A
  --card-bg: #FFFFFF #171410
  --surface-2: #F1ECE3 #201B14
  --card-border: rgba(18, 20, 26, 0.10) rgba(240, 237, 229, 0.10)
  --card-shadow: unquote("0 14px 32px -24px rgba(18, 20, 26, 0.35)") unquote("0 14px 32px -24px rgba(0, 0, 0, 0.62)")
  --card-shadow-hover: unquote("0 18px 36px -22px rgba(18, 20, 26, 0.42)") unquote("0 18px 36px -22px rgba(0, 0, 0, 0.72)")
  --card-bg-hover: #FFFFFF #201B14
  --card-media-bg: var(--surface-2) var(--surface-2)
  --surface-elevated: #FFFFFF #171410
