/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))
rainbow-dark = linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.64 0.18 var(--hue)) oklch(0.76 0.15 var(--hue))
  --page-bg-base: oklch(0.98 0.01 235) oklch(0.09 0.02 245)
  --page-bg-layer: unquote("linear-gradient(135deg, rgba(238, 244, 255, 0.96) 0%, rgba(231, 240, 255, 0.92) 42%, rgba(241, 237, 255, 0.94) 100%), radial-gradient(circle at 12% 8%, rgba(37, 99, 235, 0.20) 0%, rgba(37, 99, 235, 0.07) 20%, transparent 44%), radial-gradient(circle at 88% 18%, rgba(124, 58, 237, 0.14) 0%, rgba(124, 58, 237, 0.05) 16%, transparent 38%), radial-gradient(circle at 48% 92%, rgba(8, 145, 178, 0.14) 0%, rgba(8, 145, 178, 0.05) 18%, transparent 42%)")
  --page-bg-base-dark: oklch(0.08 0.02 245)
  --page-bg-layer-dark: unquote("linear-gradient(135deg, rgba(2, 6, 23, 0.98) 0%, rgba(15, 23, 42, 0.97) 48%, rgba(17, 24, 39, 0.98) 100%), radial-gradient(circle at 12% 8%, rgba(37, 99, 235, 0.26) 0%, rgba(37, 99, 235, 0.08) 20%, transparent 44%), radial-gradient(circle at 88% 18%, rgba(124, 58, 237, 0.18) 0%, rgba(124, 58, 237, 0.06) 16%, transparent 38%), radial-gradient(circle at 48% 92%, rgba(8, 145, 178, 0.16) 0%, rgba(8, 145, 178, 0.05) 18%, transparent 42%)")
  --card-bg: rgba(255, 255, 255, 0.92) rgba(15, 23, 42, 0.72)
  --card-border: rgba(37, 99, 235, 0.14) rgba(96, 165, 250, 0.18)
  --card-shadow: 0 18px 45px rgba(15, 23, 42, 0.12) 0 24px 60px rgba(2, 6, 23, 0.30)

  --btn-content: oklch(0.50 0.16 var(--hue)) oklch(0.79 0.11 var(--hue))

  --btn-regular-bg: oklch(0.92 0.03 var(--hue)) oklch(0.28 0.05 var(--hue))
  --btn-regular-bg-hover: oklch(0.88 0.05 var(--hue)) oklch(0.34 0.05 var(--hue))
  --btn-regular-bg-active: oklch(0.82 0.08 var(--hue)) oklch(0.40 0.06 var(--hue))

  --btn-plain-bg-hover: oklch(0.93 0.03 var(--hue)) oklch(0.25 0.045 var(--hue))
  --btn-plain-bg-active: oklch(0.97 0.01 var(--hue)) oklch(0.22 0.035 var(--hue))

  --btn-card-bg-hover: oklch(0.96 0.01 var(--hue)) oklch(0.25 0.04 var(--hue))
  --btn-card-bg-active: oklch(0.88 0.04 var(--hue)) oklch(0.30 0.05 var(--hue))

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.22 0.03 var(--hue))

  --title-active: oklch(0.55 0.14 var(--hue))

  --line-divider: black(0.08) white(0.08)

  --line-color: black(0.1) white(0.1)
  --meta-divider: black(0.2) white(0.2)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.86 0.07 var(--hue)) oklch(0.38 0.10 var(--hue))
  --codeblock-selection: oklch(0.36 0.10 var(--hue))
  --codeblock-bg: oklch(0.16 0.02 var(--hue)) oklch(0.16 0.02 var(--hue))
  --codeblock-topbar-bg: oklch(0.26 0.03 var(--hue)) oklch(0.10 0.02 var(--hue))

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.90 0.06 var(--hue)) oklch(0.42 0.10 var(--hue))
  --link-hover: oklch(0.92 0.05 var(--hue)) oklch(0.44 0.10 var(--hue))
  --link-active: oklch(0.86 0.07 var(--hue)) oklch(0.38 0.08 var(--hue))

  --float-panel-bg: rgba(255, 255, 255, 0.92) rgba(15, 23, 42, 0.82)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: linear-gradient(to right, oklch(0.66 0.18 225), oklch(0.68 0.18 195), oklch(0.64 0.16 265)) linear-gradient(to right, oklch(0.58 0.14 225), oklch(0.62 0.15 195), oklch(0.58 0.13 265))

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0.14 180) oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250) oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310) oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60) oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25) oklch(0.65 0.2 25)

  --toc-badge-bg: oklch(0.86 0.06 var(--hue)) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.90 0.02 var(--hue)) oklch(0.18 0.03 var(--hue))
  --toc-btn-active: oklch(0.86 0.03 var(--hue)) oklch(0.22 0.03 var(--hue))
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.62 0.16 var(--hue)) oklch(0.42 0.10 var(--hue))
})
