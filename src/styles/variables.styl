/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

premium-accent-slider = unquote("linear-gradient(to right, #0D4FC7 0%, #1264E8 20%, #2488FF 40%, #43D7FF 60%, #5B70FF 80%, #8178FF 100%)")

:root
  --radius-large 1rem
  --radius-card 0.9rem
  --radius-control 0.6rem
  /* Shared aliases map to the established palette and component scales. */
  --surface var(--card-bg)
  --border-subtle var(--border-soft)
  --radius-sm 0.4rem
  --radius-md var(--radius-control)
  --radius-lg var(--radius-card)
  --shadow-sm 0 12px 30px -26px rgba(30, 59, 82, 0.28)
  --shadow-md var(--card-shadow)
  --space-xs 0.375rem
  --space-sm 0.625rem
  --space-md 1rem
  --space-lg 1.5rem
  --space-xl 2.25rem
  --content-delay 150ms
  --accent-color #1264E8
  --premium-accent-slider premium-accent-slider

:root.dark
  /* Cyan is the default; a deliberate picker value remains authoritative. */
  --accent-color #43D7FF
  --premium-accent-slider premium-accent-slider

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --bg-deep: #E6EDF0 #03080E
  --bg-base: #F6F7F5 #050C14
  --bg-elevated: #F1F4F5 #08121D
  --bg-soft: #EAF0F3 #0A1723
  --primary: var(--accent-color) var(--accent-color)
  --theme-accent: var(--accent-color) var(--accent-color)
  --accent-hover: #2488FF #73E4FF
  --theme-accent-hover: var(--accent-hover) var(--accent-hover)
  --text-on-accent: #FFFFFF #03111C
  --theme-accent-soft: unquote("color-mix(in srgb, var(--accent-color) 9%, #F6F7F5)") rgba(67, 215, 255, 0.075)
  --theme-accent-border: unquote("color-mix(in srgb, var(--accent-color) 28%, rgba(43, 78, 108, 0.14))") rgba(91, 205, 242, 0.28)
  --theme-accent-text: unquote("color-mix(in srgb, var(--accent-color) 88%, #091827)") #73E4FF

  --text-primary: #101923 #F4F8FB
  --text-secondary: #526475 #9AAFC0
  --text-muted: #718597 #6C849A
  --text-subtle: #8A9AA8 #5E778C

  --page-bg: var(--bg-base) var(--bg-base)
  --card-bg: rgba(241, 244, 245, 0.56) rgba(8, 18, 29, 0.38)
  --surface-transparent: rgba(241, 244, 245, 0.42) rgba(8, 18, 29, 0.38)
  --surface-hover: rgba(250, 252, 252, 0.82) rgba(10, 23, 35, 0.70)
  --control-bg: rgba(234, 240, 243, 0.72) rgba(8, 18, 29, 0.68)
  --surface-2: var(--bg-soft) var(--bg-soft)
  --card-border: rgba(65, 101, 130, 0.11) rgba(123, 181, 218, 0.10)
  --card-shadow: none none
  --card-shadow-hover: unquote("0 0 38px rgba(18, 100, 232, 0.045)") unquote("0 0 40px rgba(67, 215, 255, 0.055)")
  --card-bg-hover: var(--surface-hover) var(--surface-hover)
  --card-media-bg: var(--surface-2) var(--surface-2)
  --surface-elevated: var(--bg-elevated) var(--bg-elevated)
  --border-soft: rgba(65, 101, 130, 0.11) rgba(123, 181, 218, 0.10)
  --border-default: rgba(65, 101, 130, 0.14) rgba(123, 181, 218, 0.14)
  --border-hover: rgba(36, 136, 255, 0.28) rgba(67, 215, 255, 0.30)
  --border-strong: rgba(65, 101, 130, 0.20) rgba(123, 181, 218, 0.18)
  --gold: var(--accent-color) var(--accent-color)
  --card-accent-consulting: var(--accent-color) var(--accent-color)
  --card-accent-industrial: var(--accent-color) var(--accent-color)
  --card-accent-self: var(--accent-color) var(--accent-color)
  --card-accent-healthcare: var(--accent-color) var(--accent-color)
  --card-accent-ai: var(--accent-color) var(--accent-color)
  --card-accent-incident: var(--accent-color) var(--accent-color)
  --card-accent-telecom: var(--accent-color) var(--accent-color)
  --card-accent-predictive: var(--accent-color) var(--accent-color)

  --btn-content: var(--accent-color) var(--accent-color)

  /* Quiet premium interaction primitives shared by cards, links, and metadata. */
  --action-primary-bg: rgba(18, 100, 232, 0.08) rgba(8, 31, 50, 0.92)
  --action-primary-bg-hover: rgba(18, 100, 232, 0.13) rgba(10, 40, 62, 0.96)
  --action-primary-border: rgba(18, 100, 232, 0.24) rgba(67, 215, 255, 0.22)
  --action-primary-border-hover: rgba(18, 100, 232, 0.38) rgba(67, 215, 255, 0.36)
  --action-primary-text: #123F6B #F4F8FB
  --link-default: #496A83 #8AA6BC
  --chip-bg: rgba(65, 101, 130, 0.025) rgba(8, 18, 29, 0.18)
  --metric-bg: rgba(36, 136, 255, 0.025) rgba(36, 136, 255, 0.025)
  --image-edge-overlay: unquote("linear-gradient(to bottom, rgba(3, 8, 14, 0.08), transparent 22%, transparent 72%, rgba(3, 8, 14, 0.32)), linear-gradient(90deg, rgba(3, 8, 14, 0.10), transparent 12%, transparent 88%, rgba(3, 8, 14, 0.10))") unquote("linear-gradient(to bottom, rgba(3, 8, 14, 0.16), transparent 22%, transparent 68%, rgba(3, 8, 14, 0.52)), linear-gradient(90deg, rgba(3, 8, 14, 0.16), transparent 12%, transparent 88%, rgba(3, 8, 14, 0.16))")

  --btn-regular-bg: unquote("color-mix(in srgb, var(--accent-color) 8%, #FBFCFC)") rgba(52, 135, 255, 0.11)
  --btn-regular-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 13%, #FBFCFC)") rgba(69, 216, 255, 0.14)
  --btn-regular-bg-active: unquote("color-mix(in srgb, var(--accent-color) 18%, #FBFCFC)") rgba(69, 216, 255, 0.18)

  --btn-plain-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 8%, #F6F7F5)") rgba(69, 216, 255, 0.09)
  --btn-plain-bg-active: unquote("color-mix(in srgb, var(--accent-color) 12%, #F6F7F5)") rgba(69, 216, 255, 0.13)

  --btn-card-bg-hover: unquote("color-mix(in srgb, var(--accent-color) 7%, #F6F7F5)") rgba(52, 135, 255, 0.11)
  --btn-card-bg-active: unquote("color-mix(in srgb, var(--accent-color) 14%, #F6F7F5)") rgba(69, 216, 255, 0.16)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: #07111D #03111C

  --title-active: var(--accent-hover) var(--accent-hover)

  --line-divider: rgba(65, 101, 130, 0.10) rgba(123, 181, 218, 0.085)

  --line-color: rgba(65, 101, 130, 0.10) rgba(123, 181, 218, 0.085)
  --meta-divider: #8797A5 #5E788D

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: unquote("color-mix(in srgb, var(--accent-color) 18%, #F6F7F5)") rgba(69, 216, 255, 0.24)
  --codeblock-selection: unquote("color-mix(in srgb, var(--accent-color) 34%, #091827)") rgba(52, 135, 255, 0.38)
  --codeblock-bg: #091827 #07111D
  --codeblock-topbar-bg: #0E1C2B #0B1522

  --license-block-bg: rgba(16, 24, 40, 0.04) var(--codeblock-bg)

  --link-underline: unquote("color-mix(in srgb, var(--accent-color) 24%, white)") rgba(67, 215, 255, 0.24)
  --link-hover: var(--accent-hover) var(--accent-hover)
  --link-active: var(--accent-color) var(--accent-color)

  --float-panel-bg: rgba(246, 249, 250, 0.96) rgba(5, 12, 20, 0.96)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: premium-accent-slider premium-accent-slider

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: #0F766E #43D7FF
  --admonitions-color-note: #1E3A5F #2488FF
  --admonitions-color-important: #5B4B8A #8178FF
  --admonitions-color-warning: #9A6414 #64B5F6
  --admonitions-color-caution: #7F1D3A #596BFF

  --toc-badge-bg: var(--btn-regular-bg) var(--btn-regular-bg)
  --toc-btn-hover: unquote("color-mix(in srgb, var(--accent-color) 10%, #F6F7F5)") rgba(69, 216, 255, 0.10)
  --toc-btn-active: unquote("color-mix(in srgb, var(--accent-color) 16%, #F6F7F5)") rgba(52, 135, 255, 0.16)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--accent-color) var(--accent-color)
})
