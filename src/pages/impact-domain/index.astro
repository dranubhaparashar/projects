<h1></h1>---
import CapabilityMatrix from "@components/impact-domain/CapabilityMatrix.astro";
import ProjectComparison from "@components/impact-domain/ProjectComparison.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { buildProjectCapabilityMatrixData } from "@utils/project-capability-matching";
import { buildProjectComparisonData } from "@utils/project-comparison-data";
import { buildProjectImpactGraphData } from "@utils/project-impact-data";
import { buildPortfolioKnowledgeIndex } from "@utils/project-intelligence-index";
import { url } from "@utils/url-utils";

const pageTitle = "Project Impact Landscape";
const pageDescription =
	"Explore how my AI projects connect across industries, research areas, technologies and real-world impact domains.";
const posts = (await getSortedPosts()).filter(
	(entry) => entry.data.draft !== true,
);
const graphData = buildProjectImpactGraphData(posts);
const graphDataJson = JSON.stringify(graphData).replace(/</g, "\\u003c");
const portfolioIndex = buildPortfolioKnowledgeIndex(posts);
const capabilityData = buildProjectCapabilityMatrixData(posts, portfolioIndex);
const comparisonData = buildProjectComparisonData(
	posts,
	portfolioIndex,
	capabilityData,
);
const capabilityDataJson = JSON.stringify(capabilityData).replace(
	/</g,
	"\\u003c",
);
const comparisonDataJson = JSON.stringify(comparisonData).replace(
	/</g,
	"\\u003c",
);
const projectById = new Map(
	graphData.projects.map((project) => [project.id, project]),
);
const edgeByPair = new Map(
	graphData.edges.map((edge) => [
		[edge.source, edge.target].sort().join("::"),
		edge,
	]),
);
const groupedProjects = graphData.domains
	.map((domain) => ({
		domain,
		projects: graphData.projects.filter(
			(project) => project.primaryDomain === domain.name,
		),
	}))
	.filter((group) => group.projects.length > 0);

function getRelationship(projectId: string, relatedId: string) {
	return edgeByPair.get([projectId, relatedId].sort().join("::"));
}

function getRelatedProjects(projectId: string) {
	const project = projectById.get(projectId);
	if (!project) return [];
	return project.relatedProjects
		.map((relatedId) => ({
			project: projectById.get(relatedId),
			edge: getRelationship(projectId, relatedId),
		}))
		.filter((item) => item.project);
}
---

<MainGridLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<link rel="stylesheet" href={url("/assets/css/project-impact-graph.css")} />
		<link rel="stylesheet" href={url("/assets/css/project-capabilities.css")} />
	</Fragment>

	<section
		id="project-impact-app"
		class="project-impact-shell card-base"
		data-impact-app
		aria-labelledby="impact-domain-title"
	>
		<header class="project-impact-header">
			<div>
				<p class="impact-header-eyebrow">Interactive project knowledge graph</p>
				<h1 id="impact-domain-title" class="project-impact-title hero-title">
					{pageTitle}
				</h1>
				<p class="project-impact-subtitle text-75">{pageDescription}</p>
			</div>
			<div class="project-impact-summary" aria-label={`${graphData.projects.length} published projects, ${graphData.domains.length} impact domains and ${graphData.edges.length} project relationships`}>
				<div class="impact-summary-metric">
					<strong>{graphData.projects.length}</strong>
					<span>Projects</span>
				</div>
				<div class="impact-summary-metric">
					<strong>{graphData.domains.length}</strong>
					<span>Impact Domains</span>
				</div>
				<div class="impact-summary-metric">
					<strong>{graphData.edges.length}</strong>
					<span>Relationships</span>
				</div>
			</div>
		</header>

		<div class="impact-explorer" data-impact-explorer>
			<header class="project-impact-toolbar" aria-label="Project explorer controls">
				<div class="impact-toolbar-primary">
					<div class="impact-segmented" role="tablist" aria-label="Explorer display">
						<button type="button" role="tab" class="impact-view-button" data-impact-view="graph" aria-selected="true" aria-controls="impact-graph-panel">Graph</button>
						<button type="button" role="tab" class="impact-view-button" data-impact-view="list" aria-selected="false" aria-controls="impact-list-panel">Accessible List</button>
					</div>
					<div class="impact-segmented" role="group" aria-label="Graph layout">
						<button type="button" class="impact-layout-button" data-impact-layout="cluster" aria-pressed="true">Cluster</button>
						<button type="button" class="impact-layout-button" data-impact-layout="tree" aria-pressed="false">Tree</button>
					</div>
					<label class="impact-cluster-by-control">
						<span>Cluster by</span>
						<select data-impact-cluster-by aria-label="Cluster projects by">
							{graphData.clusterModes.map((mode) => (
								<option value={mode.id}>{mode.label}</option>
							))}
						</select>
					</label>
				</div>

				<p class="impact-toolbar-status" data-impact-status aria-live="polite">
					{graphData.projects.length} projects Â· {graphData.domains.length} groups Â· {graphData.edges.length} relationships
				</p>

				<div class="impact-toolbar-actions">
					<button type="button" class="impact-command-button impact-panel-toggle" data-impact-toggle="filters" aria-expanded="false" aria-controls="impact-filter-panel">
						<span data-impact-icon="filter" aria-hidden="true"></span>
						<span>Filters</span>
						<span class="impact-active-count" data-impact-filter-count hidden>0</span>
					</button>
					<button type="button" class="impact-command-button impact-panel-toggle" data-impact-toggle="legend" aria-expanded="true" aria-controls="impact-legend-panel">
						<span data-impact-icon="legend" aria-hidden="true"></span>
						<span>Legend</span>
					</button>
					<div class="impact-tree-actions" data-impact-tree-actions hidden>
						<button type="button" class="impact-command-button" data-impact-tree="expand">Expand all</button>
						<button type="button" class="impact-command-button" data-impact-tree="collapse">Collapse all</button>
					</div>
					<div class="impact-zoom-controls" aria-label="Graph zoom controls">
						<button type="button" class="impact-icon-button" data-impact-zoom="out" aria-label="Zoom out">âˆ’</button>
						<button type="button" class="impact-icon-button" data-impact-zoom="in" aria-label="Zoom in">+</button>
						<button type="button" class="impact-command-button" data-impact-fit>Fit</button>
						<button type="button" class="impact-command-button" data-impact-reset>Reset</button>
						<button type="button" class="impact-icon-button impact-fullscreen-button" data-impact-fullscreen aria-label="View explorer in full screen" aria-pressed="false" title="View explorer in full screen">
							<span data-impact-icon="maximize" data-impact-fullscreen-icon="enter" aria-hidden="true"></span>
							<span data-impact-icon="minimize" data-impact-fullscreen-icon="exit" aria-hidden="true" hidden></span>
						</button>
					</div>
				</div>
			</header>

			<div class="impact-explorer-body" data-impact-explorer-body>
				<button class="impact-panel-scrim" type="button" data-impact-close-panels aria-label="Close explorer panel" tabindex="-1" hidden></button>

				<aside id="impact-filter-panel" class="impact-filter-panel card-base" data-impact-filter-panel aria-labelledby="impact-filter-title" aria-hidden="true">
					<header class="impact-side-panel-header">
						<div>
							<p class="impact-panel-kicker">Refine the view</p>
							<h2 id="impact-filter-title">Filters</h2>
						</div>
						<button type="button" class="impact-icon-button" data-impact-close="filters" aria-label="Close filters">Ã—</button>
					</header>
					<div class="impact-filter-content">
						<label class="impact-control impact-search-control">
							<span>Search projects</span>
							<input type="search" data-impact-search placeholder="Title, technology, problemâ€¦" autocomplete="off" />
						</label>
						<label class="impact-control">
							<span>Impact Domain</span>
							<select data-impact-filter="domain">
								<option value="">All domains</option>
								{graphData.domains.map((domain) => <option value={domain.name}>{domain.name}</option>)}
							</select>
						</label>
						<label class="impact-control">
							<span>Project Type</span>
							<select data-impact-filter="category">
								<option value="">All types</option>
								{graphData.filters.categories.map((category) => <option value={category}>{category}</option>)}
							</select>
						</label>
						<label class="impact-control">
							<span>Tag</span>
							<select data-impact-filter="tag">
								<option value="">All tags</option>
								{graphData.filters.tags.map((tag) => <option value={tag}>{tag}</option>)}
							</select>
						</label>
						<label class="impact-control">
							<span>Year</span>
							<select data-impact-filter="year">
								<option value="">All years</option>
								{graphData.filters.years.map((year) => <option value={year}>{year}</option>)}
							</select>
						</label>
						<label class="impact-control">
							<span data-impact-cluster-filter-label>Impact Domain group</span>
							<select data-impact-cluster-filter>
								<option value="">All groups</option>
								{graphData.domains.map((domain) => <option value={domain.name}>{domain.name}</option>)}
							</select>
						</label>
					</div>
					<footer class="impact-filter-footer">
						<p data-impact-filter-results aria-live="polite">{graphData.projects.length} projects visible</p>
						<div>
							<button type="button" class="impact-clear-filters btn-plain" data-impact-clear-filters>Clear all</button>
							<button type="button" class="btn-regular impact-apply-filters" data-impact-apply-filters>Apply</button>
						</div>
					</footer>
				</aside>

				<div class="impact-stage" data-impact-stage>
					<div class="impact-empty-state card-base" data-impact-empty hidden>
						<strong>No projects match these filters</strong>
						<p>Try removing one or more filters, or reset the current view.</p>
						<button type="button" class="btn-regular" data-impact-clear-filters>Clear filters</button>
					</div>

					<div id="impact-graph-panel" class="impact-view-panel impact-graph-panel" data-impact-panel="graph" role="tabpanel">
						<div class="impact-graph-card card-base">
							<svg class="impact-graph-svg" data-impact-svg role="group" aria-label="Interactive project relationship graph" aria-describedby="impact-graph-help"></svg>
							<p id="impact-graph-help" class="sr-only">Use Tab to focus projects and relationships. Enter or Space selects an item. Drag to pan and use the toolbar to zoom or fit.</p>
							<div class="impact-hover-card" data-impact-hover-card aria-live="polite" hidden></div>
						</div>
					</div>

					<div id="impact-list-panel" class="impact-view-panel impact-list-panel" data-impact-panel="list" role="tabpanel">
						<div class="impact-list-heading">
							<p class="impact-panel-kicker">Accessible project view</p>
							<h2>Grouped by <span data-impact-list-group-label>Impact Domain</span></h2>
						</div>
						<div class="impact-list-content" data-impact-list>
				{groupedProjects.map(({ domain, projects }) => (
					<section class="impact-list-domain" data-list-domain={domain.name} data-list-group-id={domain.name}>
						<header class="impact-list-domain-header" style={`--domain-color: ${domain.color}`}>
							<span class="impact-list-domain-icon" data-impact-icon={domain.icon} aria-hidden="true"></span>
							<div>
								<h2>{domain.name}</h2>
								<p>{projects.length} {projects.length === 1 ? "project" : "projects"}</p>
							</div>
						</header>

						<div class="impact-list-grid">
							{projects.map((project) => (
								<article class="impact-list-project card-base" data-list-project={project.id}>
								<div class="impact-list-project-main">
									<h3>{project.title}</h3>
									<p class="impact-list-meta">{project.category} / {project.date}</p>
									<p>{project.description}</p>
									<p class="impact-list-active-cluster"><strong>Active group:</strong> {project.primaryDomain}</p>
								</div>
								<div class="impact-chip-row" aria-label={`${project.title} technologies`}>
									{project.technologies.slice(0, 8).map((technology) => <span>{technology}</span>)}
									</div>
									{project.relatedProjects.length > 0 && (
										<div class="impact-list-related">
											<h4>Related projects</h4>
											<ul>
												{getRelatedProjects(project.id).map(({ project: related, edge }) => (
													<li>
														<a href={related?.url} data-impact-select={related?.id}>{related?.title}</a>
														{edge && edge.sharedTags.length > 0 && (
															<span> through {edge.sharedTags.slice(0, 3).join(", ")}</span>
														)}
													</li>
												))}
											</ul>
										</div>
									)}
									<a class="impact-project-link btn-regular" href={project.url}>View full project</a>
								</article>
							))}
						</div>
					</section>
				))}
						</div>
					</div>
				</div>

				<aside id="impact-legend-panel" class="impact-cluster-legend card-base" data-impact-legend aria-labelledby="impact-legend-title" aria-hidden="false">
					<header class="impact-side-panel-header">
						<div>
							<p class="impact-panel-kicker">Active grouping</p>
							<h2 id="impact-legend-title" data-impact-legend-title>Impact Domains</h2>
						</div>
						<button type="button" class="impact-icon-button" data-impact-close="legend" aria-label="Close legend">Ã—</button>
					</header>
					<p class="impact-legend-help">Select a group to focus it. Hover or focus to preview its projects.</p>
					<div class="impact-legend-list" data-impact-legend-list>
						<button type="button" class="impact-legend-item is-active" data-impact-group="" aria-pressed="true">
							<span class="impact-legend-icon" data-impact-icon="network" aria-hidden="true"></span>
							<span>All groups</span>
							<strong>{graphData.projects.length}</strong>
						</button>
						{graphData.domains.map((domain) => (
							<button type="button" class="impact-legend-item" data-impact-group={domain.name} style={`--group-color: ${domain.color}`} aria-pressed="false">
								<span class="impact-legend-icon" data-impact-icon={domain.icon} aria-hidden="true"></span>
								<span>{domain.name}</span>
								<strong>{domain.count}</strong>
							</button>
						))}
					</div>
				</aside>

				<aside class="impact-details-panel card-base" data-impact-details aria-labelledby="impact-details-title" aria-hidden="true" hidden>
					<header class="impact-side-panel-header impact-details-header">
						<div>
							<p class="impact-panel-kicker">Selected project</p>
							<h2 id="impact-details-title">Project Details</h2>
						</div>
						<button type="button" class="impact-icon-button" data-impact-clear-selection aria-label="Close project details">Ã—</button>
					</header>
					<div class="impact-details-content" data-impact-details-content></div>
				</aside>
			</div>

			<div class="impact-screen-reader-summary sr-only" data-impact-sr-summary aria-live="polite"></div>
		</div>

		<noscript>
			<p class="impact-noscript text-75">
				JavaScript is disabled, so the accessible project list is shown instead of the interactive graph.
			</p>
		</noscript>

		<script is:inline id="project-impact-data" type="application/json" set:html={graphDataJson}></script>
		<script is:inline type="module" src={url("/assets/js/project-impact-graph.js")}></script>
	</section>

	<section
		id="explore-capabilities"
		class="capabilities-shell card-base"
		data-capabilities-app
		aria-labelledby="explore-capabilities-title"
	>
		<header class="capabilities-introduction">
			<h2 id="explore-capabilities-title">Explore My Capabilities</h2>
			<p>
				See what I can build, how different capabilities are used across
				projects, and compare selected systems side by side.
			</p>
		</header>

		<div class="capabilities-stack">
			<CapabilityMatrix data={capabilityData} />
			<ProjectComparison data={comparisonData} />
		</div>

		<script
			is:inline
			id="project-capability-data"
			type="application/json"
			set:html={capabilityDataJson}
		></script>
		<script
			is:inline
			id="project-comparison-data"
			type="application/json"
			set:html={comparisonDataJson}
		></script>
		<script is:inline type="module" src={url("/assets/js/project-capabilities.js")}></script>
	</section>
</MainGridLayout>

