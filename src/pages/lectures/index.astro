---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { tracks } from "./_book";

const pageTitle = "Lectures";
const pageDescription =
	"A complete, interactive book on machine learning, deep learning, reinforcement learning, large language models and AI agents. Every chapter covers the intuition, the maths, live playgrounds and a working project.";

const roman = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"];

const available = tracks.reduce(
	(n, t) => n + t.lectures.filter((l) => l.href).length,
	0,
);
const total = tracks.reduce((n, t) => n + t.lectures.length, 0);
---

<MainGridLayout title={pageTitle} description={pageDescription}>
	<section class="lectures-shell card-base" aria-labelledby="lectures-title">
		<header class="lectures-header">
			<p class="lectures-eyebrow">Teaching · the lecture book</p>
			<h1 id="lectures-title" class="lectures-title hero-title">{pageTitle}</h1>
			<p class="lectures-subtitle text-75">{pageDescription}</p>
			<nav class="lectures-jump" aria-label="Parts of the book">
				{tracks.map((t, ti) => (
					<a href={`#${t.id}`}>
						<span class="jump-short">{t.short}</span>
						<span class="jump-name">{t.name}</span>
						<span class="jump-count text-50">
							Part {roman[ti]} · {t.lectures.length}
						</span>
					</a>
				))}
			</nav>
			<p class="lectures-count text-50">
				{tracks.length} parts · {total} chapters · {available} live now, the rest being built in order
			</p>
		</header>

		{tracks.map((t, ti) => (
			<section class="lecture-track" id={t.id} aria-labelledby={`${t.id}-title`}>
				<div class="track-head">
					<span class="track-badge" aria-hidden="true">{t.short}</span>
					<div>
						<p class="track-part">
							Part {roman[ti]} · {t.lectures.length} chapters ·{" "}
							{t.lectures.filter((l) => l.href).length} live
						</p>
						<h2 id={`${t.id}-title`} class="track-title text-90">{t.name}</h2>
						<p class="track-blurb text-50">{t.blurb}</p>
					</div>
				</div>

				{t.lectures.length === 0 ? (
					<p class="track-empty text-50">Lectures for this track are coming soon.</p>
				) : (
					<ul class="lecture-list">
						{t.lectures.map((l, li) =>
							l.href ? (
								<li class={l.index ? "has-index" : undefined}>
									<article class="lecture-card is-live">
										<div class="lecture-main">
											<span class="lecture-status">
												Chapter {ti + 1}.{li + 1} · Interactive lecture
												{l.length ? ` · ${l.length}` : ""}
											</span>
											<h3 class="lecture-title text-90">
												<a class="lecture-link" href={url(l.href)}>{l.title}</a>
											</h3>
											<p class="lecture-summary text-75">{l.summary}</p>
											<ul class="lecture-topics" aria-label="Topics">
												{l.topics.map((topic) => <li>{topic}</li>)}
											</ul>
											<span class="lecture-open" aria-hidden="true">Open lecture →</span>
										</div>
										{l.index && (
											<nav class="lecture-index" aria-label={`${l.title}: lecture index`}>
												<p class="index-head">
													Lecture index <span class="text-50">· {l.index.length} stops</span>
												</p>
												<ol>
													{l.index.map(([id, label], i) => (
														<li>
															<a href={url(`${l.href}#${id}`)}>
																<span class="jump-short">{String(i + 1).padStart(2, "0")}</span>
																<span class="jump-name">{label}</span>
															</a>
														</li>
													))}
												</ol>
											</nav>
										)}
									</article>
								</li>
							) : (
								<li>
									<div class="lecture-card is-soon" aria-disabled="true">
										<span class="lecture-status">
											Chapter {ti + 1}.{li + 1} · Coming soon
										</span>
										<h3 class="lecture-title text-90">{l.title}</h3>
										<p class="lecture-summary text-75">{l.summary}</p>
										<ul class="lecture-topics" aria-label="Topics">
											{l.topics.map((topic) => <li>{topic}</li>)}
										</ul>
									</div>
								</li>
							),
						)}
					</ul>
				)}
			</section>
		))}
	</section>
</MainGridLayout>

<style>
	.lectures-shell {
		border-radius: var(--radius-large, 1rem);
		padding: clamp(1.25rem, 3vw, 2.25rem);
		display: grid;
		gap: 2.25rem;
	}
	.lectures-header {
		display: grid;
		gap: 0.75rem;
	}
	.lectures-eyebrow {
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--primary);
		font-weight: 600;
	}
	.lectures-title {
		font-size: clamp(2rem, 4.5vw, 2.9rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--deep-text, inherit);
	}
	.lectures-subtitle {
		max-width: 62ch;
		line-height: 1.65;
	}
	.lectures-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.lectures-jump a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem 0.4rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		font-size: 0.88rem;
		transition: border-color 0.2s ease;
	}
	.lectures-jump a:hover {
		border-color: var(--primary);
	}
	.jump-short {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--primary);
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
	}
	.jump-count {
		font-size: 0.72rem;
		padding-left: 0.15rem;
	}
	.track-part {
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--primary);
		margin-bottom: 0.15rem;
	}
	.lecture-card.is-soon {
		padding: 0.95rem 1.05rem;
		gap: 0.45rem;
	}
	.is-soon .lecture-title {
		font-size: 1.05rem;
	}
	.is-soon .lecture-summary {
		font-size: 0.86rem;
		line-height: 1.55;
	}
	.lectures-count {
		font-size: 0.82rem;
	}

	.lecture-track {
		display: grid;
		gap: 1rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line-divider);
		scroll-margin-top: 6rem;
	}
	.track-head {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.9rem;
		align-items: start;
	}
	.track-badge {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--primary);
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);
		background: color-mix(in srgb, var(--primary) 9%, transparent);
	}
	.track-title {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.track-blurb {
		font-size: 0.92rem;
		margin-top: 0.2rem;
		max-width: 62ch;
	}
	.track-empty {
		font-size: 0.92rem;
		padding: 1rem 1.1rem;
		border: 1px dashed var(--line-divider);
		border-radius: 0.75rem;
	}

	.lecture-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1rem;
	}
	.lecture-list > li {
		min-width: 0;
	}
	.lecture-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.15rem 1.2rem;
		border-radius: 0.85rem;
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.lecture-card.is-live:hover {
		border-color: var(--primary);
	}
	.lecture-main {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		flex: 1;
		min-width: 0;
	}
	/* the whole left column is the click target for the lecture */
	.lecture-link::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 0.6rem;
	}
	.lecture-link:focus-visible {
		outline: none;
	}
	.lecture-link:focus-visible::after {
		outline: 2px solid var(--primary);
		outline-offset: 4px;
	}
	.lecture-main:hover .lecture-open {
		text-decoration: underline;
	}

	.lecture-list > li.has-index {
		grid-column: 1 / -1;
	}
	.lecture-index {
		display: grid;
		gap: 0.6rem;
		align-content: start;
		padding-top: 0.9rem;
		border-top: 1px dashed var(--line-divider);
	}
	.index-head {
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--primary);
	}
	.index-head span {
		letter-spacing: 0.04em;
		text-transform: none;
		font-weight: 500;
	}
	.lecture-index ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.lecture-index a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.8rem 0.3rem 0.35rem;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		font-size: 0.84rem;
		line-height: 1.3;
		transition: border-color 0.2s ease;
	}
	.lecture-index a:hover {
		border-color: var(--primary);
	}
	.lecture-index a:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	@media (min-width: 60rem) {
		.has-index .lecture-card {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			gap: 1.75rem;
		}
		.has-index .lecture-index {
			padding-top: 0;
			padding-left: 1.75rem;
			border-top: 0;
			border-left: 1px dashed var(--line-divider);
		}
	}
	.lecture-card.is-soon {
		border-style: dashed;
	}
	.lecture-card.is-soon .lecture-title,
	.lecture-card.is-soon .lecture-summary {
		opacity: 0.7;
	}
	.lecture-status {
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--primary);
	}
	.is-soon .lecture-status {
		color: inherit;
		opacity: 0.55;
	}
	.lecture-title {
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.lecture-summary {
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.lecture-topics {
		list-style: none;
		margin: 0.2rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.lecture-topics li {
		font-size: 0.74rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		opacity: 0.85;
	}
	.lecture-open {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--primary);
	}
	@media (prefers-reduced-motion: reduce) {
		.lecture-card,
		.lecture-index a {
			transition: none;
		}
	}
</style>
