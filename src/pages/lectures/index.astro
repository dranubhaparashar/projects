---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";

const pageTitle = "Lectures";
const pageDescription =
	"Interactive lectures on machine learning, deep learning, reinforcement learning and large language models. Each one covers the intuition, the maths and a working project.";

type Lecture = {
	title: string;
	summary: string;
	topics: string[];
	href?: string;
};

type Track = {
	id: string;
	name: string;
	short: string;
	blurb: string;
	lectures: Lecture[];
};

// Add a lecture by appending to a track's `lectures` list.
// Lectures without an `href` show as "Coming soon".
const tracks: Track[] = [
	{
		id: "machine-learning",
		name: "Machine Learning",
		short: "ML",
		blurb:
			"Classical models that learn from data: classification, regression and the statistics behind them.",
		lectures: [
			{
				title: "LDA & QDA",
				summary:
					"Linear and Quadratic Discriminant Analysis: why we need both, how they work, the formulas, a worked example, an interactive playground and a live wine-classification project.",
				topics: [
					"Classification",
					"Bayes' theorem",
					"Gaussian models",
					"Fisher's LDA",
				],
				href: "/lectures/lda-qda/",
			},
		],
	},
	{
		id: "deep-learning",
		name: "Deep Learning",
		short: "DL",
		blurb:
			"Neural networks, from the perceptron to modern architectures for vision and sequences.",
		lectures: [],
	},
	{
		id: "reinforcement-learning",
		name: "Reinforcement Learning",
		short: "RL",
		blurb:
			"Agents that learn by trial and error from rewards: Markov decision processes, value functions and policies.",
		lectures: [
			{
				title: "Reinforcement Learning",
				summary:
					"How an agent learns to act from rewards: states, actions, rewards, the Bellman equation, Q-learning and policy gradients.",
				topics: ["MDPs", "Q-learning", "Policy gradients"],
			},
		],
	},
	{
		id: "large-language-models",
		name: "Large Language Models",
		short: "LLM",
		blurb:
			"Transformers, attention, pre-training and how modern language models are built and used.",
		lectures: [],
	},
];

const available = tracks.reduce(
	(n, t) => n + t.lectures.filter((l) => l.href).length,
	0,
);
---

<MainGridLayout title={pageTitle} description={pageDescription}>
	<section class="lectures-shell card-base" aria-labelledby="lectures-title">
		<header class="lectures-header">
			<p class="lectures-eyebrow">Teaching</p>
			<h1 id="lectures-title" class="lectures-title hero-title">{pageTitle}</h1>
			<p class="lectures-subtitle text-75">{pageDescription}</p>
			<nav class="lectures-jump" aria-label="Lecture tracks">
				{tracks.map((t) => (
					<a href={`#${t.id}`}>
						<span class="jump-short">{t.short}</span>
						<span class="jump-name">{t.name}</span>
					</a>
				))}
			</nav>
			<p class="lectures-count text-50">
				{available} {available === 1 ? "lecture" : "lectures"} available · more being added
			</p>
		</header>

		{tracks.map((t) => (
			<section class="lecture-track" id={t.id} aria-labelledby={`${t.id}-title`}>
				<div class="track-head">
					<span class="track-badge" aria-hidden="true">{t.short}</span>
					<div>
						<h2 id={`${t.id}-title`} class="track-title text-90">{t.name}</h2>
						<p class="track-blurb text-50">{t.blurb}</p>
					</div>
				</div>

				{t.lectures.length === 0 ? (
					<p class="track-empty text-50">Lectures for this track are coming soon.</p>
				) : (
					<ul class="lecture-list">
						{t.lectures.map((l) =>
							l.href ? (
								<li>
									<a class="lecture-card is-live" href={url(l.href)}>
										<span class="lecture-status">Interactive lecture</span>
										<h3 class="lecture-title text-90">{l.title}</h3>
										<p class="lecture-summary text-75">{l.summary}</p>
										<ul class="lecture-topics" aria-label="Topics">
											{l.topics.map((topic) => <li>{topic}</li>)}
										</ul>
										<span class="lecture-open">Open lecture →</span>
									</a>
								</li>
							) : (
								<li>
									<div class="lecture-card is-soon" aria-disabled="true">
										<span class="lecture-status">Coming soon</span>
										<h3 class="lecture-title text-90">{l.title}</h3>
										<p class="lecture-summary text-75">{l.summary}</p>
										<ul class="lecture-topics" aria-label="Topics">
											{l.topics.map((topic) => <li>{topic}</li>)}
										</ul>
									</div>
								</li>
							),
						)}
					</ul>
				)}
			</section>
		))}
	</section>
</MainGridLayout>

<style>
	.lectures-shell {
		border-radius: var(--radius-large, 1rem);
		padding: clamp(1.25rem, 3vw, 2.25rem);
		display: grid;
		gap: 2.25rem;
	}
	.lectures-header {
		display: grid;
		gap: 0.75rem;
	}
	.lectures-eyebrow {
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--primary);
		font-weight: 600;
	}
	.lectures-title {
		font-size: clamp(2rem, 4.5vw, 2.9rem);
		font-weight: 700;
		line-height: 1.1;
		color: var(--deep-text, inherit);
	}
	.lectures-subtitle {
		max-width: 62ch;
		line-height: 1.65;
	}
	.lectures-jump {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.lectures-jump a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem 0.4rem 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		font-size: 0.88rem;
		transition: border-color 0.2s ease;
	}
	.lectures-jump a:hover {
		border-color: var(--primary);
	}
	.jump-short {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--primary);
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--primary) 14%, transparent);
	}
	.lectures-count {
		font-size: 0.82rem;
	}

	.lecture-track {
		display: grid;
		gap: 1rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--line-divider);
		scroll-margin-top: 6rem;
	}
	.track-head {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 0.9rem;
		align-items: start;
	}
	.track-badge {
		font-family: "JetBrains Mono Variable", ui-monospace, monospace;
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--primary);
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		display: grid;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--primary) 35%, transparent);
		background: color-mix(in srgb, var(--primary) 9%, transparent);
	}
	.track-title {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.25;
	}
	.track-blurb {
		font-size: 0.92rem;
		margin-top: 0.2rem;
		max-width: 62ch;
	}
	.track-empty {
		font-size: 0.92rem;
		padding: 1rem 1.1rem;
		border: 1px dashed var(--line-divider);
		border-radius: 0.75rem;
	}

	.lecture-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
		gap: 1rem;
	}
	.lecture-list > li {
		min-width: 0;
	}
	.lecture-card {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.15rem 1.2rem;
		border-radius: 0.85rem;
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.lecture-card.is-live:hover {
		border-color: var(--primary);
		transform: translateY(-2px);
	}
	.lecture-card.is-live:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}
	.lecture-card.is-soon {
		border-style: dashed;
	}
	.lecture-card.is-soon .lecture-title,
	.lecture-card.is-soon .lecture-summary {
		opacity: 0.7;
	}
	.lecture-status {
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 600;
		color: var(--primary);
	}
	.is-soon .lecture-status {
		color: inherit;
		opacity: 0.55;
	}
	.lecture-title {
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.lecture-summary {
		font-size: 0.92rem;
		line-height: 1.6;
	}
	.lecture-topics {
		list-style: none;
		margin: 0.2rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.lecture-topics li {
		font-size: 0.74rem;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--line-divider);
		opacity: 0.85;
	}
	.lecture-open {
		margin-top: auto;
		padding-top: 0.5rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--primary);
	}
	@media (prefers-reduced-motion: reduce) {
		.lecture-card {
			transition: none;
		}
		.lecture-card.is-live:hover {
			transform: none;
		}
	}
</style>
