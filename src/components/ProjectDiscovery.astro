---
import type { CollectionEntry } from "astro:content";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import PostPage from "@components/PostPage.astro";
import { buildProjectDiscoveryData } from "@utils/project-discovery-data";
import {
	buildProjectProblemExplorerData,
	type ProjectProblemMatch,
	type ProjectProblemProject,
	toFilterKey,
	toRecommendationDisplayLabel,
} from "@utils/project-problem-matching";
import { url } from "@utils/url-utils";
import type { Page } from "astro";
import { Icon } from "astro-icon/components";

interface Props {
	allPosts: CollectionEntry<"posts">[];
	page: Page<CollectionEntry<"posts">>;
}

const { allPosts, page } = Astro.props;
const problemData = buildProjectProblemExplorerData(allPosts);
const discoveryData = buildProjectDiscoveryData(allPosts);
const publishedIds = new Set(discoveryData.records.map((record) => record.id));
const discoveryEntries = allPosts.filter((entry) =>
	publishedIds.has(toFilterKey(entry.slug)),
);
const discoveryClientData = JSON.stringify({
	suggestions: discoveryData.suggestions,
	projects: discoveryData.records.map((record) => ({
		id: record.id,
		slug: record.slug,
		title: record.card.displayTitle,
		url: record.url,
	})),
}).replace(/</g, "\\u003c");
const compareUrl = `${url("/impact-domain/")}#project-comparison`;
const representedCapabilities = new Set(
	discoveryData.records.flatMap((record) => record.capabilityIds),
).size;
const representedIndustries = discoveryData.industries.filter(
	(industry) => industry.count > 0,
).length;
const representedDomains = new Set(
	discoveryData.records.flatMap((record) => record.impactDomains),
).size;

function buildCardSearchText(
	project: ProjectProblemProject,
	match: ProjectProblemMatch,
) {
	return [
		project.title,
		project.description,
		project.category,
		project.tags.join(" "),
		project.technologyTags.join(" "),
		match.useCases.join(" "),
	]
		.join(" ")
		.toLowerCase();
}

function buildTechnologyKeys(project: ProjectProblemProject) {
	return project.technologyTags.map(toFilterKey).filter(Boolean).join(" ");
}

function buildUseCaseKeys(match: ProjectProblemMatch) {
	return match.useCaseKeys.join(" ");
}

function getMatchEvidence(match: ProjectProblemMatch) {
	const values = [
		...match.matchedTags,
		...match.matchedKeywords,
		...match.matchedCategories,
	];
	return [...new Set(values.map(toRecommendationDisplayLabel).filter(Boolean))].slice(0, 5);
}

const opensInNewTab = (href: string, external: boolean) =>
	external || /\.pdf(?:$|[?#])/i.test(href);

function getArchitecturePlaceholder(project: ProjectProblemProject) {
	return project.architecturePreview.status === "inside-project"
		? "Architecture available inside project"
		: "Architecture preview not added";
}
---

<section
	class="project-discovery"
	data-project-discovery
	aria-labelledby="project-discovery-tabs-label"
	data-compare-url={compareUrl}
>
	<header class="project-collection-intro">
		<div class="project-collection-copy">
			<p class="project-collection-eyebrow">AI engineering portfolio</p>
			<h1>
				<span class="project-collection-heading-line">Research systems &amp; production AI</span>
				<span class="project-collection-heading-line">for real-world impact</span>
			</h1>
			<p class="project-collection-summary">
				Explore technical case studies through the problem they solve, the capabilities they use, or the systems they connect.
			</p>
		</div>
		<dl class="project-collection-stats" aria-label="Portfolio collection summary">
			<div><dt>Projects</dt><dd>{discoveryData.records.length}</dd></div>
			<div><dt>Capabilities</dt><dd>{representedCapabilities}</dd></div>
			<div><dt>Industries</dt><dd>{representedIndustries}</dd></div>
			<div><dt>Impact domains</dt><dd>{representedDomains}</dd></div>
		</dl>
	</header>
	<p id="project-discovery-tabs-label" class="sr-only">Project discovery mode</p>
	<div class="project-discovery-sticky-sentinel" data-discovery-sticky-sentinel aria-hidden="true"></div>
	<div class="project-discovery-toolbar card-base" data-discovery-toolbar>
		<div class="project-discovery-toolbar-topline">
			<div class="project-discovery-tabs" role="tablist" aria-label="Project discovery mode">
				<button type="button" id="project-discovery-tab-projects" class="project-discovery-tab" role="tab" aria-selected="true" aria-controls="project-discovery-panel-projects" tabindex="0" data-discovery-tab="projects">
					Browse Projects
				</button>
				<button type="button" id="project-discovery-tab-problems" class="project-discovery-tab" role="tab" aria-selected="false" aria-controls="project-discovery-panel-problems" tabindex="-1" data-discovery-tab="problems">
					Choose a Problem
				</button>
			</div>

			<label class="project-main-search" for="project-discovery-search">
				<span class="sr-only">Search projects</span>
				<input
					id="project-discovery-search"
					type="search"
					placeholder="Search projects, technologies or problems"
					autocomplete="off"
					role="combobox"
					aria-autocomplete="list"
					aria-expanded="false"
					aria-controls="project-search-suggestions"
					data-project-search-input
				/>
				<kbd aria-hidden="true">/</kbd>
				<div id="project-search-suggestions" class="project-search-suggestions" role="listbox" data-project-suggestions hidden></div>
			</label>

			<button type="button" class="project-mobile-filter-button" data-project-filter-toggle aria-expanded="false" aria-controls="project-filter-drawer">
				Filters <span data-project-active-filter-count hidden>0</span>
			</button>
		</div>

		<div id="project-filter-drawer" class="project-filter-drawer" data-project-filter-drawer>
			<div class="project-filter-drawer-header">
				<strong>Filter projects</strong>
				<button type="button" class="btn-plain" data-project-filter-close aria-label="Close project filters">Close</button>
			</div>
			<div class="project-core-filters">
				<label><span>Industry</span><select data-project-filter="industry">
					<option value="">All industries</option>
					{discoveryData.industries.map((industry) => <option value={industry.id}>{industry.label} ({industry.count})</option>)}
				</select></label>
				<label><span>Technology</span><select data-project-filter="technology">
					<option value="">All technologies</option>
					{discoveryData.technologies.map((technology) => <option value={technology.id}>{technology.label} ({technology.count})</option>)}
				</select></label>
				<label><span>Project type</span><select data-project-filter="category">
					<option value="">All types</option>
					{discoveryData.categories.map((category) => <option value={toFilterKey(category)}>{category}</option>)}
				</select></label>
				<label><span>Status</span><select data-project-filter="status">
					<option value="">All statuses</option>
					{discoveryData.statuses.map((status) => <option value={status.id}>{status.label}</option>)}
				</select></label>
				<label><span>Sort</span><select data-project-sort>
					<option value="featured">Featured</option>
					<option value="newest">Newest</option>
					<option value="title">Title A–Z</option>
				</select></label>
			</div>
			<button type="button" class="project-clear-all btn-plain" data-project-clear-all>Clear all filters</button>
		</div>

		<div class="project-capability-quick-row" aria-label="Quick capability filters">
			<span class="project-quick-label">Capabilities</span>
			<div class="project-capability-scroll">
				{discoveryData.quickCapabilities.map((capability) => (
					<button type="button" data-project-capability={capability.id} aria-pressed="false">
						{capability.label}<small>{capability.count}</small>
					</button>
				))}
			</div>
			<button type="button" class="project-clear-capabilities btn-plain" data-project-clear-capabilities hidden>Clear</button>
		</div>
	</div>

	<section
		id="project-discovery-panel-projects"
		class="project-discovery-panel"
		role="tabpanel"
		aria-labelledby="project-discovery-tab-projects"
		data-discovery-panel="projects"
	>
		<div class="project-result-summary">
			<p data-project-result-count aria-live="polite">{discoveryData.records.length} projects</p>
			<p>AND across filters · OR within capabilities</p>
		</div>
		<PostPage page={page} entries={discoveryEntries} discoveryRecords={discoveryData.records}></PostPage>
		<div class="project-discovery-empty card-base" data-project-empty hidden>
			<h2>No projects match this view</h2>
			<p>Try a broader search or clear one of the active filters.</p>
			<button type="button" class="btn-regular" data-project-clear-all>Clear filters</button>
		</div>
	</section>

	<section
		id="project-discovery-panel-problems"
		class="project-discovery-panel"
		role="tabpanel"
		aria-labelledby="project-discovery-tab-problems"
		data-discovery-panel="problems"
		hidden
	>
		<div class="problem-explorer card-base">
			<section class="problem-overview" data-problem-overview aria-labelledby="problem-overview-title">
				<div class="problem-overview-header">
					<div>
						<h1 id="problem-overview-title">What problem are you trying to solve?</h1>
						<p>Explore relevant AI projects by business problem, technical challenge or application domain.</p>
					</div>
				</div>

				<div class="problem-option-grid" aria-label="Problem areas">
					{problemData.problems.map((problem) => (
						<button
							type="button"
							class="problem-option-card"
							data-problem-option
							data-problem-id={problem.id}
							aria-pressed="false"
							aria-label={`${problem.label}, ${problem.count} ${problem.count === 1 ? "matching project" : "matching projects"}`}
						>
							<span class="problem-option-icon" aria-hidden="true">
								<Icon name={problem.icon}></Icon>
							</span>
							<span class="problem-option-content">
								<strong>{problem.label}</strong>
								<span>{problem.description}</span>
							</span>
							<span class="problem-option-count">
								{problem.count} {problem.count === 1 ? "project" : "projects"}
							</span>
						</button>
					))}
				</div>
			</section>

			{problemData.problems.map((problem) => (
				<section
					class="problem-detail"
					data-problem-detail={problem.id}
					aria-labelledby={`problem-detail-title-${problem.id}`}
					hidden
				>
					<div class="problem-detail-topbar">
						<button type="button" class="problem-back-button btn-plain" data-problem-back>
							<span aria-hidden="true">&larr;</span>
							All problems
						</button>
						<div class="problem-switcher" role="group" aria-label="Switch problem area">
							{problemData.problems.map((candidate) => (
								<button
									type="button"
									class="problem-switch-button"
									data-problem-option
									data-problem-id={candidate.id}
									aria-pressed={candidate.id === problem.id ? "true" : "false"}
								>
									{candidate.label}
								</button>
							))}
						</div>
					</div>

					<header class="problem-detail-header">
						<div class="problem-detail-heading">
							<span class="problem-detail-icon" aria-hidden="true">
								<Icon name={problem.icon}></Icon>
							</span>
							<div>
								<h2 id={`problem-detail-title-${problem.id}`}>{problem.label}</h2>
								<p>{problem.description}</p>
							</div>
						</div>
						<div class="problem-detail-count" data-problem-result-count>
							{problem.count} {problem.count === 1 ? "project" : "projects"}
						</div>
					</header>

					<div class="problem-filter-row">
						<label class="problem-search-control">
							<span>Search within this problem</span>
							<input
								type="search"
								data-problem-search
								placeholder="Search projects, technologies or use cases..."
								autocomplete="off"
							/>
						</label>
					</div>

					{problem.technologies.length > 0 && (
						<section class="problem-facet-section" aria-labelledby={`problem-technologies-${problem.id}`}>
							<div class="problem-section-heading">
								<h3 id={`problem-technologies-${problem.id}`}>Technologies used</h3>
								<button type="button" class="problem-clear-chip btn-plain" data-clear-technology hidden>
									Clear technology filter
								</button>
							</div>
							<div class="problem-chip-row">
								{problem.technologies.map((technology) => (
									<button
										type="button"
										class="problem-filter-chip"
										data-technology-filter={technology.key}
										aria-pressed="false"
									>
										<span>{technology.label}</span>
										<small>{technology.count}</small>
									</button>
								))}
							</div>
						</section>
					)}

					{problem.useCases.length > 0 && (
						<section class="problem-facet-section" aria-labelledby={`problem-use-cases-${problem.id}`}>
							<div class="problem-section-heading">
								<h3 id={`problem-use-cases-${problem.id}`}>Similar use cases</h3>
								<button type="button" class="problem-clear-chip btn-plain" data-clear-use-case hidden>
									Clear use case filter
								</button>
							</div>
							<div class="problem-use-case-row">
								{problem.useCases.map((useCase) => (
									<button
										type="button"
										class="problem-use-case-chip"
										data-use-case-filter={useCase.key}
										aria-pressed="false"
									>
										<span>{useCase.label}</span>
										<small>{useCase.count}</small>
									</button>
								))}
							</div>
						</section>
					)}

					<div class="problem-results-grid" data-problem-results>
						{problem.projects.map(({ project, match }) => (
							<article
								class="problem-project-card card-base"
								data-problem-card
								data-search={buildCardSearchText(project, match)}
								data-technology-keys={buildTechnologyKeys(project)}
								data-use-case-keys={buildUseCaseKeys(match)}
							>
								<a
									class:list={[
										"problem-architecture-preview",
										{
											"has-preview":
												project.architecturePreview.status === "available" &&
												project.architecturePreview.src,
										},
									]}
									href={project.url}
									aria-label={`Open ${project.title}`}
								>
									{project.architecturePreview.status === "available" && project.architecturePreview.src ? (
										<>
											<ImageWrapper
												src={project.architecturePreview.src}
												basePath={project.assetBasePath}
												alt={project.architecturePreview.alt}
												fit="contain"
												overlay={false}
												loading="lazy"
												class="problem-architecture-image"
											/>
											<span class="problem-architecture-fallback" hidden>
												Architecture preview not added
											</span>
										</>
									) : (
										<span class="problem-architecture-fallback">
											{getArchitecturePlaceholder(project)}
										</span>
									)}
									</a>

								<div class="problem-project-body">
									<div class="problem-project-meta">
										<span>{project.category}</span>
										<span>{project.year}</span>
									</div>
									<h3>
										<a href={project.url}>{project.title}</a>
									</h3>
									<p>{project.description}</p>

									<div class="problem-match-summary">
										<span>{problem.label}</span>
										<strong>{match.matchReason}</strong>
										{getMatchEvidence(match).length > 0 && (
											<div class="problem-match-tags" aria-label="Matching evidence">
												{getMatchEvidence(match).map((value) => <span>{value}</span>)}
											</div>
										)}
									</div>

									<div class="problem-project-tags" aria-label={`${project.title} technologies`}>
										{project.technologyTags.slice(0, 8).map((tag) => <span>{tag}</span>)}
									</div>
								</div>

								<div class="problem-project-actions">
									<a class="btn-regular" href={project.url}>View Project</a>
									{project.actions.map((action) => (
										<a
											class="problem-secondary-action"
											href={action.url}
											target={opensInNewTab(action.url, action.external) ? "_blank" : undefined}
											rel={opensInNewTab(action.url, action.external) ? "noopener noreferrer" : undefined}
											aria-label={`${action.label} for ${project.title}${opensInNewTab(action.url, action.external) ? " (opens in a new tab)" : ""}`}
										>
											{action.label}
											{action.external && (
											<span class="problem-external-indicator" aria-hidden="true">
												External
											</span>
										)}
										</a>
									))}
								</div>
							</article>
						))}
					</div>

					<div class="problem-empty-state card-base" data-problem-empty hidden>
						<h3>No matching projects found</h3>
						<p>Try clearing the technology filter or searching with a broader term.</p>
						<div class="problem-empty-actions">
							<button type="button" class="btn-regular" data-clear-search>Clear search</button>
							<button type="button" class="btn-regular" data-clear-technology>Clear technology filter</button>
							<button type="button" class="btn-regular" data-clear-use-case>Clear use case filter</button>
							<button type="button" class="btn-regular" data-view-projects>View all projects</button>
						</div>
					</div>

					{problem.relatedProblems.length > 0 && (
						<nav class="problem-related-section" aria-labelledby={`problem-related-${problem.id}`}>
							<span class="problem-related-label" id={`problem-related-${problem.id}`}>Related problem areas</span>
							<div class="problem-related-row">
								{problem.relatedProblems.map((related) => (
									<button
										type="button"
										class="problem-related-chip"
										data-problem-option
										data-problem-id={related.id}
									>
										<span>{related.label}</span>
										<small>{related.count}</small>
									</button>
								))}
							</div>
						</nav>
					)}
				</section>
			))}
		</div>
	</section>

	<section class="project-recently-viewed card-base" data-project-recently-viewed aria-labelledby="recently-viewed-title" hidden>
		<header>
			<h2 id="recently-viewed-title">Recently viewed</h2>
			<button type="button" class="btn-plain" data-project-recent-clear>Clear</button>
		</header>
		<div data-project-recent-list></div>
	</section>

	<div class="project-comparison-bar card-base" data-project-comparison-bar hidden>
		<p data-project-comparison-count aria-live="polite">0 projects selected</p>
		<p class="project-comparison-limit" data-project-comparison-limit hidden>You can compare up to 3 projects.</p>
		<div>
			<a class="btn-regular" data-project-compare-submit href={compareUrl} aria-disabled="true" tabindex="-1">Compare Projects</a>
			<button type="button" class="btn-plain" data-project-compare-clear>Clear</button>
		</div>
	</div>

	<div class="project-discovery-live sr-only" data-project-discovery-live aria-live="polite"></div>
	<script is:inline id="project-discovery-data" type="application/json" set:html={discoveryClientData}></script>
	<script>
		import { mountProjectDiscovery } from "../scripts/project-discovery";
		const root = document.querySelector<HTMLElement>("[data-project-discovery]");
		if (root) mountProjectDiscovery(root);
	</script>
</section>
