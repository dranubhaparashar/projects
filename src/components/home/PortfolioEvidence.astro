---
import type { CollectionEntry } from "astro:content";
import { buildProjectImpactGraphData } from "@utils/project-impact-data";
import { url } from "@utils/url-utils";
import {
	googleScholarUrl,
	patents,
	publications,
} from "../../data/credentials";

interface Props {
	posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const impact = buildProjectImpactGraphData(posts);
const representedDomainCount = new Set(
	impact.projects.flatMap((project) => project.domains),
).size;
const previewDomains = [...impact.domains]
	.sort(
		(left, right) =>
			right.count - left.count || left.name.localeCompare(right.name),
	)
	.slice(0, 5);
const selectedPublications = publications.slice(0, 5);
const selectedPatents = patents.slice(0, 5);
const hasCredentialRecords =
	selectedPublications.length > 0 || selectedPatents.length > 0;
---

<section class="portfolio-evidence-grid" aria-label="Portfolio evidence and research credentials">
	<article class="portfolio-evidence-card impact-evidence-card">
		<div class="portfolio-evidence-copy">
			<p class="portfolio-evidence-eyebrow">Connected project evidence</p>
			<h2>Explore My AI Impact</h2>
			<p>
				<strong>{impact.projects.length} projects</strong> across <strong>{representedDomainCount} impact domains</strong>, connected through research, production AI, computer vision, intelligent systems, reliability, and optimization.
			</p>
			<a href={url("/impact-domain/")} data-analytics-event="impact-domain-open" data-analytics-label="Homepage teaser">
				Explore Impact Domains <span aria-hidden="true">→</span>
			</a>
		</div>
		<div class="impact-mini-preview" aria-hidden="true">
			<div class="impact-mini-core">AI</div>
			{previewDomains.map((domain, index) => (
				<div class={`impact-mini-node impact-mini-node-${index + 1}`}>
					<span>{domain.name}</span>
					<small>{domain.count}</small>
				</div>
			))}
		</div>
	</article>

	<article class="portfolio-evidence-card credentials-evidence-card">
		<p class="portfolio-evidence-eyebrow">Research record</p>
		<h2>Selected Publications &amp; Patents</h2>
		{hasCredentialRecords ? (
			<div class="credential-records">
				{selectedPublications.length > 0 && (
					<section aria-labelledby="selected-publications-title">
						<h3 id="selected-publications-title">Selected Publications</h3>
						<ul>{selectedPublications.map((publication) => (
							<li>
								{publication.url || publication.doi ? (
									<a href={publication.url || publication.doi} target="_blank" rel="noopener noreferrer" data-analytics-event="publication-link" data-analytics-label={publication.title}>{publication.title}</a>
								) : <strong>{publication.title}</strong>}
								<span>{publication.venue} · {publication.year}</span>
							</li>
						))}</ul>
					</section>
				)}
				{selectedPatents.length > 0 && (
					<section aria-labelledby="selected-patents-title">
						<h3 id="selected-patents-title">Selected Patents</h3>
						<ul>{selectedPatents.map((patent) => (
							<li>
								{patent.url ? (
									<a href={patent.url} target="_blank" rel="noopener noreferrer" data-analytics-event="patent-link" data-analytics-label={patent.title}>{patent.title}</a>
								) : <strong>{patent.title}</strong>}
								<span>{patent.number}{patent.status ? ` · ${patent.status}` : ""}{patent.year ? ` · ${patent.year}` : ""}</span>
							</li>
						))}</ul>
					</section>
				)}
			</div>
		) : (
			<p class="credential-empty-state">
				Verified publication titles, patent numbers, and registry links have not yet been added to this repository. This section will populate from the structured evidence file when those records are available.
			</p>
		)}
		{googleScholarUrl && (
			<a class="scholar-link" href={googleScholarUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="publication-link" data-analytics-label="Google Scholar">
				View Google Scholar <span aria-hidden="true">→</span>
			</a>
		)}
	</article>
</section>

<style>
	.portfolio-evidence-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(17rem, 0.85fr);
		gap: 1rem;
		margin: 1rem 0 1.25rem;
	}

	.portfolio-evidence-card {
		min-width: 0;
		padding: 1.1rem;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-card);
		background: var(--card-bg);
		box-shadow: var(--card-shadow);
		color: var(--text-secondary);
	}

	.portfolio-evidence-card h2,
	.portfolio-evidence-card h3,
	.portfolio-evidence-card p {
		margin-top: 0;
	}

	.portfolio-evidence-card h2 {
		margin-bottom: 0.55rem;
		color: var(--text-primary);
		font-size: clamp(1.05rem, 2vw, 1.35rem);
		letter-spacing: -0.025em;
	}

	.portfolio-evidence-card h3 {
		margin-bottom: 0.45rem;
		color: var(--text-primary);
		font-size: 0.82rem;
	}

	.portfolio-evidence-eyebrow {
		margin-bottom: 0.3rem;
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.impact-evidence-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.72fr);
		align-items: center;
		gap: 1rem;
	}

	.portfolio-evidence-copy > p:not(.portfolio-evidence-eyebrow) {
		margin-bottom: 0.75rem;
		font-size: 0.82rem;
		line-height: 1.6;
	}

	.portfolio-evidence-copy > a,
	.scholar-link,
	.credential-records a {
		color: var(--primary);
		font-weight: 750;
		text-underline-offset: 0.18em;
	}

	.portfolio-evidence-copy > a,
	.scholar-link {
		display: inline-flex;
		gap: 0.3rem;
		font-size: 0.78rem;
		text-decoration: none;
	}

	.portfolio-evidence-copy > a:focus-visible,
	.scholar-link:focus-visible,
	.credential-records a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--primary) 52%, transparent);
		outline-offset: 3px;
	}

	.impact-mini-preview {
		display: grid;
		position: relative;
		min-height: 9rem;
		place-items: center;
		border: 1px solid var(--line-divider);
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--primary) 4%, transparent);
		overflow: hidden;
	}

	.impact-mini-preview::before,
	.impact-mini-preview::after {
		position: absolute;
		width: 72%;
		height: 1px;
		background: color-mix(in srgb, var(--primary) 30%, var(--line-divider));
		content: "";
	}

	.impact-mini-preview::before { transform: rotate(24deg); }
	.impact-mini-preview::after { transform: rotate(-24deg); }

	.impact-mini-core,
	.impact-mini-node {
		display: flex;
		position: absolute;
		z-index: 1;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, var(--primary) 42%, var(--line-divider));
		background: var(--card-bg);
		color: var(--text-primary);
	}

	.impact-mini-core {
		width: 2.8rem;
		height: 2.8rem;
		border-radius: 50%;
		color: var(--primary);
		font-family: "IBM Plex Mono", monospace;
		font-weight: 800;
	}

	.impact-mini-node {
		gap: 0.28rem;
		max-width: 7.6rem;
		padding: 0.28rem 0.45rem;
		border-radius: 999px;
		font-size: 0.58rem;
		line-height: 1.2;
		text-align: center;
	}

	.impact-mini-node small { color: var(--primary); font-weight: 800; }
	.impact-mini-node-1 { top: 0.65rem; left: 0.65rem; }
	.impact-mini-node-2 { top: 0.75rem; right: 0.55rem; }
	.impact-mini-node-3 { bottom: 0.65rem; left: 0.55rem; }
	.impact-mini-node-4 { right: 0.55rem; bottom: 0.75rem; }
	.impact-mini-node-5 { top: 50%; right: 0.35rem; transform: translateY(-50%); }

	.credential-empty-state {
		margin-bottom: 0;
		font-size: 0.78rem;
		line-height: 1.55;
	}

	.credential-records {
		display: grid;
		gap: 0.8rem;
	}

	.credential-records ul {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.credential-records li,
	.credential-records li > span {
		display: grid;
		gap: 0.12rem;
	}

	.credential-records li > span {
		color: var(--text-muted);
		font-size: 0.68rem;
	}

	.scholar-link { margin-top: 0.8rem; }

	@media (max-width: 900px) {
		.portfolio-evidence-grid,
		.impact-evidence-card {
			grid-template-columns: minmax(0, 1fr);
		}

		.impact-mini-preview { min-height: 8rem; }
	}

	@media (max-width: 640px) {
		.portfolio-evidence-grid { margin-top: 0.75rem; }
		.portfolio-evidence-card { padding: 0.95rem; }
		.impact-mini-node { max-width: 6.5rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.portfolio-evidence-card * { scroll-behavior: auto; }
	}
</style>
