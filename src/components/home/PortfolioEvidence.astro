---
import type { CollectionEntry } from "astro:content";
import { buildProjectImpactGraphData } from "@utils/project-impact-data";
import { url } from "@utils/url-utils";
import {
	googleScholarUrl,
	patents,
	publications,
	publicationsPageUrl,
} from "../../data/credentials";

interface Props {
	posts: CollectionEntry<"posts">[];
	layout?: "default" | "sidebar";
}

const { posts, layout = "default" } = Astro.props;
const isSidebar = layout === "sidebar";
const impact = buildProjectImpactGraphData(posts);
const representedDomainCount = new Set(
	impact.projects.flatMap((project) => project.domains),
).size;
const previewDomains = [...impact.domains]
	.sort(
		(left, right) =>
			right.count - left.count || left.name.localeCompare(right.name),
	)
	.slice(0, isSidebar ? 4 : 5);
const selectedPublications = publications.slice(0, 5);
const selectedPatents = patents.slice(0, 5);
const hasCredentialRecords =
	selectedPublications.length > 0 || selectedPatents.length > 0;
const credentialTitle =
	selectedPublications.length > 0 && selectedPatents.length > 0
		? "Selected Publications & Patents"
		: selectedPublications.length > 0
			? "Selected Publications"
			: "Selected Patents";
---

<section
	class:list={[
		"portfolio-evidence-grid",
		{ "portfolio-evidence-grid-sidebar": isSidebar },
	]}
	aria-label="Portfolio evidence and research credentials"
>
	<article class="portfolio-evidence-card impact-evidence-card">
		<div class="portfolio-evidence-copy">
			<p class="portfolio-evidence-eyebrow">Connected project evidence</p>
			<h2>Explore My AI Impact</h2>
			<p>
				<strong>{impact.projects.length} projects</strong> across <strong>{representedDomainCount} impact domains</strong>, connected through research, production AI, computer vision, intelligent systems, reliability, and optimization.
			</p>
			<a href={url("/impact-domain/")} data-analytics-event="impact-domain-open" data-analytics-label="Homepage teaser">
				Explore Impact Domains <span aria-hidden="true">→</span>
			</a>
		</div>
		<div class="impact-mini-preview" aria-hidden="true">
			<div class="impact-mini-core">AI</div>
			{previewDomains.map((domain, index) => (
				<div class={`impact-mini-node impact-mini-node-${index + 1}`}>
					<span>{domain.name}</span>
					<small>{domain.count}</small>
				</div>
			))}
		</div>
	</article>

	{hasCredentialRecords && (
		<article class="portfolio-evidence-card credentials-evidence-card">
			<div class="credential-card-heading">
				<div>
					<p class="portfolio-evidence-eyebrow">Research record</p>
					<h2>{credentialTitle}</h2>
				</div>
				{selectedPublications.length > 0 && (
					<p class="publication-count">
						{selectedPublications.length} selected publication{selectedPublications.length === 1 ? "" : "s"}
					</p>
				)}
			</div>

			{selectedPublications.length > 0 && (
				<ol class="publication-list">
					{selectedPublications.map((publication) => (
						<li class="publication-record" id={publication.id}>
							<div class="publication-record-meta">
								<span class="publication-number" aria-label={`Publication ${publication.number}`}>{publication.number}</span>
								<time datetime={String(publication.year)}>{publication.year}</time>
							</div>
							<h3>{publication.title}</h3>
							<p class="publication-authors">
								{publication.authors.map((author, index) => (
									<span>
										{author === publication.primaryAuthor ? <strong>{author}</strong> : author}{index < publication.authors.length - 1 ? ", " : ""}
									</span>
								))}
							</p>
							<p class="publication-citation">
								<em>{publication.journal}</em>, Volume {publication.volume}, {publication.year}, {publication.articleNumber} <span aria-hidden="true">·</span> {publication.publisher}
							</p>
							<div class="publication-footer">
								{(publication.impactFactor || publication.quartile) && (
									<ul class="publication-indicators" aria-label="Publication indicators">
										{publication.impactFactor && <li>{publication.impactFactor} IF</li>}
										{publication.quartile && <li>{publication.quartile}</li>}
									</ul>
								)}
								<a
									class="publication-doi-link"
									href={publication.doiUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Open DOI for ${publication.title} in a new tab`}
									data-analytics-event="publication-link"
									data-analytics-label={publication.title}
								>
									DOI <span aria-hidden="true">↗</span>
								</a>
							</div>
						</li>
					))}
				</ol>
			)}

			{selectedPatents.length > 0 && (
				<section class="patent-records" aria-label="Selected patents">
					{selectedPublications.length > 0 && <h3>Patents</h3>}
					<ul>{selectedPatents.map((patent) => (
						<li>
							{patent.url ? (
								<a href={patent.url} target="_blank" rel="noopener noreferrer" data-analytics-event="patent-link" data-analytics-label={patent.title}>{patent.title}</a>
							) : <strong>{patent.title}</strong>}
							<span>{patent.number}{patent.status ? ` · ${patent.status}` : ""}{patent.year ? ` · ${patent.year}` : ""}</span>
						</li>
					))}</ul>
				</section>
			)}

			<div class="credential-links">
				{publicationsPageUrl && (
					<a href={url(publicationsPageUrl)}>View all publications <span aria-hidden="true">→</span></a>
				)}
				{googleScholarUrl && (
					<a href={googleScholarUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="publication-link" data-analytics-label="Google Scholar">
						View Google Scholar <span aria-hidden="true">↗</span>
					</a>
				)}
			</div>
		</article>
	)}
</section>

<style>
	.portfolio-evidence-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 1rem 0 1.25rem;
	}

	.portfolio-evidence-grid > :only-child {
		grid-column: 1 / -1;
	}

	.portfolio-evidence-grid-sidebar {
		grid-template-columns: minmax(0, 1fr);
		margin: 0;
	}

	.portfolio-evidence-grid-sidebar .impact-evidence-card {
		grid-template-columns: minmax(0, 1fr);
	}

	.portfolio-evidence-card {
		min-width: 0;
		padding: 1.1rem;
		border: 1px solid var(--card-border);
		border-radius: var(--radius-card);
		background: var(--card-bg);
		box-shadow: var(--card-shadow);
		color: var(--text-secondary);
	}

	.portfolio-evidence-card h2,
	.portfolio-evidence-card h3,
	.portfolio-evidence-card p {
		margin-top: 0;
	}

	.portfolio-evidence-card h2 {
		margin-bottom: 0.55rem;
		color: var(--text-primary);
		font-size: clamp(1.35rem, 2.4vw, 1.7rem);
		line-height: 1.08;
		letter-spacing: -0.02em;
	}

	.portfolio-evidence-card h3 {
		margin-bottom: 0.45rem;
		color: var(--text-primary);
		font-size: 0.82rem;
	}

	.portfolio-evidence-eyebrow {
		margin-bottom: 0.3rem;
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.impact-evidence-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.72fr);
		align-items: center;
		gap: 1rem;
	}

	.portfolio-evidence-copy > p:not(.portfolio-evidence-eyebrow) {
		margin-bottom: 0.75rem;
		font-size: 0.82rem;
		line-height: 1.6;
	}

	.portfolio-evidence-copy > a,
	.credential-links a,
	.publication-doi-link,
	.patent-records a {
		color: var(--primary);
		font-weight: 600;
		text-underline-offset: 0.18em;
	}

	.portfolio-evidence-copy > a,
	.credential-links a,
	.publication-doi-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem;
		text-decoration: none;
	}

	.portfolio-evidence-copy > a:focus-visible,
	.credential-links a:focus-visible,
	.publication-doi-link:focus-visible,
	.patent-records a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--primary) 52%, transparent);
		outline-offset: 3px;
	}

	.impact-mini-preview {
		display: grid;
		position: relative;
		min-height: 9rem;
		place-items: center;
		border: 1px solid var(--line-divider);
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--primary) 4%, transparent);
		overflow: hidden;
	}

	.impact-mini-preview::before,
	.impact-mini-preview::after {
		position: absolute;
		width: 72%;
		height: 1px;
		background: color-mix(in srgb, var(--primary) 30%, var(--line-divider));
		content: "";
	}

	.impact-mini-preview::before { transform: rotate(24deg); }
	.impact-mini-preview::after { transform: rotate(-24deg); }

	.impact-mini-core,
	.impact-mini-node {
		display: flex;
		position: absolute;
		z-index: 1;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, var(--primary) 42%, var(--line-divider));
		background: var(--card-bg);
		color: var(--text-primary);
	}

	.impact-mini-core {
		width: 2.8rem;
		height: 2.8rem;
		border-radius: 50%;
		color: var(--primary);
		font-family: var(--font-body);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.impact-mini-node {
		gap: 0.28rem;
		max-width: 7.6rem;
		padding: 0.28rem 0.45rem;
		border-radius: 999px;
		font-size: 0.58rem;
		line-height: 1.2;
		text-align: center;
	}

	.impact-mini-node small { color: var(--primary); font-weight: 600; }
	.impact-mini-node-1 { top: 0.65rem; left: 0.65rem; }
	.impact-mini-node-2 { top: 0.75rem; right: 0.55rem; }
	.impact-mini-node-3 { bottom: 0.65rem; left: 0.55rem; }
	.impact-mini-node-4 { right: 0.55rem; bottom: 0.75rem; }
	.impact-mini-node-5 { top: 50%; right: 0.35rem; transform: translateY(-50%); }

	.portfolio-evidence-grid-sidebar .impact-mini-preview {
		min-height: 9.5rem;
	}

	.portfolio-evidence-grid-sidebar .impact-mini-node {
		max-width: 6.65rem;
		padding-inline: 0.38rem;
		overflow-wrap: anywhere;
	}

	.portfolio-evidence-grid-sidebar .credential-card-heading {
		display: block;
	}

	.portfolio-evidence-grid-sidebar .publication-count {
		margin-top: -0.2rem;
		text-align: left;
	}

	.portfolio-evidence-grid-sidebar .publication-footer {
		flex-wrap: wrap;
		align-items: flex-end;
	}

	.credentials-evidence-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.credential-card-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.85rem;
		margin-bottom: 0.75rem;
	}

	.publication-count {
		flex: 0 0 auto;
		margin: 0.15rem 0 0;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: 0.62rem;
		line-height: 1.35;
		text-align: right;
	}

	.publication-list,
	.patent-records ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.publication-record {
		min-width: 0;
		padding-top: 0.8rem;
		border-top: 1px solid var(--line-divider);
	}

	.publication-record-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.55rem;
		font-family: var(--font-body);
		font-size: 0.64rem;
		font-variant-numeric: tabular-nums;
	}

	.publication-number {
		color: var(--primary);
		font-weight: 600;
		letter-spacing: 0.08em;
	}

	.publication-record-meta time {
		color: var(--text-muted);
	}

	.publication-record h3 {
		margin: 0 0 0.55rem;
		color: var(--text-primary);
		font-size: clamp(1.15rem, 2vw, 1.42rem);
		line-height: 1.18;
		letter-spacing: -0.018em;
		text-wrap: pretty;
		overflow-wrap: anywhere;
	}

	.publication-authors,
	.publication-citation {
		margin-bottom: 0.55rem;
		font-size: 0.75rem;
		line-height: 1.55;
		overflow-wrap: anywhere;
	}

	.publication-authors {
		color: var(--text-secondary);
	}

	.publication-authors strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.publication-citation {
		color: var(--text-muted);
	}

	.publication-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.publication-indicators {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.publication-indicators li {
		padding: 0.18rem 0.42rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--primary) 4%, transparent);
		color: var(--text-secondary);
		font-family: var(--font-body);
		font-size: 0.6rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.publication-doi-link {
		flex: 0 0 auto;
		white-space: nowrap;
	}

	.patent-records {
		margin-top: 1rem;
		padding-top: 0.85rem;
		border-top: 1px solid var(--line-divider);
	}

	.patent-records ul {
		display: grid;
		gap: 0.55rem;
	}

	.patent-records li,
	.patent-records li > span {
		display: grid;
		gap: 0.12rem;
	}

	.patent-records li > span {
		color: var(--text-muted);
		font-size: 0.68rem;
	}

	.credential-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.85rem;
	}

	@media (max-width: 900px) {
		.portfolio-evidence-grid,
		.impact-evidence-card {
			grid-template-columns: minmax(0, 1fr);
		}

		.impact-mini-preview { min-height: 8rem; }
	}

	@media (max-width: 640px) {
		.portfolio-evidence-grid { margin-top: 0.75rem; }
		.portfolio-evidence-card { padding: 0.95rem; }
		.impact-mini-node { max-width: 6.5rem; }
		.credential-card-heading { display: block; }
		.publication-count { margin-top: -0.2rem; text-align: left; }
		.publication-footer { align-items: flex-end; }
	}

	@media (prefers-reduced-motion: reduce) {
		.portfolio-evidence-card * { scroll-behavior: auto; }
	}
</style>
