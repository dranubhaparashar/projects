---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import HuggingFaceIcon from "../misc/HuggingFaceIcon.astro";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const HUGGING_FACE_ICON = "custom:hugging-face";
---
<div class="card-base p-3">
    <a
       aria-label="Go to contact section on the main site"
       href="https://anubhaparashar.github.io/#contact"
       target="_blank"
       rel="noopener noreferrer"
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-2
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="sidebar-profile px-2">
        <div class="profile-name font-bold text-lg text-center mb-0 dark:text-neutral-50 transition">{config.name}</div>
        <div class="profile-underline h-0.5 w-5 bg-[var(--primary)] mx-auto rounded-full mb-1 transition"></div>
        <div class="profile-bio text-center text-neutral-400 mb-1.5 transition text-[0.8rem] leading-[1.38]">{config.bio}</div>
        <div class="social-links flex flex-nowrap items-center gap-[0.4rem] justify-center mb-0">
            {config.links.length > 1 && config.links.map(item =>
                    <a rel={item.rel ?? "me"} aria-label={item.name} title={item.rel ? item.name : undefined} href={item.url} target="_blank" class="btn-regular rounded-lg h-8 w-8 active:scale-90">
                        {item.icon === HUGGING_FACE_ICON ? (
                            <HuggingFaceIcon class="text-[1.2rem]" />
                        ) : (
                            <Icon name={item.icon} class="text-[1.2rem]"></Icon>
                        )}
                    </a>
            )}
            {config.links.length == 1 && <a rel={config.links[0].rel ?? "me"} aria-label={config.links[0].name} title={config.links[0].rel ? config.links[0].name : undefined} href={config.links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-8 gap-2 px-2.5 font-bold active:scale-95">
                {config.links[0].icon === HUGGING_FACE_ICON ? (
                    <HuggingFaceIcon class="text-[1.2rem]" />
                ) : (
                    <Icon name={config.links[0].icon} class="text-[1.2rem]"></Icon>
                )}
                {config.links[0].name}
            </a>}
        </div>
    </div>
</div>
