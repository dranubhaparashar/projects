---
import type { CollectionEntry } from "astro:content";
import PortfolioEvidence from "@components/home/PortfolioEvidence.astro";
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	projectSidebarPosts?: CollectionEntry<"posts">[];
}

const className = Astro.props.class;
const { projectSidebarPosts } = Astro.props;
const isProjectSidebar = projectSidebarPosts !== undefined;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
	<div
		id="sidebar-sticky"
		class:list={[
			"transition-all duration-700 flex flex-col w-full gap-4",
			{ "top-4 sticky": !isProjectSidebar },
		]}
	>
		<Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
		{projectSidebarPosts && (
			<PortfolioEvidence posts={projectSidebarPosts} layout="sidebar" />
		)}
		<Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
	</div>
</div>
