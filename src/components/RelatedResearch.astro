---
import type { Publication } from "@/data/credentials";

interface Props {
	publications: Publication[];
	variant: "business" | "technical" | "post";
	id: string;
}

const { publications, variant, id } = Astro.props;
const isBusiness = variant === "business";
const isTechnical = variant === "technical";
const sectionTitle = isBusiness
	? "Research-backed"
	: isTechnical
		? publications.length === 1
			? "Research Publication"
			: "Research Publications"
		: "Related Research";
---

{publications.length > 0 && (
	<section
		id={id}
		class:list={[
			"related-research",
			`related-research-${variant}`,
			{
				"project-view-card": isBusiness,
				"full-width": isBusiness,
				"technical-section": isTechnical,
			},
		]}
		aria-labelledby={`${id}-title`}
	>
		<h2 id={`${id}-title`}>{sectionTitle}</h2>
		<div class="related-research-list">
			{publications.map((publication) => (
				<article class="related-publication">
					{isBusiness && (
						<p class="related-publication-venue">
							Published in <strong>{publication.journal}</strong> ({publication.publisher}), {publication.year}
						</p>
					)}
					<h3>{publication.title}</h3>
					{!isBusiness && (
						<p class="related-publication-authors">
							{publication.authors.map((author, index) => (
								<span>
									{author === publication.primaryAuthor ? <strong>{author}</strong> : author}{index < publication.authors.length - 1 ? ", " : ""}
								</span>
							))}
						</p>
					)}
					{!isBusiness && (
						<p class="related-publication-citation">
							<em>{publication.journal}</em>
							{isTechnical ? (
								<> · Volume {publication.volume} · Article {publication.articleNumber} · {publication.publisher} · {publication.year}</>
							) : (
								<> · {publication.publisher} · {publication.year}</>
							)}
						</p>
					)}
					<div class="related-publication-footer">
						{(publication.impactFactor || publication.quartile) && (
							<ul class="related-publication-indicators" aria-label="Publication indicators">
								{publication.quartile && <li>{publication.quartile}</li>}
								{publication.impactFactor && <li>{publication.impactFactor} IF</li>}
							</ul>
						)}
						<a
							href={publication.doiUrl}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`Open research paper: ${publication.title} (opens in a new tab)`}
							data-analytics-event="publication-link"
							data-analytics-label={publication.title}
						>
							{isBusiness ? "View publication" : isTechnical ? "View Research Paper" : "DOI"} <span aria-hidden="true">↗</span>
						</a>
					</div>
				</article>
			))}
		</div>
	</section>
)}

<style>
	.related-research {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.related-research-post {
		padding: clamp(1rem, 2.5vw, 1.35rem);
		margin: 1.5rem 0;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-large);
		background: var(--card-bg);
		box-shadow: var(--shadow-sm);
	}

	.related-research h2 {
		margin: 0 0 0.8rem;
		color: var(--text-primary);
		font-size: clamp(1.15rem, 2vw, 1.4rem);
	}

	.related-research-list {
		display: grid;
		gap: 0.8rem;
	}

	.related-publication {
		min-width: 0;
		padding: 0.9rem;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-md);
		background: var(--surface-2);
	}

	.related-publication h3 {
		margin: 0;
		color: var(--text-primary);
		font-size: clamp(1rem, 2vw, 1.16rem);
		line-height: 1.35;
	}

	.related-publication-authors,
	.related-publication-citation,
	.related-publication-venue {
		margin: 0.55rem 0 0;
		color: var(--text-secondary);
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.related-publication-venue {
		margin: 0 0 0.45rem;
	}

	.related-publication-footer {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.7rem;
		margin-top: 0.75rem;
	}

	.related-publication-indicators {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.related-publication-indicators li {
		padding: 0.22rem 0.46rem;
		border: 1px solid var(--border-subtle);
		border-radius: 999px;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		font-size: 0.67rem;
		font-variant-numeric: tabular-nums;
		font-weight: 650;
	}

	.related-publication a {
		display: inline-flex;
		min-height: 2.35rem;
		align-items: center;
		padding: 0.42rem 0;
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 750;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.related-publication a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--primary) 55%, transparent);
		outline-offset: 3px;
		border-radius: 0.25rem;
	}

	@media (max-width: 640px) {
		.related-publication-footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.related-publication a {
			min-height: 2.75rem;
		}
	}
</style>
