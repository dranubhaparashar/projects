---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	imgClass?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	fit?: "cover" | "contain";
	overlay?: boolean;
	loading?: "eager" | "lazy";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	fit = "cover",
	overlay = true,
	loading,
} = Astro.props;
const className = Astro.props.class;
const imgClassName = Astro.props.imgClass || "";

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");
const publicSrc =
	isPublic && src.startsWith(import.meta.env.BASE_URL) ? src : url(src);

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass =
	fit === "contain"
		? "w-auto h-auto max-w-full max-h-full object-contain"
		: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {overlay && <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>}
    {isLocal && img && <Image src={img} alt={alt || ""} class={[imageClass, imgClassName].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
    {!isLocal && <img src={isPublic ? publicSrc : src} alt={alt || ""} class={[imageClass, imgClassName].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
</div>
