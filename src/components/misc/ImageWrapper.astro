---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	darkSrc?: string;
	class?: string;
	imgClass?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	fit?: "cover" | "contain" | "fill";
	overlay?: boolean;
	loading?: "eager" | "lazy";
	priority?: boolean;
}

import { getImage, Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	darkSrc,
	alt,
	position = "center",
	basePath = "/",
	fit = "cover",
	overlay = true,
	loading,
	priority = false,
} = Astro.props;
const className = Astro.props.class;
const imgClassName = Astro.props.imgClass || "";

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");
const publicSrc =
	isPublic && src.startsWith(import.meta.env.BASE_URL) ? src : url(src);
const hasDarkVariant = Boolean(darkSrc && darkSrc !== src);
const isDarkLocal = Boolean(
	darkSrc &&
		!darkSrc.startsWith("/") &&
		!darkSrc.startsWith("http") &&
		!darkSrc.startsWith("https") &&
		!darkSrc.startsWith("data:"),
);
const isDarkPublic = Boolean(darkSrc?.startsWith("/"));
const darkPublicSrc = darkSrc
	? isDarkPublic && darkSrc.startsWith(import.meta.env.BASE_URL)
		? darkSrc
		: url(darkSrc)
	: "";

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | undefined;
let darkImg: ImageMetadata | undefined;
const files = import.meta.glob<ImageMetadata>("../../**", {
	import: "default",
});
const loadLocalImage = async (imageSrc: string) => {
	let normalizedPath = path
		.normalize(path.join("../../", basePath, imageSrc))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
		return undefined;
	}
	return file();
};
if (isLocal) {
	img = await loadLocalImage(src);
}
if (darkSrc && isDarkLocal) {
	darkImg = await loadLocalImage(darkSrc);
}

const optimizedLight =
	hasDarkVariant && img
		? await getImage({ src: img, format: "webp", quality: 82 })
		: undefined;
const optimizedDark =
	hasDarkVariant && darkImg
		? await getImage({ src: darkImg, format: "webp", quality: 82 })
		: undefined;
const lightVariantSrc = isLocal
	? optimizedLight?.src || img?.src || ""
	: isPublic
		? publicSrc
		: src;
const darkVariantSrc = isDarkLocal
	? optimizedDark?.src || darkImg?.src || ""
	: isDarkPublic
		? darkPublicSrc
		: darkSrc || "";

const imageClass =
	fit === "contain"
		? "w-auto h-auto max-w-full max-h-full object-contain"
		: fit === "fill"
			? "w-full h-full object-fill"
			: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {overlay && <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>}
    {!hasDarkVariant && isLocal && img && <Image src={img} alt={alt || ""} class={[imageClass, imgClassName].filter(Boolean).join(" ")} style={imageStyle} loading={loading} decoding="async"/>}
    {!hasDarkVariant && !isLocal && <img src={isPublic ? publicSrc : src} alt={alt || ""} class={[imageClass, imgClassName].filter(Boolean).join(" ")} style={imageStyle} loading={loading} decoding="async" />}
    {hasDarkVariant && lightVariantSrc && darkVariantSrc && (
		<img
			src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
			data-theme-image
			data-light-src={lightVariantSrc}
			data-dark-src={darkVariantSrc}
			alt={alt || ""}
			class={[imageClass, imgClassName].filter(Boolean).join(" ")}
			style={imageStyle}
			loading={priority ? "eager" : loading}
			decoding="async"
			fetchpriority={priority ? "high" : undefined}
			width={img?.width}
			height={img?.height}
		/>
	)}
	{hasDarkVariant && lightVariantSrc && (
		<noscript>
			<img src={lightVariantSrc} alt={alt || ""} class={[imageClass, imgClassName].filter(Boolean).join(" ")} style={imageStyle} loading={priority ? "eager" : loading} decoding="async" />
		</noscript>
	)}
</div>

{hasDarkVariant && (
	<script is:inline>
		(() => {
			const script = document.currentScript;
			const wrapper = script?.previousElementSibling;
			const image = wrapper?.querySelector?.("[data-theme-image]");
			if (!(image instanceof HTMLImageElement)) return;
			const sync = () => {
				const selected = document.documentElement.classList.contains("dark")
					? image.dataset.darkSrc
					: image.dataset.lightSrc;
				if (selected && image.getAttribute("src") !== selected) image.src = selected;
			};
			sync();
			new MutationObserver(sync).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["class"],
			});
		})();
	</script>
)}
