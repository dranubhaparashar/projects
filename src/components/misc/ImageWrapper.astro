---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	darkSrc?: string;
	class?: string;
	imgClass?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	fit?: "cover" | "contain";
	overlay?: boolean;
	loading?: "eager" | "lazy";
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
	id,
	src,
	darkSrc,
	alt,
	position = "center",
	basePath = "/",
	fit = "cover",
	overlay = true,
	loading,
} = Astro.props;
const className = Astro.props.class;
const imgClassName = Astro.props.imgClass || "";

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");
const publicSrc =
	isPublic && src.startsWith(import.meta.env.BASE_URL) ? src : url(src);
const hasDarkVariant = Boolean(darkSrc && darkSrc !== src);
const isDarkLocal = Boolean(
	darkSrc &&
		!darkSrc.startsWith("/") &&
		!darkSrc.startsWith("http") &&
		!darkSrc.startsWith("https") &&
		!darkSrc.startsWith("data:"),
);
const isDarkPublic = Boolean(darkSrc?.startsWith("/"));
const darkPublicSrc = darkSrc
	? isDarkPublic && darkSrc.startsWith(import.meta.env.BASE_URL)
		? darkSrc
		: url(darkSrc)
	: "";

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
let darkImg;
const files = import.meta.glob<ImageMetadata>("../../**", {
	import: "default",
});
const loadLocalImage = async (imageSrc: string) => {
	let normalizedPath = path
		.normalize(path.join("../../", basePath, imageSrc))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
		return undefined;
	}
	return file();
};
if (isLocal) {
	img = await loadLocalImage(src);
}
if (darkSrc && isDarkLocal) {
	darkImg = await loadLocalImage(darkSrc);
}

const imageClass =
	fit === "contain"
		? "w-auto h-auto max-w-full max-h-full object-contain"
		: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {overlay && <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>}
    {isLocal && img && <Image src={img} alt={alt || ""} class={[imageClass, imgClassName, hasDarkVariant ? "theme-image-light" : ""].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
    {!isLocal && <img src={isPublic ? publicSrc : src} alt={alt || ""} class={[imageClass, imgClassName, hasDarkVariant ? "theme-image-light" : ""].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
    {hasDarkVariant && isDarkLocal && darkImg && <Image src={darkImg} alt={alt || ""} class={[imageClass, imgClassName, "theme-image-dark"].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
    {hasDarkVariant && !isDarkLocal && darkSrc && <img src={isDarkPublic ? darkPublicSrc : darkSrc} alt={alt || ""} class={[imageClass, imgClassName, "theme-image-dark"].filter(Boolean).join(" ")} style={imageStyle} loading={loading}/>}
</div>

<style>
	.theme-image-dark {
		display: none;
	}

	:global(.dark) .theme-image-light {
		display: none;
	}

	:global(.dark) .theme-image-dark {
		display: block;
	}
</style>
