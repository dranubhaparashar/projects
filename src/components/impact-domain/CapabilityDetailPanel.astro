<aside
	class="capability-detail-panel card-base"
	data-capability-detail
	aria-labelledby="capability-detail-heading"
	tabindex="-1"
	hidden
>
	<header class="capability-detail-header">
		<div>
			<p class="capability-detail-kicker">Capability evidence</p>
			<h4 id="capability-detail-heading">How this capability is used</h4>
		</div>
		<button
			type="button"
			class="capability-detail-close btn-plain"
			data-capability-detail-close
			aria-label="Close capability details"
		>
			Close
		</button>
	</header>

	<h5 data-capability-detail-title></h5>
	<p class="capability-detail-explanation" data-capability-detail-explanation></p>

	<div class="capability-detail-grid">
		<section>
			<h6>Evidence</h6>
			<ul class="capability-evidence-list" data-capability-detail-evidence></ul>
		</section>
		<section data-capability-excerpt-section>
			<h6>Relevant project excerpt</h6>
			<blockquote data-capability-detail-excerpt></blockquote>
		</section>
		<section data-capability-deployment-section>
			<h6>Deployment context</h6>
			<p data-capability-detail-deployment></p>
		</section>
		<section data-capability-technologies-section>
			<h6>Related technologies</h6>
			<div class="capability-tag-list" data-capability-detail-technologies></div>
		</section>
	</div>

	<nav
		class="capability-detail-actions"
		data-capability-detail-actions
		aria-label="Project actions"
	></nav>
</aside>
