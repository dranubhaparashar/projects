<section
	class="comparison-results card-base"
	data-comparison-results
	aria-labelledby="comparison-results-title"
	hidden
>
	<header class="comparison-results-header">
		<div>
			<p class="capability-section-kicker">Selected systems</p>
			<h4 id="comparison-results-title">Project system comparison</h4>
		</div>
		<div class="comparison-mode-switch" role="group" aria-label="Comparison rows">
			<button type="button" data-comparison-mode="all" aria-pressed="true">
				Show All
			</button>
			<button type="button" data-comparison-mode="difference" aria-pressed="false">
				Differences Only
			</button>
			<button type="button" data-comparison-mode="similarity" aria-pressed="false">
				Similarities Only
			</button>
		</div>
	</header>

	<section class="comparison-summary" aria-labelledby="comparison-summary-title">
		<h5 id="comparison-summary-title">Key Differences</h5>
		<ul data-comparison-summary></ul>
	</section>

	<div
		class="comparison-table-scroll"
		tabindex="0"
		role="region"
		aria-label="Scrollable selected project comparison"
	>
		<table class="comparison-table">
			<caption class="sr-only">
				Documented properties for the selected projects. Missing information is
				labelled Not documented.
			</caption>
			<thead data-comparison-head></thead>
			<tbody data-comparison-body></tbody>
		</table>
	</div>

	<div class="comparison-mobile-cards" data-comparison-mobile></div>
	<p class="comparison-mode-empty" data-comparison-mode-empty hidden>
		No rows match this view.
	</p>
</section>
