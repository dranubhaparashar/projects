---
import type { ProjectComparisonData } from "@utils/project-comparison-data";
import ComparisonTable from "./ComparisonTable.astro";

interface Props {
	data: ProjectComparisonData;
}

const { data } = Astro.props;
---

<section
	id="project-comparison"
	class="capability-subsection comparison-subsection card-base"
	data-project-comparison
	aria-labelledby="project-comparison-title"
>
	<header class="capability-subsection-header">
		<div>
			<p class="capability-section-kicker">Project Comparison</p>
			<h3 id="project-comparison-title">Compare Project Systems</h3>
			<p>
				Select two or three projects to compare their industry, architecture,
				models, deployment and outcomes side by side.
			</p>
		</div>
	</header>

	<div class="comparison-selector card-base">
		<div class="comparison-selector-toolbar">
			<label class="capability-control comparison-search">
				<span>Search projects</span>
				<input
					type="search"
					data-comparison-search
					placeholder="Search by title, type or capability"
					autocomplete="off"
				/>
			</label>
			<p class="comparison-selected-count" data-comparison-count aria-live="polite">
				0 of 3 projects selected
			</p>
		</div>

		<div class="comparison-selected-projects" data-comparison-selected aria-label="Selected projects"></div>

		<p
			id="comparison-limit-message"
			class="comparison-limit-message"
			data-comparison-limit
			aria-live="polite"
			hidden
		>
			You can compare up to three projects. Remove one selected project to
			replace it.
		</p>

		<div class="comparison-project-list" data-comparison-project-list>
			{data.projects.map((project) => (
				<label
					class="comparison-project-option"
					data-comparison-project-option={project.id}
					data-project-search={`${project.title} ${project.category} ${project.description}`}
				>
					<input
						type="checkbox"
						value={project.id}
						data-comparison-select
						aria-describedby="comparison-limit-message"
					/>
					<span class="comparison-option-indicator" aria-hidden="true">✓</span>
					<span class="comparison-option-copy">
						<strong>{project.title}</strong>
						<small>{project.category}</small>
					</span>
				</label>
			))}
		</div>

		<p class="comparison-search-empty" data-comparison-search-empty hidden>
			No projects match this search.
		</p>

		<div class="comparison-selector-actions">
			<button
				type="button"
				class="comparison-clear btn-plain"
				data-comparison-clear
				disabled
			>
				Clear selection
			</button>
			<button
				type="button"
				class="comparison-submit btn-regular"
				data-comparison-submit
				disabled
			>
				Compare Selected Projects
			</button>
		</div>
	</div>

	<ComparisonTable />
</section>
