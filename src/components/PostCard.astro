---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { normalizePostId } from "@utils/post-id";
import { buildProjectCardData } from "@utils/project-card-data";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	url: string;
	pdf?: string;
	style?: string;
}

const { entry, url, pdf = "", style = "" } = Astro.props;
const className = Astro.props.class;
const card = buildProjectCardData(entry, url, pdf);
const cardId = `project-card-${normalizePostId(entry.slug)}`;
const fullDate = formatDateToYYYYMMDD(entry.data.published);
const year = String(entry.data.published.getFullYear());
const category = entry.data.category?.trim() || "Uncategorized";
---

<article
	class:list={['project-case-card card-base', className]}
	style={style}
	aria-labelledby={`${cardId}-title`}
>
	{card.image && (
		<a
			class='project-card-media'
			href={url}
			aria-label={`View ${card.fullTitle}`}
		>
			<ImageWrapper
				src={card.image.src}
				basePath={card.image.basePath}
				alt={card.image.alt}
				fit='cover'
				overlay={false}
				loading='lazy'
				class='project-card-image'
				imgClass='project-card-image-element'
			/>
		</a>
	)}

	<div class='project-card-body'>
		<header class='project-card-header'>
			<div class='project-card-kicker'>
				<p class='project-card-meta'>
					<span class='sr-only'>Project type: </span>
					<span>{category}</span>
					<span aria-hidden='true'>·</span>
					<time datetime={entry.data.published.toISOString()} title={fullDate}>
						<span class='sr-only'>Published in </span>{year}
					</time>
				</p>
				{card.status && (
					<span
						class='project-status-badge'
						data-status-type={card.status.type}
						aria-label={`Project status: ${card.status.label}`}
					>
						{card.status.label}
					</span>
				)}
			</div>

			<h2 id={`${cardId}-title`} class='project-card-title'>
				<a href={url} title={card.fullTitle} aria-label={card.fullTitle}>
					{card.displayTitle}
				</a>
			</h2>
		</header>

		{card.summary && <p class='project-card-summary'>{card.summary}</p>}

		{(card.problem || card.solution) && (
			<div class='project-card-case-notes'>
				{card.problem && (
					<section aria-labelledby={`${cardId}-problem`}>
						<h3 id={`${cardId}-problem`}>Problem</h3>
						<p>{card.problem}</p>
					</section>
				)}
				{card.solution && (
					<section aria-labelledby={`${cardId}-solution`}>
						<h3 id={`${cardId}-solution`}>Solution</h3>
						<p>{card.solution}</p>
					</section>
				)}
			</div>
		)}

		{card.capabilities.length > 0 && (
			<section class='project-card-section' aria-labelledby={`${cardId}-capabilities`}>
				<h3 id={`${cardId}-capabilities`}>Capabilities</h3>
				<ul class='project-capability-list'>
					{card.capabilities.map((capability) => <li>{capability}</li>)}
					{card.additionalCapabilityCount > 0 && (
						<li class='project-capability-more'>
							<a
								href={url}
								aria-label={`View ${card.additionalCapabilityCount} more documented capabilities and tags for ${card.fullTitle}`}
							>
								+{card.additionalCapabilityCount} more
							</a>
						</li>
					)}
				</ul>
			</section>
		)}

		{card.evidence.length > 0 && (
			<section class='project-card-section project-evidence' aria-labelledby={`${cardId}-evidence`}>
				<h3 id={`${cardId}-evidence`}>Evidence</h3>
				<nav aria-label={`Evidence for ${card.fullTitle}`}>
					{card.evidence.map((item, index) => (
						<>
							{index > 0 && <span aria-hidden='true'>·</span>}
							<a
								href={item.url}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
								aria-label={`${item.label} evidence for ${card.fullTitle}${item.external ? ' (opens in a new tab)' : ''}`}
							>
								{item.label}
							</a>
						</>
					))}
				</nav>
			</section>
		)}

		<footer class='project-card-actions'>
			<a
				class='project-primary-action btn-regular'
				href={url}
				aria-label={`View project: ${card.fullTitle}`}
			>
				View Project
			</a>
			{card.actions.length > 0 && (
				<div class='project-secondary-actions' aria-label={`More actions for ${card.fullTitle}`}>
					{card.actions.map((action) => (
						<a
							href={action.url}
							target={action.external ? '_blank' : undefined}
							rel={action.external ? 'noopener noreferrer' : undefined}
							aria-label={`${action.label} for ${card.fullTitle}${action.external ? ' (opens in a new tab)' : ''}`}
						>
							{action.label}
						</a>
					))}
				</div>
			)}
		</footer>
	</div>
</article>

<style>
	.project-case-card {
		display: flex;
		min-width: 0;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		box-shadow: 0 8px 22px rgb(15 23 42 / 0.08);
		backdrop-filter: none;
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.project-card-media {
		display: block;
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: color-mix(in srgb, var(--card-bg) 88%, var(--primary));
		border-bottom: 1px solid var(--card-border);
	}

	.project-card-image {
		width: 100%;
		height: 100%;
	}

	.project-card-media :global(.project-card-image-element) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 180ms ease;
	}

	.project-card-body {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 1rem;
		padding: 1.3rem;
	}

	.project-card-header,
	.project-card-section,
	.project-card-case-notes section {
		min-width: 0;
	}

	.project-card-kicker {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.8rem;
	}

	.project-card-meta {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.71rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.project-status-badge {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.38rem;
		max-width: 48%;
		padding: 0.3rem 0.52rem;
		border: 1px solid var(--theme-accent-border);
		border-radius: 999px;
		background: var(--theme-accent-soft);
		color: var(--theme-accent-text);
		font-size: 0.69rem;
		font-weight: 750;
		line-height: 1.2;
		text-align: right;
		text-transform: uppercase;
	}

	.project-status-badge::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		flex: 0 0 auto;
		border: 1px solid currentColor;
		border-radius: 50%;
		background: currentColor;
	}

	.project-card-title {
		margin: 0;
		font-size: clamp(1.28rem, 2vw, 1.55rem);
		line-height: 1.18;
		letter-spacing: -0.032em;
	}

	.project-card-title a {
		display: -webkit-box;
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.project-card-title a:hover {
		color: var(--primary);
	}

	.project-card-summary {
		display: -webkit-box;
		overflow: hidden;
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.58;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.project-card-case-notes {
		display: grid;
		gap: 0.85rem;
		padding: 0.9rem 0 0.9rem 0.95rem;
		border-left: 3px solid var(--theme-accent-border);
		background: color-mix(in srgb, var(--theme-accent-soft) 55%, transparent);
	}

	.project-card-case-notes h3,
	.project-card-section h3 {
		margin: 0 0 0.32rem;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-card-case-notes p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.84rem;
		line-height: 1.48;
	}

	.project-capability-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-capability-list li {
		display: inline-flex;
		align-items: center;
		min-height: 1.9rem;
		padding: 0.28rem 0.58rem;
		border: 1px solid var(--theme-accent-border);
		border-radius: 999px;
		background: var(--theme-accent-soft);
		color: var(--theme-accent-text);
		font-size: 0.74rem;
		font-weight: 650;
		line-height: 1.25;
	}

	.project-capability-list .project-capability-more {
		padding: 0;
		background: transparent;
		border-style: dashed;
	}

	.project-capability-more a {
		display: inline-flex;
		align-items: center;
		min-height: 1.9rem;
		padding: 0.28rem 0.58rem;
		color: var(--primary);
		text-decoration: none;
	}

	.project-evidence nav {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0.42rem;
		color: var(--text-muted);
		font-size: 0.79rem;
		line-height: 1.45;
	}

	.project-evidence a {
		color: var(--text-secondary);
		font-weight: 650;
		text-underline-offset: 0.2rem;
	}

	.project-evidence a:hover {
		color: var(--primary);
	}

	.project-card-actions {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--card-border);
	}

	.project-primary-action {
		min-height: 2.65rem;
		flex: 0 0 auto;
		padding: 0.68rem 1rem;
		border-radius: calc(var(--radius-large) * 0.56);
		font-size: 0.84rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-secondary-actions {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.3rem 0.65rem;
	}

	.project-secondary-actions a {
		display: inline-flex;
		min-height: 2.45rem;
		align-items: center;
		padding: 0.45rem 0.05rem;
		color: var(--text-secondary);
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration-line: underline;
		text-decoration-color: var(--theme-accent-border);
		text-underline-offset: 0.22rem;
	}

	.project-secondary-actions a:hover {
		color: var(--primary);
		text-decoration-color: currentColor;
	}

	.project-case-card:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.project-case-card :where(a):focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
		border-radius: 0.28rem;
	}

	:global(.dark) .project-case-card {
		box-shadow: 0 8px 22px rgb(0 0 0 / 0.2);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-case-card:hover {
			transform: translateY(-2px);
			border-color: color-mix(in srgb, var(--primary) 48%, var(--card-border));
			box-shadow: 0 11px 26px rgb(15 23 42 / 0.12);
		}

		.project-card-media:hover :global(.project-card-image-element) {
			transform: scale(1.01);
		}
	}

	@media (max-width: 640px) {
		.project-card-body {
			gap: 0.9rem;
			padding: 1.15rem;
		}

		.project-card-kicker {
			align-items: flex-start;
		}

		.project-status-badge {
			max-width: 52%;
			font-size: 0.66rem;
		}

		.project-card-title {
			font-size: 1.3rem;
		}

		.project-card-case-notes p {
			overflow: visible;
		}

		.project-card-actions {
			align-items: stretch;
			flex-direction: column;
		}

		.project-primary-action {
			width: 100%;
		}

		.project-secondary-actions {
			width: 100%;
			justify-content: flex-start;
			gap: 0.35rem 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-case-card,
		.project-card-media :global(.project-card-image-element) {
			transition: none;
		}

		.project-case-card:hover,
		.project-card-media:hover :global(.project-card-image-element) {
			transform: none;
		}
	}
</style>
