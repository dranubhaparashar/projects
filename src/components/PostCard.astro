---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { normalizePostId } from "@utils/post-id";
import { buildProjectCardData } from "@utils/project-card-data";
import type { ProjectDiscoveryRecord } from "@utils/project-discovery-data";
import { toFilterKey } from "@utils/project-problem-matching";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	url: string;
	pdf?: string;
	style?: string;
	discovery?: ProjectDiscoveryRecord;
}

const { entry, url, pdf = "", style = "", discovery } = Astro.props;
const className = Astro.props.class;
const card = discovery?.card || buildProjectCardData(entry, url, pdf);
const cardId = `project-card-${normalizePostId(entry.slug)}`;
const projectId = discovery?.id || toFilterKey(entry.slug);
const fullDate = formatDateToYYYYMMDD(entry.data.published);
const year = String(entry.data.published.getFullYear());
const category = entry.data.category?.trim() || "Uncategorized";
const summaryItems = card.maturitySummary.filter(
	(item) => item !== card.featuredEvidence?.label,
);
const assistantQuestions = [
	"Show similar projects",
	"Which technologies are used?",
	"Is this deployed?",
	"What problem does this solve?",
	"Which projects use similar capabilities?",
];
const opensInNewTab = (href: string, external: boolean) =>
	external || /\.pdf(?:$|[?#])/i.test(href);
---

<article
	class:list={['project-case-card card-base', className]}
	style={style}
	aria-labelledby={`${cardId}-title`}
	data-project-card
	data-project-id={projectId}
	data-project-slug={entry.slug}
	data-project-title={card.displayTitle}
	data-project-search={discovery?.searchText || ""}
	data-project-industries={discovery?.industryIds.join(" ") || ""}
	data-project-capabilities={discovery?.capabilityIds.join(" ") || ""}
	data-project-technologies={discovery?.technologies.map((item) => item.id).join(" ") || ""}
	data-project-category={toFilterKey(category)}
	data-project-status={discovery?.status || entry.data.status?.type || ""}
	data-project-has-publication={card.relatedPublicationCount > 0 ? "true" : "false"}
	data-project-published={discovery?.publishedMs || entry.data.published.getTime()}
	data-project-featured={discovery?.featured ? "true" : "false"}
>
	<div class='project-card-media-shell'>
	<a
		class:list={[
			'project-card-media',
			{
				'project-card-media-generated': card.image.generated,
				'project-card-media-architecture': card.image.architecture,
			},
		]}
		data-image-fit={card.image.fit}
		href={url}
		aria-label={`View ${card.fullTitle}`}
		data-analytics-event="project-card-open"
		data-analytics-label={card.fullTitle}
	>
		{card.image.generated ? (
			<img
				src={card.image.src}
				alt={card.image.alt}
				loading='lazy'
				decoding='async'
				class='project-card-image-element'
			/>
		) : (
			<ImageWrapper
				src={card.image.src}
				basePath={card.image.basePath}
				alt={card.image.alt}
				fit={card.image.fit}
				overlay={false}
				loading='lazy'
				class='project-card-image'
				imgClass='project-card-image-element'
			/>
		)}
		{card.image.architecture && (
			<span class='project-card-architecture-label' aria-hidden='true'>
				Architecture Preview
			</span>
		)}
	</a>
	<nav class='project-thumbnail-actions' aria-label={`Quick actions for ${card.fullTitle}`}>
		<a href={url}>View Project</a>
		{card.quickActions.map((action) => (
			<a
				href={action.url}
				target={opensInNewTab(action.url, action.external) ? '_blank' : undefined}
				rel={opensInNewTab(action.url, action.external) ? 'noopener noreferrer' : undefined}
			>{action.label}</a>
		))}
	</nav>
	</div>

	<div class='project-card-body'>
		<header class='project-card-header'>
			<div class='project-card-kicker'>
				<p class='project-card-meta'>
					<span class='sr-only'>Project type: </span>
					<span>{category}</span>
					<span aria-hidden='true'>·</span>
					<time datetime={entry.data.published.toISOString()} title={fullDate}>
						<span class='sr-only'>Published in </span>{year}
					</time>
				</p>
				<div class='project-card-kicker-actions'>
					{discovery?.primaryIndustry && (
						<span class='project-industry-badge' aria-label={`Primary industry: ${discovery.primaryIndustry.label}`}>
							{discovery.primaryIndustry.label}
						</span>
					)}
					{discovery && (
						<label class='project-compare-control'>
							<input type='checkbox' value={projectId} data-project-compare aria-label={`Compare ${card.fullTitle}`} />
							<span>Compare</span>
						</label>
					)}
				</div>
			</div>

			<h2
				id={`${cardId}-title`}
				class:list={['project-card-title', { 'has-short-title': card.hasDisplayTitle }]}
			>
				<a href={url} title={card.fullTitle} aria-label={card.fullTitle} data-analytics-event="project-card-open" data-analytics-label={card.fullTitle}>
					{card.displayTitle}
				</a>
			</h2>
		</header>

		{card.summary && <p class='project-card-summary'>{card.summary}</p>}

		{card.evaluation && (
			<section class='project-card-proof' aria-label={`Measured result for ${card.fullTitle}`}>
				<p class='project-card-proof-result'>
					<strong>{card.evaluation.value}</strong>
					<span>{card.evaluation.label}</span>
				</p>
				<p class='project-card-proof-context'>
					<span>{card.evaluation.scopeLabel}</span>
					<span aria-hidden='true'>·</span>
					{card.evaluation.context}
				</p>
				{card.evaluation.sourceUrl && (
					<a href={card.evaluation.sourceUrl} data-analytics-event="evaluation-source" data-analytics-label={card.fullTitle}>
						How measured
					</a>
				)}
			</section>
		)}

		{(summaryItems.length > 0 || card.featuredEvidence) && (
			<div class='project-maturity-line' aria-label={`Project maturity and evidence: ${card.maturitySummary.join(", ")}`}>
				{summaryItems.length > 0 && <span>{summaryItems.join(" · ")}</span>}
				{card.featuredEvidence && (
					<a
						class='project-featured-evidence'
						href={card.featuredEvidence.url}
						target={opensInNewTab(card.featuredEvidence.url, card.featuredEvidence.external) ? '_blank' : undefined}
						rel={opensInNewTab(card.featuredEvidence.url, card.featuredEvidence.external) ? 'noopener noreferrer' : undefined}
						aria-label={`Featured evidence: ${card.featuredEvidence.label} for ${card.fullTitle}`}
					>
						{card.featuredEvidence.label}
					</a>
				)}
			</div>
		)}

		{card.capabilities.length > 0 && (
			<section class='project-card-section' aria-labelledby={`${cardId}-capabilities`}>
				<h3 id={`${cardId}-capabilities`}>Capabilities</h3>
				<ul class='project-capability-list'>
					{card.capabilities.map((capability) => <li>{capability}</li>)}
					{card.additionalCapabilityCount > 0 && (
						<li class='project-capability-more'>
							<a
								href={url}
								aria-label={`View all capabilities for ${card.fullTitle}`}
							>
								More capabilities
							</a>
						</li>
					)}
				</ul>
			</section>
		)}

		{discovery && card.whyItMatters && (
			<section class='project-card-why' aria-labelledby={`${cardId}-why`}>
				<h3 id={`${cardId}-why`}>Why it matters</h3>
				<p>{card.whyItMatters}</p>
			</section>
		)}

		{discovery && discovery.relatedProjects.length > 0 && (
			<nav class='project-card-related' aria-label={`Related projects to ${card.fullTitle}`}>
				<h3>Related projects</h3>
				<div class='project-card-related-links'>
					{discovery.relatedProjects.map((related) => <a href={related.url}>{related.title}</a>)}
				</div>
			</nav>
		)}

		<footer class='project-card-actions'>
			<a
				class='project-primary-action btn-regular'
				href={url}
				aria-label={`View project: ${card.fullTitle}`}
				data-analytics-event="project-card-open"
				data-analytics-label={card.fullTitle}
			>
				View Project
			</a>
			{card.actions.length > 0 && (
				<nav class='project-secondary-actions' aria-label={`More actions for ${card.fullTitle}`}>
					{card.actions.map((action, index) => (
						<span class='project-secondary-action-item'>
							{index > 0 && (
								<span class='project-secondary-separator' aria-hidden='true'>·</span>
							)}
							<a
								href={action.url}
								target={opensInNewTab(action.url, action.external) ? '_blank' : undefined}
								rel={opensInNewTab(action.url, action.external) ? 'noopener noreferrer' : undefined}
								aria-label={`${action.ariaLabel || `${action.label} for ${card.fullTitle}`}${opensInNewTab(action.url, action.external) ? ' (opens in a new tab)' : ''}`}
								data-analytics-event={action.kind === 'github' ? 'github-cta' : `project-${action.kind}`}
								data-analytics-label={card.fullTitle}
							>
								{action.label}
							</a>
						</span>
					))}
				</nav>
			)}
		</footer>
	</div>

	{discovery && (
		<section class='project-card-discovery-panel' aria-label={`More discovery options for ${card.fullTitle}`}>
			{card.quickActions.length > 0 && (
				<nav class='project-mobile-quick-links' aria-label={`Quick actions for ${card.fullTitle}`}>
					{card.quickActions.map((action) => (
						<a href={action.url} target={opensInNewTab(action.url, action.external) ? '_blank' : undefined} rel={opensInNewTab(action.url, action.external) ? 'noopener noreferrer' : undefined}>{action.label}</a>
					))}
				</nav>
			)}
			<details class='project-ask-menu' data-analytics-event="ask-about-project" data-analytics-label={card.fullTitle}>
				<summary>Ask about this project</summary>
				<div>{assistantQuestions.map((question) => (
					<button type='button' data-project-assistant-question={question} data-project-assistant-slug={entry.slug}>{question}</button>
				))}</div>
			</details>
		</section>
	)}
</article>

<style>
	.project-case-card {
		display: flex;
		position: relative;
		min-width: 0;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		border-radius: var(--radius-card);
		box-shadow: var(--card-shadow);
		backdrop-filter: none;
		--project-accent: var(--primary);
		transition:
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.project-card-media-shell {
		position: relative;
		width: calc(100% - 1rem);
		aspect-ratio: 16 / 9;
		margin: 0.5rem auto 0;
		padding: 0;
		border: 1px solid var(--border-subtle);
		border-radius: calc(var(--radius-card) - 0.3rem);
		background: var(--card-media-bg);
		overflow: hidden;
	}

	.project-card-media {
		display: grid;
		position: relative;
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 9;
		place-items: center;
		overflow: hidden;
		margin: 0;
		background: var(--card-media-bg);
		border: 0;
		border-radius: inherit;
	}

	.project-thumbnail-actions {
		display: flex;
		position: absolute;
		z-index: 4;
		right: 0.55rem;
		bottom: 0.55rem;
		left: 0.55rem;
		visibility: hidden;
		align-items: center;
		justify-content: center;
		gap: 0.38rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 140ms ease;
	}

	.project-thumbnail-actions a {
		display: inline-flex;
		min-height: 2rem;
		align-items: center;
		padding: 0.34rem 0.55rem;
		border: 1px solid color-mix(in srgb, var(--card-border) 72%, var(--text-primary));
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		color: var(--text-primary);
		font-size: 0.68rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-card-media-shell::after {
		position: absolute;
		inset: 0;
		background: var(--image-edge-overlay);
		content: '';
		opacity: 0.78;
		pointer-events: none;
		transition: opacity 360ms ease;
	}

	.project-card-image {
		width: 100%;
		height: 100%;
	}

	.project-card-media :global(.project-card-image-element) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), filter 220ms ease;
	}

	.project-card-media[data-image-fit='contain'] {
		background: color-mix(in srgb, var(--card-bg) 92%, var(--primary));
	}

	.project-card-media[data-image-fit='contain']
		:global(.project-card-image-element) {
		box-sizing: border-box;
		object-fit: contain;
		padding: clamp(1.1rem, 2.6vw, 1.6rem);
	}

	.project-card-media-generated {
		background: color-mix(in srgb, var(--card-bg) 96%, var(--primary));
	}

	.project-card-architecture-label {
		display: inline-flex;
		position: absolute;
		right: 0.45rem;
		bottom: 0.4rem;
		align-items: center;
		padding: 0.2rem 0.42rem;
		border: 1px solid color-mix(in srgb, var(--card-border) 82%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		color: var(--text-secondary);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.025em;
		line-height: 1.2;
		pointer-events: none;
	}

	.project-card-body {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 0.62rem;
		padding: 1rem 1.05rem 1.05rem;
		border-top: 1px solid color-mix(in srgb, var(--project-accent) 34%, var(--border-subtle));
	}

	.project-card-header,
	.project-card-section {
		min-width: 0;
	}

	.project-card-kicker {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.38rem;
	}

	.project-card-kicker-actions {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.4rem;
	}

	.project-industry-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.44rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 0.34rem;
		background: var(--chip-bg);
		color: var(--text-muted);
		font-size: 0.62rem;
		font-weight: 750;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.project-compare-control {
		display: inline-flex;
		position: relative;
		z-index: 9;
		min-height: 1.7rem;
		align-items: center;
		gap: 0.28rem;
		color: var(--text-secondary);
		font-size: 0.66rem;
		font-weight: 700;
		cursor: pointer;
		pointer-events: auto;
	}

	.project-compare-control input {
		display: grid;
		width: 1rem;
		height: 1rem;
		margin: 0;
		appearance: none;
		place-content: center;
		border: 1px solid var(--border-default);
		border-radius: 0.2rem;
		background: color-mix(in srgb, var(--control-bg) 78%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text-primary) 3%, transparent);
		cursor: pointer;
		transition: border-color 280ms ease, background-color 280ms ease, box-shadow 320ms ease;
	}

	.project-compare-control input::before {
		width: 0.47rem;
		height: 0.26rem;
		border-bottom: 1.5px solid var(--text-primary);
		border-left: 1.5px solid var(--text-primary);
		content: '';
		transform: rotate(-45deg) scale(0);
		transform-origin: center;
		transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-compare-control input:checked {
		border-color: var(--action-primary-border-hover);
		background: color-mix(in srgb, var(--accent-deep) 72%, var(--bg-elevated));
		box-shadow: 0 0 16px color-mix(in srgb, var(--accent-cyan) 10%, transparent);
	}

	.project-compare-control input:checked::before {
		transform: rotate(-45deg) scale(1);
	}

	.project-compare-control input:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--accent-cyan) 48%, transparent);
		outline-offset: 2px;
	}

	.project-card-meta {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: 0.71rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.project-status-badge {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.38rem;
		max-width: 48%;
		padding: 0.24rem 0.46rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 999px;
		background: color-mix(in srgb, var(--project-accent) 12%, var(--card-bg));
		color: color-mix(in srgb, var(--project-accent) 82%, var(--text-primary));
		font-size: 0.65rem;
		font-weight: 750;
		line-height: 1.2;
		text-align: right;
		text-transform: uppercase;
	}

	.project-status-badge::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		flex: 0 0 auto;
		border: 1px solid currentColor;
		border-radius: 50%;
		background: currentColor;
	}

	.project-card-title {
		min-height: calc(1.16em * 2);
		margin: 0;
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		line-height: 1.08;
		letter-spacing: -0.024em;
	}

	.project-card-title a {
		display: -webkit-box;
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.project-card-title.has-short-title a {
		-webkit-line-clamp: 2;
	}

	.project-card-title a:hover {
		color: var(--primary);
	}

	.project-card-summary {
		display: -webkit-box;
		min-height: calc(1.42em * 2);
		overflow: hidden;
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.92rem;
		line-height: 1.58;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-maturity-line {
		display: flex;
		min-height: 1.6rem;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-muted);
		font-size: 0.72rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.project-featured-evidence {
		display: inline-flex;
		align-items: center;
		padding: 0.18rem 0.42rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 0.32rem;
		background: var(--chip-bg);
		color: var(--text-muted);
		font-size: 0.67rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-mobile-quick-links {
		display: none;
	}

	.project-card-proof {
		display: grid;
		gap: 0.3rem;
		padding: 0.68rem 0.75rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.46rem;
		background: var(--metric-bg);
	}

	.project-card-proof-result,
	.project-card-proof-context {
		margin: 0;
	}

	.project-card-proof-result {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.22rem 0.48rem;
		color: var(--text-primary);
		line-height: 1.25;
	}

	.project-card-proof-result strong {
		color: color-mix(in srgb, var(--project-accent) 85%, var(--text-primary));
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.015em;
	}

	.project-card-proof-result span {
		font-size: 0.75rem;
		font-weight: 600;
	}

	.project-card-proof-context {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		gap: 0.18rem 0.36rem;
		color: var(--text-muted);
		font-size: 0.67rem;
		line-height: 1.4;
	}

	.project-card-proof-context > span:first-child {
		color: var(--text-secondary);
		font-weight: 750;
	}

	.project-card-proof > a {
		position: static;
		justify-self: end;
		color: var(--link-default);
		font-size: 0.65rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-card-proof > a:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--primary) 52%, transparent);
		outline-offset: 2px;
	}

	.project-card-discovery-panel {
		display: grid;
		position: static;
		visibility: visible;
		max-height: none;
		overflow: visible;
		gap: 0.55rem;
		margin: 0 1.05rem 1.05rem;
		padding: 0.78rem 0 0;
		border: 0;
		border-top: 1px solid var(--line-divider);
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}

	.project-card-discovery-panel h3 {
		margin: 0 0 0.2rem;
		color: var(--text-muted);
