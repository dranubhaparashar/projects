---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { normalizePostId } from "../utils/post-id";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	viewsPath: string;
	postId: string;
}

const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	viewsPath,
	postId,
} = Astro.props;

const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const normalizedPostId = normalizePostId(entry.slug);
const { remarkPluginFrontmatter } = await entry.render();
const coverBasePath = path.join("content/posts/", getDir(entry.id));

const isLocalCover =
	hasCover &&
	!(
		image.startsWith("/") ||
		image.startsWith("http") ||
		image.startsWith("https") ||
		image.startsWith("data:")
	);

let coverWidth = 16;
let coverHeight = 9;

if (isLocalCover) {
	const files = import.meta.glob<ImageMetadata>("../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../", coverBasePath, image))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];

	if (file) {
		const cover = await file();
		coverWidth = cover.width;
		coverHeight = cover.height;
	}
}

const isPortraitCover = coverHeight > coverWidth;
const coverAspectRatio = `${coverWidth} / ${coverHeight}`;
const coverAspect = coverWidth / coverHeight;

/**
 * Float-right image sizing.
 * This allows title/meta/tags/description to stretch until the image
 * and then naturally wrap to the next line.
 */
const coverMaxWidth = isPortraitCover ? 260 : 340;
const coverMaxHeight = isPortraitCover ? 310 : 220;
const coverDisplayWidth = Math.round(
	Math.min(coverMaxWidth, coverMaxHeight * coverAspect),
);
---

<div
	class:list={[
		"card-base post-card-clean w-full rounded-[var(--radius-large)] overflow-hidden relative px-6 md:px-9 pt-6 md:pt-7 pb-6",
		className,
	]}
	style={style}
>
	<!-- Right floated image. Text, tags, and description wrap around this. -->
	{hasCover && (
		<a
			href={url}
			aria-label={title}
			class:list={[
				"post-card-clean-cover group",
				"relative float-right ml-6 mb-5 hidden md:flex items-center justify-center overflow-hidden rounded-2xl bg-white active:scale-95",
				isPortraitCover
					? "w-[var(--cover-width)]"
					: "w-[var(--cover-width)]",
			]}
			style={`aspect-ratio: ${coverAspectRatio}; --cover-width: ${coverDisplayWidth}px;`}
		>
			<!-- Dark hover overlay -->
			<div class="absolute pointer-events-none z-10 h-full w-full rounded-2xl ring-1 ring-black/5 transition group-hover:bg-black/25 group-active:bg-black/35 dark:ring-white/10"></div>

			<!-- Nice image hover arrow -->
			<div class="absolute pointer-events-none z-20 flex h-full w-full items-center justify-center">
				<div class="flex h-14 w-14 scale-75 items-center justify-center rounded-full bg-white/90 opacity-0 shadow-xl backdrop-blur-md transition duration-200 group-hover:scale-100 group-hover:opacity-100">
					<Icon
						name="material-symbols:arrow-forward-rounded"
						class="text-4xl text-[var(--primary)]"
					></Icon>
				</div>
			</div>

			<ImageWrapper
				src={image}
				basePath={coverBasePath}
				alt={title}
				class="post-card-cover post-card-image-frame w-full h-full bg-white"
				imgClass="post-card-image"
				fit="contain"
				overlay={false}
			>
			</ImageWrapper>
		</a>
	)}

	<!-- Mobile image on top -->
	{hasCover && (
		<a
			href={url}
			aria-label={title}
			class:list={[
				"post-card-clean-cover group",
				"relative mx-auto mb-5 flex md:hidden items-center justify-center overflow-hidden rounded-2xl bg-white active:scale-95",
				isPortraitCover
					? "w-[min(16.25rem,calc(100%-2rem))]"
					: "w-full",
			]}
			style={`aspect-ratio: ${coverAspectRatio};`}
		>
			<div class="absolute pointer-events-none z-10 h-full w-full rounded-2xl ring-1 ring-black/5 transition group-hover:bg-black/25 group-active:bg-black/35 dark:ring-white/10"></div>

			<div class="absolute pointer-events-none z-20 flex h-full w-full items-center justify-center">
				<div class="flex h-14 w-14 scale-75 items-center justify-center rounded-full bg-white/90 opacity-0 shadow-xl backdrop-blur-md transition duration-200 group-hover:scale-100 group-hover:opacity-100">
					<Icon
						name="material-symbols:arrow-forward-rounded"
						class="text-4xl text-[var(--primary)]"
					></Icon>
				</div>
			</div>

			<ImageWrapper
				src={image}
				basePath={coverBasePath}
				alt={title}
				class="post-card-cover post-card-image-frame w-full h-full bg-white"
				imgClass="post-card-image"
				fit="contain"
				overlay={false}
			>
			</ImageWrapper>
		</a>
	)}

	<!-- Title -->
	<a
		href={url}
		class="transition group w-full block font-bold mb-3 text-3xl text-90 break-words
			hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
			active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
			before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
			before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
	>
		{title}

		<Icon
			class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute"
			name="material-symbols:chevron-right-rounded"
		></Icon>

		<Icon
			class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
			name="material-symbols:chevron-right-rounded"
		></Icon>
	</a>

	<!-- Metadata and tags.
	     Because the image is floated right, this stretches until the image
	     and then wraps naturally to the next line. -->
	<PostMetadata
		published={published}
		updated={updated}
		tags={tags}
		category={category}
		viewsPath={viewsPath}
		postId={normalizedPostId || postId}
		postTitle={title}
		incrementViews={false}
		showLike={false}
		showCommentsCount={false}
		hideTagsForMobile={false}
		hideUpdateDate={true}
		limitTagsToTwoLines={true}
		class="mb-4 post-card-meta-flow"
	></PostMetadata>

	<!-- Description.
	     This also stretches until the image and wraps below it if required. -->
	<div class="transition text-75 mb-0 md:pr-0 leading-relaxed line-clamp-4 post-card-description-flow">
		{description || remarkPluginFrontmatter.excerpt}
	</div>

	<!-- Clears the floated image so the card height contains it fully. -->
	<div class="clear-both"></div>
</div>

<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>

<style>
	:global(.post-card-clean) {
		position: relative;
	}

	:global(.post-card-clean-cover) {
		box-shadow: 0 18px 42px rgba(2, 6, 23, 0.16);
	}

	:global(.post-card-clean-cover:hover) {
		box-shadow: 0 24px 58px rgba(2, 6, 23, 0.22);
	}

	:global(.post-card-image-frame) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: white;
	}

	:global(.post-card-image-frame picture) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	:global(.post-card-image-frame img),
	:global(.post-card-image) {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		object-position: center;
		background: white;
		border-radius: 0.875rem;
	}

	/* Important:
	   This makes tag/meta rows use full available width until the image,
	   then wrap naturally instead of being trapped in a narrow left column. */
	:global(.post-card-meta-flow) {
		max-width: none;
	}

	:global(.post-card-description-flow) {
		max-width: none;
	}

	/* Hide old vertical arrow/action strip if any old class remains somewhere */
	:global(.post-card-arrow-strip),
	:global(.project-card-action-strip),
	:global(.card-arrow-strip),
	:global(.vertical-arrow-bar),
	:global(.project-card-slider-arrow) {
		display: none !important;
	}

	@media (max-width: 767px) {
		:global(.post-card-clean) {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}

		:global(.post-card-clean-cover) {
			float: none;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>