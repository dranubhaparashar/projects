---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { normalizePostId } from "../utils/post-id";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	viewsPath: string;
	postId: string;
}

const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	viewsPath,
	postId,
} = Astro.props;

const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const normalizedPostId = normalizePostId(entry.slug);
const { remarkPluginFrontmatter } = await entry.render();
const coverBasePath = path.join("content/posts/", getDir(entry.id));

const isLocalCover =
	hasCover &&
	!(
		image.startsWith("/") ||
		image.startsWith("http") ||
		image.startsWith("https") ||
		image.startsWith("data:")
	);

let coverWidth = 16;
let coverHeight = 9;

if (isLocalCover) {
	const files = import.meta.glob<ImageMetadata>("../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../", coverBasePath, image))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (file) {
		const cover = await file();
		coverWidth = cover.width;
		coverHeight = cover.height;
	}
}

const isPortraitCover = coverHeight > coverWidth;
const coverAspectRatio = `${coverWidth} / ${coverHeight}`;
const coverAspect = coverWidth / coverHeight;

/**
 * Card media sizing
 * - Portrait images remain portrait and clear.
 * - Landscape images remain landscape and clear.
 * - The old right-side vertical arrow/action strip is removed.
 */
const coverMaxWidth = isPortraitCover ? 260 : 340;
const coverMaxHeight = isPortraitCover ? 310 : 220;
const coverDisplayWidth = Math.round(
	Math.min(coverMaxWidth, coverMaxHeight * coverAspect),
);
---

<div
	class:list={[
		"card-base post-card-clean grid w-full rounded-[var(--radius-large)] overflow-hidden relative",
		hasCover
			? "grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(240px,340px)] md:gap-6 lg:gap-7 items-center"
			: "grid-cols-1 items-center",
		className,
	]}
	style={style}
>
	<!-- Left text/content column -->
	<div
		class:list={[
			"post-card-clean-content min-w-0 overflow-visible px-6 md:pl-9 md:pr-0 pt-6 md:pt-7 pb-6 relative",
			hasCover ? "md:col-start-1" : "md:col-start-1",
		]}
	>
		<a
			href={url}
			class="transition group w-full block font-bold mb-3 text-3xl text-90 break-words
				hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
				active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
				before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
				before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
		>
			{title}
			<Icon
				class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute"
				name="material-symbols:chevron-right-rounded"
			></Icon>
			<Icon
				class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
				name="material-symbols:chevron-right-rounded"
			></Icon>
		</a>

		<!-- Metadata: date, category, views, tags -->
		<PostMetadata
			published={published}
			updated={updated}
			tags={tags}
			category={category}
			viewsPath={viewsPath}
			postId={normalizedPostId || postId}
			postTitle={title}
			incrementViews={false}
			showLike={false}
			showCommentsCount={false}
			hideTagsForMobile={false}
			hideUpdateDate={true}
			limitTagsToTwoLines={true}
			class="mb-4"
		></PostMetadata>

		<!-- Description -->
		<div class="transition text-75 mb-3.5 md:pr-0 leading-relaxed line-clamp-3">
			{description || remarkPluginFrontmatter.excerpt}
		</div>

		<!-- Clean mobile/desktop action link, replacing old vertical arrow strip -->
		<a
			href={url}
			aria-label={`View project: ${title}`}
			class="post-card-clean-link mt-4 inline-flex w-fit items-center gap-2 rounded-full border border-sky-500/25 bg-sky-500/10 px-4 py-2 text-sm font-semibold text-sky-700 transition hover:bg-sky-500/15 hover:text-sky-800 dark:text-sky-200 dark:border-sky-300/20 dark:bg-sky-400/10 dark:hover:bg-sky-400/15"
		>
			View Project
			<Icon
				name="material-symbols:arrow-forward-rounded"
				class="text-lg"
			></Icon>
		</a>
	</div>

	<!-- Right image column -->
	{hasCover && (
		<a
			href={url}
			aria-label={title}
			class:list={[
				"post-card-clean-cover group",
				"relative mx-auto mb-5 flex items-center justify-center overflow-hidden rounded-2xl bg-white active:scale-95 md:mx-0 md:my-5 md:mr-6 md:justify-self-end md:self-center md:col-start-2",
				isPortraitCover
					? "w-[min(16.25rem,calc(100%-2rem))] md:w-[var(--cover-width)]"
					: "w-[calc(100%-2rem)] md:w-[var(--cover-width)]",
			]}
			style={`aspect-ratio: ${coverAspectRatio}; --cover-width: ${coverDisplayWidth}px;`}
		>
			<div class="absolute pointer-events-none z-10 h-full w-full rounded-2xl ring-1 ring-black/5 transition group-hover:bg-black/5 dark:ring-white/10"></div>

			<ImageWrapper
				src={image}
				basePath={coverBasePath}
				alt={title}
				class="post-card-cover post-card-image-frame w-full h-full bg-white"
				imgClass="post-card-image"
				fit="contain"
				overlay={false}
			>
			</ImageWrapper>
		</a>
	)}
</div>

<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>

<style>
	/* Main card cleanup */
	:global(.post-card-clean) {
		position: relative;
	}

	:global(.post-card-clean-content) {
		min-width: 0;
	}

	:global(.post-card-clean-cover) {
		box-shadow: 0 18px 42px rgba(2, 6, 23, 0.16);
	}

	/* Cover image handling */
	:global(.post-card-image-frame) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: white;
	}

	:global(.post-card-image-frame picture) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	:global(.post-card-image-frame img),
	:global(.post-card-image) {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		object-position: center;
		background: white;
		border-radius: 0.875rem;
	}

	/* Extra safety: hide any old vertical arrow strip if another class remains elsewhere */
	:global(.post-card-arrow-strip),
	:global(.project-card-action-strip),
	:global(.card-arrow-strip),
	:global(.vertical-arrow-bar),
	:global(.project-card-slider-arrow) {
		display: none !important;
	}

	@media (max-width: 767px) {
		:global(.post-card-clean-cover) {
			order: -1;
			margin-top: 1rem;
		}
	}
</style>