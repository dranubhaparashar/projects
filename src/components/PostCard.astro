---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { normalizePostId } from "@utils/post-id";
import { buildProjectCardData } from "@utils/project-card-data";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	url: string;
	pdf?: string;
	style?: string;
}

const { entry, url, pdf = "", style = "" } = Astro.props;
const className = Astro.props.class;
const card = buildProjectCardData(entry, url, pdf);
const cardId = `project-card-${normalizePostId(entry.slug)}`;
const fullDate = formatDateToYYYYMMDD(entry.data.published);
const year = String(entry.data.published.getFullYear());
const category = entry.data.category?.trim() || "Uncategorized";
---

<article
	class:list={['project-case-card card-base', className]}
	style={style}
	aria-labelledby={`${cardId}-title`}
>
	<a
		class:list={[
			'project-card-media',
			{ 'project-card-media-generated': card.image.generated },
		]}
		data-image-fit={card.image.fit}
		href={url}
		aria-label={`View ${card.fullTitle}`}
	>
		{card.image.generated ? (
			<img
				src={card.image.src}
				alt={card.image.alt}
				loading='lazy'
				decoding='async'
				class='project-card-image-element'
			/>
		) : (
			<ImageWrapper
				src={card.image.src}
				basePath={card.image.basePath}
				alt={card.image.alt}
				fit={card.image.fit}
				overlay={false}
				loading='lazy'
				class='project-card-image'
				imgClass='project-card-image-element'
			/>
		)}
	</a>

	<div class='project-card-body'>
		<header class='project-card-header'>
			<div class='project-card-kicker'>
				<p class='project-card-meta'>
					<span class='sr-only'>Project type: </span>
					<span>{category}</span>
					<span aria-hidden='true'>·</span>
					<time datetime={entry.data.published.toISOString()} title={fullDate}>
						<span class='sr-only'>Published in </span>{year}
					</time>
				</p>
				{card.status && (
					<span
						class='project-status-badge'
						data-status-type={card.status.type}
						aria-label={`Project status: ${card.status.label}`}
					>
						{card.status.label}
					</span>
				)}
			</div>

			<h2
				id={`${cardId}-title`}
				class:list={['project-card-title', { 'has-short-title': card.hasDisplayTitle }]}
			>
				<a href={url} title={card.fullTitle} aria-label={card.fullTitle}>
					{card.displayTitle}
				</a>
			</h2>
		</header>

		{card.summary && <p class='project-card-summary'>{card.summary}</p>}

		{card.capabilities.length > 0 && (
			<section class='project-card-section' aria-labelledby={`${cardId}-capabilities`}>
				<h3 id={`${cardId}-capabilities`}>Capabilities</h3>
				<ul class='project-capability-list'>
					{card.capabilities.map((capability) => <li>{capability}</li>)}
					{card.additionalCapabilityCount > 0 && (
						<li class='project-capability-more'>
							<a
								href={url}
								aria-label={`View all documented capabilities and tags for ${card.fullTitle}`}
							>
								View all capabilities
							</a>
						</li>
					)}
				</ul>
			</section>
		)}

		{card.evidence.length > 0 && (
			<section class='project-card-section project-evidence' aria-labelledby={`${cardId}-evidence`}>
				<h3 id={`${cardId}-evidence`}>Evidence</h3>
				<nav aria-label={`Evidence for ${card.fullTitle}`}>
					{card.evidence.map((item, index) => (
						<>
							{index > 0 && <span aria-hidden='true'>·</span>}
							<a
								href={item.url}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
								aria-label={`${item.label} evidence for ${card.fullTitle}${item.external ? ' (opens in a new tab)' : ''}`}
							>
								{item.label}
							</a>
						</>
					))}
					{card.additionalEvidenceCount > 0 && (
						<>
							<span aria-hidden='true'>·</span>
							<a
								class='project-evidence-more'
								href={url}
								aria-label={`View ${card.additionalEvidenceCount} more evidence items for ${card.fullTitle}`}
							>
								+{card.additionalEvidenceCount} more
							</a>
						</>
					)}
				</nav>
			</section>
		)}

		<footer class='project-card-actions'>
			<a
				class='project-primary-action btn-regular'
				href={url}
				aria-label={`View project: ${card.fullTitle}`}
			>
				View Project
			</a>
			{card.actions.length > 0 && (
				<div class='project-secondary-actions' aria-label={`More actions for ${card.fullTitle}`}>
					{card.actions.map((action) => (
						<a
							href={action.url}
							target={action.external ? '_blank' : undefined}
							rel={action.external ? 'noopener noreferrer' : undefined}
							aria-label={`${action.label} for ${card.fullTitle}${action.external ? ' (opens in a new tab)' : ''}`}
						>
							{action.label}
						</a>
					))}
				</div>
			)}
		</footer>
	</div>
</article>

<style>
	.project-case-card {
		display: flex;
		min-width: 0;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		box-shadow: 0 4px 14px rgb(15 23 42 / 0.07);
		backdrop-filter: none;
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.project-card-media {
		display: grid;
		position: relative;
		aspect-ratio: 16 / 9;
		place-items: center;
		overflow: hidden;
		background: color-mix(in srgb, var(--card-bg) 94%, var(--text-secondary));
		border-bottom: 1px solid var(--card-border);
	}

	.project-card-image {
		width: 100%;
		height: 100%;
	}

	.project-card-media :global(.project-card-image-element) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 180ms ease;
	}

	.project-card-media[data-image-fit='contain'] {
		background: color-mix(in srgb, var(--card-bg) 94%, var(--text-secondary));
	}

	.project-card-media[data-image-fit='contain']
		:global(.project-card-image-element) {
		object-fit: contain;
		padding: clamp(0.85rem, 3vw, 1.2rem);
	}

	.project-card-media-generated {
		background: color-mix(in srgb, var(--card-bg) 96%, var(--primary));
	}

	.project-card-body {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 0.58rem;
		padding: 0.95rem;
	}

	.project-card-header,
	.project-card-section {
		min-width: 0;
	}

	.project-card-kicker {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.44rem;
	}

	.project-card-meta {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.71rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.project-status-badge {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.38rem;
		max-width: 48%;
		padding: 0.24rem 0.46rem;
		border: 1px solid var(--theme-accent-border);
		border-radius: 999px;
		background: var(--theme-accent-soft);
		color: var(--theme-accent-text);
		font-size: 0.65rem;
		font-weight: 750;
		line-height: 1.2;
		text-align: right;
		text-transform: uppercase;
	}

	.project-status-badge::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		flex: 0 0 auto;
		border: 1px solid currentColor;
		border-radius: 50%;
		background: currentColor;
	}

	.project-card-title {
		min-height: calc(1.16em * 2);
		margin: 0;
		font-size: clamp(1.16rem, 1.8vw, 1.38rem);
		line-height: 1.16;
		letter-spacing: -0.032em;
	}

	.project-card-title a {
		display: -webkit-box;
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.project-card-title.has-short-title a {
		-webkit-line-clamp: 2;
	}

	.project-card-title a:hover {
		color: var(--primary);
	}

	.project-card-summary {
		display: -webkit-box;
		min-height: calc(1.42em * 2);
		overflow: hidden;
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.88rem;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-card-section h3 {
		margin: 0 0 0.2rem;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-capability-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.28rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-capability-list li {
		display: inline-flex;
		align-items: center;
		min-height: 1.58rem;
		padding: 0.18rem 0.44rem;
		border: 1px solid var(--theme-accent-border);
		border-radius: 999px;
		background: var(--theme-accent-soft);
		color: var(--theme-accent-text);
		font-size: 0.68rem;
		font-weight: 650;
		line-height: 1.25;
	}

	.project-capability-list .project-capability-more {
		min-height: 1.3rem;
		padding: 0;
		border: 0;
		background: transparent;
		font-size: 0.66rem;
		font-weight: 600;
	}

	.project-capability-more a {
		display: inline-flex;
		align-items: center;
		min-height: 1.3rem;
		padding: 0.1rem 0.2rem;
		color: var(--text-muted);
		text-decoration-line: underline;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		text-underline-offset: 0.18rem;
	}

	.project-evidence {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.26rem;
	}

	.project-evidence h3 {
		margin: 0;
	}

	.project-evidence nav {
		display: flex;
		min-width: 0;
		overflow: hidden;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.2rem 0.3rem;
		color: var(--text-muted);
		font-size: 0.75rem;
		line-height: 1.35;
		white-space: nowrap;
	}

	.project-evidence a {
		color: var(--text-secondary);
		font-weight: 650;
		text-underline-offset: 0.2rem;
	}

	.project-evidence a:hover {
		color: var(--primary);
	}

	.project-evidence .project-evidence-more {
		color: var(--text-muted);
		font-weight: 600;
		text-decoration: none;
	}

	.project-card-actions {
		display: grid;
		min-height: 2.9rem;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		margin-top: auto;
		gap: 0.65rem;
		padding-top: 0.58rem;
		border-top: 1px solid var(--card-border);
	}

	.project-primary-action {
		min-height: 2.35rem;
		flex: 0 0 auto;
		padding: 0.52rem 0.86rem;
		border-radius: calc(var(--radius-large) * 0.56);
		font-size: 0.84rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-secondary-actions {
		display: flex;
		min-width: 0;
		overflow: hidden;
		flex-wrap: nowrap;
		justify-content: flex-end;
		gap: 0.28rem 0.55rem;
	}

	.project-secondary-actions a {
		display: inline-flex;
		min-height: 2.15rem;
		align-items: center;
		padding: 0.38rem 0.05rem;
		color: var(--text-secondary);
		font-size: 0.75rem;
		font-weight: 700;
		text-decoration-line: underline;
		text-decoration-color: var(--theme-accent-border);
		text-underline-offset: 0.22rem;
	}

	.project-secondary-actions a:hover {
		color: var(--primary);
		text-decoration-color: currentColor;
	}

	.project-case-card:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.project-case-card :where(a):focus-visible {
		outline: 3px solid var(--primary);
		outline-offset: 3px;
		border-radius: 0.28rem;
	}

	:global(.dark) .project-case-card {
		box-shadow: 0 4px 14px rgb(0 0 0 / 0.18);
	}

	@media (hover: hover) and (pointer: fine) {
		.project-case-card:hover {
			transform: translateY(-2px);
			border-color: color-mix(in srgb, var(--primary) 48%, var(--card-border));
			box-shadow: 0 11px 26px rgb(15 23 42 / 0.12);
		}

		.project-card-media:hover :global(.project-card-image-element) {
			transform: scale(1.01);
		}
	}

	@media (max-width: 640px) {
		.project-card-body {
			gap: 0.64rem;
			padding: 0.9rem;
		}

		.project-card-kicker {
			align-items: flex-start;
		}

		.project-status-badge {
			max-width: 52%;
			font-size: 0.66rem;
		}

		.project-card-title {
			min-height: 0;
			font-size: 1.22rem;
		}

		.project-card-summary {
			min-height: 0;
			-webkit-line-clamp: 3;
		}

		.project-card-actions {
			min-height: 0;
			grid-template-columns: minmax(0, 1fr);
			align-items: stretch;
		}

		.project-primary-action {
			width: 100%;
		}

		.project-secondary-actions {
			width: 100%;
			justify-content: flex-start;
			gap: 0.35rem 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-case-card,
		.project-card-media :global(.project-card-image-element) {
			transition: none;
		}

		.project-case-card:hover,
		.project-card-media:hover :global(.project-card-image-element) {
			transform: none;
		}
	}
</style>
