---
import type { CollectionEntry } from "astro:content";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { normalizePostId } from "@utils/post-id";
import { buildProjectCardData } from "@utils/project-card-data";
import type { ProjectDiscoveryRecord } from "@utils/project-discovery-data";
import { toFilterKey } from "@utils/project-problem-matching";
import ImageWrapper from "./misc/ImageWrapper.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	url: string;
	pdf?: string;
	style?: string;
	discovery?: ProjectDiscoveryRecord;
}

const { entry, url, pdf = "", style = "", discovery } = Astro.props;
const className = Astro.props.class;
const card = discovery?.card || buildProjectCardData(entry, url, pdf);
const cardId = `project-card-${normalizePostId(entry.slug)}`;
const projectId = discovery?.id || toFilterKey(entry.slug);
const fullDate = formatDateToYYYYMMDD(entry.data.published);
const year = String(entry.data.published.getFullYear());
const category = entry.data.category?.trim() || "Uncategorized";
const summaryItems = card.maturitySummary.filter(
	(item) => item !== card.featuredEvidence?.label,
);
const assistantQuestions = [
	"Show similar projects",
	"Which technologies are used?",
	"Is this deployed?",
	"What problem does this solve?",
	"Which projects use similar capabilities?",
];
---

<article
	class:list={['project-case-card card-base', className]}
	style={style}
	aria-labelledby={`${cardId}-title`}
	data-project-card
	data-project-id={projectId}
	data-project-slug={entry.slug}
	data-project-title={card.displayTitle}
	data-project-search={discovery?.searchText || ""}
	data-project-industries={discovery?.industryIds.join(" ") || ""}
	data-project-capabilities={discovery?.capabilityIds.join(" ") || ""}
	data-project-technologies={discovery?.technologies.map((item) => item.id).join(" ") || ""}
	data-project-category={toFilterKey(category)}
	data-project-status={discovery?.status || entry.data.status?.type || ""}
	data-project-published={discovery?.publishedMs || entry.data.published.getTime()}
	data-project-featured={discovery?.featured ? "true" : "false"}
>
	<div class='project-card-media-shell'>
	<a
		class:list={[
			'project-card-media',
			{
				'project-card-media-generated': card.image.generated,
				'project-card-media-architecture': card.image.architecture,
			},
		]}
		data-image-fit={card.image.fit}
		href={url}
		aria-label={`View ${card.fullTitle}`}
	>
		{card.image.generated ? (
			<img
				src={card.image.src}
				alt={card.image.alt}
				loading='lazy'
				decoding='async'
				class='project-card-image-element'
			/>
		) : (
			<ImageWrapper
				src={card.image.src}
				basePath={card.image.basePath}
				alt={card.image.alt}
				fit={card.image.fit}
				overlay={false}
				loading='lazy'
				class='project-card-image'
				imgClass='project-card-image-element'
			/>
		)}
		{card.image.architecture && (
			<span class='project-card-architecture-label' aria-hidden='true'>
				Architecture Preview
			</span>
		)}
	</a>
	<nav class='project-thumbnail-actions' aria-label={`Quick actions for ${card.fullTitle}`}>
		<a href={url}>View Project</a>
		{card.quickActions.map((action) => (
			<a
				href={action.url}
				target={action.external ? '_blank' : undefined}
				rel={action.external ? 'noopener noreferrer' : undefined}
			>{action.label}</a>
		))}
	</nav>
	</div>

	<div class='project-card-body'>
		<header class='project-card-header'>
			<div class='project-card-kicker'>
				<p class='project-card-meta'>
					<span class='sr-only'>Project type: </span>
					<span>{category}</span>
					<span aria-hidden='true'>·</span>
					<time datetime={entry.data.published.toISOString()} title={fullDate}>
						<span class='sr-only'>Published in </span>{year}
					</time>
				</p>
				<div class='project-card-kicker-actions'>
					{discovery?.primaryIndustry && (
						<span class='project-industry-badge' aria-label={`Primary industry: ${discovery.primaryIndustry.label}`}>
							{discovery.primaryIndustry.label}
						</span>
					)}
					{discovery && (
						<label class='project-compare-control'>
							<input type='checkbox' value={projectId} data-project-compare aria-label={`Compare ${card.fullTitle}`} />
							<span>Compare</span>
						</label>
					)}
				</div>
			</div>

			<h2
				id={`${cardId}-title`}
				class:list={['project-card-title', { 'has-short-title': card.hasDisplayTitle }]}
			>
				<a href={url} title={card.fullTitle} aria-label={card.fullTitle}>
					{card.displayTitle}
				</a>
			</h2>
		</header>

		{card.summary && <p class='project-card-summary'>{card.summary}</p>}

		{(summaryItems.length > 0 || card.featuredEvidence) && (
			<div class='project-maturity-line' aria-label={`Project maturity and evidence: ${card.maturitySummary.join(", ")}`}>
				{summaryItems.length > 0 && <span>{summaryItems.join(" · ")}</span>}
				{card.featuredEvidence && (
					<a
						class='project-featured-evidence'
						href={card.featuredEvidence.url}
						target={card.featuredEvidence.external ? '_blank' : undefined}
						rel={card.featuredEvidence.external ? 'noopener noreferrer' : undefined}
						aria-label={`Featured evidence: ${card.featuredEvidence.label} for ${card.fullTitle}`}
					>
						{card.featuredEvidence.label}
					</a>
				)}
			</div>
		)}

		{card.capabilities.length > 0 && (
			<section class='project-card-section' aria-labelledby={`${cardId}-capabilities`}>
				<h3 id={`${cardId}-capabilities`}>Capabilities</h3>
				<ul class='project-capability-list'>
					{card.capabilities.map((capability) => <li>{capability}</li>)}
					{card.additionalCapabilityCount > 0 && (
						<li class='project-capability-more'>
							<a
								href={url}
								aria-label={`View all capabilities for ${card.fullTitle}`}
							>
								More capabilities
							</a>
						</li>
					)}
				</ul>
			</section>
		)}

		<div class='project-mobile-discovery-actions'>
			{card.quickActions.length > 0 && (
				<nav class='project-mobile-quick-links' aria-label={`Quick actions for ${card.fullTitle}`}>
					{card.quickActions.map((action) => (
						<a href={action.url} target={action.external ? '_blank' : undefined} rel={action.external ? 'noopener noreferrer' : undefined}>{action.label}</a>
					))}
				</nav>
			)}
			{card.whyItMatters && (
				<details>
					<summary>Why it matters</summary>
					<p>{card.whyItMatters}</p>
				</details>
			)}
			{discovery && discovery.relatedProjects.length > 0 && (
				<details>
					<summary>Related</summary>
					<ul>{discovery.relatedProjects.map((related) => <li><a href={related.url}>{related.title}</a></li>)}</ul>
				</details>
			)}
			{discovery && (
				<details class='project-ask-menu'>
					<summary>Ask</summary>
					<div>{assistantQuestions.map((question) => (
						<button type='button' data-project-assistant-question={question} data-project-assistant-slug={entry.slug}>{question}</button>
					))}</div>
				</details>
			)}
		</div>

		<footer class='project-card-actions'>
			<a
				class='project-primary-action btn-regular'
				href={url}
				aria-label={`View project: ${card.fullTitle}`}
			>
				View Project
			</a>
			{card.actions.length > 0 && (
				<nav class='project-secondary-actions' aria-label={`More actions for ${card.fullTitle}`}>
					{card.actions.map((action, index) => (
						<>
							{index > 0 && (
								<span class='project-secondary-separator' aria-hidden='true'>·</span>
							)}
							<a
								href={action.url}
								target={action.external ? '_blank' : undefined}
								rel={action.external ? 'noopener noreferrer' : undefined}
								aria-label={`${action.label} for ${card.fullTitle}${action.external ? ' (opens in a new tab)' : ''}`}
							>
								{action.label}
							</a>
						</>
					))}
				</nav>
			)}
		</footer>
	</div>

	{discovery && (
		<section class='project-card-discovery-panel' aria-label={`More discovery options for ${card.fullTitle}`}>
			{card.whyItMatters && (
				<div class='project-card-why'>
					<h3>Why this project matters</h3>
					<p>{card.whyItMatters}</p>
				</div>
			)}
			{discovery.relatedProjects.length > 0 && (
				<nav class='project-card-related' aria-label={`Related projects to ${card.fullTitle}`}>
					<h3>Related projects</h3>
					{discovery.relatedProjects.map((related) => <a href={related.url}>{related.title}</a>)}
				</nav>
			)}
			<details class='project-ask-menu'>
				<summary>Ask about this project</summary>
				<div>{assistantQuestions.map((question) => (
					<button type='button' data-project-assistant-question={question} data-project-assistant-slug={entry.slug}>{question}</button>
				))}</div>
			</details>
		</section>
	)}
</article>

<style>
	.project-case-card {
		display: flex;
		position: relative;
		min-width: 0;
		height: 100%;
		flex-direction: column;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--card-border);
		box-shadow: var(--card-shadow);
		backdrop-filter: none;
		--project-accent: var(--primary);
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.project-card-media-shell {
		position: relative;
		width: 88%;
		aspect-ratio: 16 / 9;
		margin: 0.5rem auto 0;
		padding: 0.28rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 20%, var(--card-border));
		border-radius: calc(var(--radius-large) * 0.78);
		background: color-mix(in srgb, var(--card-media-bg) 88%, var(--project-accent));
	}

	.project-card-media {
		display: grid;
		position: relative;
		width: 100%;
		height: 100%;
		aspect-ratio: 16 / 9;
		place-items: center;
		overflow: hidden;
		margin: 0;
		background: var(--card-media-bg);
		border: 1px solid color-mix(in srgb, var(--project-accent) 28%, var(--card-border));
		border-radius: calc(var(--radius-large) * 0.68);
	}

	.project-thumbnail-actions {
		display: flex;
		position: absolute;
		z-index: 4;
		right: 0.55rem;
		bottom: 0.55rem;
		left: 0.55rem;
		visibility: hidden;
		align-items: center;
		justify-content: center;
		gap: 0.38rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 140ms ease;
	}

	.project-thumbnail-actions a {
		display: inline-flex;
		min-height: 2rem;
		align-items: center;
		padding: 0.34rem 0.55rem;
		border: 1px solid color-mix(in srgb, var(--card-border) 72%, var(--text-primary));
		border-radius: 0.45rem;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		color: var(--text-primary);
		font-size: 0.68rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-card-media-shell::after {
		position: absolute;
		inset: auto 0 0;
		height: 38%;
		background: rgb(15 23 42 / 0.14);
		content: '';
		opacity: 0;
		pointer-events: none;
		transition: opacity 140ms ease;
	}

	.project-card-image {
		width: 100%;
		height: 100%;
	}

	.project-card-media :global(.project-card-image-element) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 180ms ease;
	}

	.project-card-media[data-image-fit='contain'] {
		background: color-mix(in srgb, var(--card-bg) 92%, var(--primary));
	}

	.project-card-media[data-image-fit='contain']
		:global(.project-card-image-element) {
		box-sizing: border-box;
		object-fit: contain;
		padding: clamp(1rem, 2.2vw, 1.375rem);
	}

	.project-card-media-generated {
		background: color-mix(in srgb, var(--card-bg) 96%, var(--primary));
	}

	.project-card-architecture-label {
		display: inline-flex;
		position: absolute;
		right: 0.45rem;
		bottom: 0.4rem;
		align-items: center;
		padding: 0.2rem 0.42rem;
		border: 1px solid color-mix(in srgb, var(--card-border) 82%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--card-bg) 94%, transparent);
		color: var(--text-secondary);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.025em;
		line-height: 1.2;
		pointer-events: none;
	}

	.project-card-body {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.84rem 1rem 1rem;
		border-top: 2px solid color-mix(in srgb, var(--project-accent) 58%, transparent);
	}

	.project-card-header,
	.project-card-section {
		min-width: 0;
	}

	.project-card-kicker {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.38rem;
	}

	.project-card-kicker-actions {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.4rem;
	}

	.project-industry-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.22rem 0.44rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 999px;
		background: color-mix(in srgb, var(--project-accent) 12%, var(--card-bg));
		color: color-mix(in srgb, var(--project-accent) 82%, var(--text-primary));
		font-size: 0.62rem;
		font-weight: 750;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.project-compare-control {
		display: inline-flex;
		min-height: 1.7rem;
		align-items: center;
		gap: 0.28rem;
		color: var(--text-secondary);
		font-size: 0.66rem;
		font-weight: 700;
		cursor: pointer;
	}

	.project-compare-control input {
		width: 0.9rem;
		height: 0.9rem;
		accent-color: var(--primary);
	}

	.project-card-meta {
		display: flex;
		min-width: 0;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.71rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.045em;
		text-transform: uppercase;
	}

	.project-status-badge {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.38rem;
		max-width: 48%;
		padding: 0.24rem 0.46rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 999px;
		background: color-mix(in srgb, var(--project-accent) 12%, var(--card-bg));
		color: color-mix(in srgb, var(--project-accent) 82%, var(--text-primary));
		font-size: 0.65rem;
		font-weight: 750;
		line-height: 1.2;
		text-align: right;
		text-transform: uppercase;
	}

	.project-status-badge::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		flex: 0 0 auto;
		border: 1px solid currentColor;
		border-radius: 50%;
		background: currentColor;
	}

	.project-card-title {
		min-height: calc(1.16em * 2);
		margin: 0;
		font-size: clamp(1.16rem, 1.8vw, 1.38rem);
		line-height: 1.16;
		letter-spacing: -0.032em;
	}

	.project-card-title a {
		display: -webkit-box;
		overflow: hidden;
		color: var(--text-primary);
		text-decoration: none;
		overflow-wrap: anywhere;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}

	.project-card-title.has-short-title a {
		-webkit-line-clamp: 2;
	}

	.project-card-title a:hover {
		color: var(--primary);
	}

	.project-card-summary {
		display: -webkit-box;
		min-height: calc(1.42em * 2);
		overflow: hidden;
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.88rem;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.project-maturity-line {
		display: flex;
		min-height: 1.6rem;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-muted);
		font-size: 0.72rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.project-featured-evidence {
		display: inline-flex;
		align-items: center;
		padding: 0.18rem 0.42rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 42%, var(--card-border));
		border-radius: 999px;
		color: color-mix(in srgb, var(--project-accent) 82%, var(--text-primary));
		font-size: 0.67rem;
		font-weight: 750;
		text-decoration: none;
	}

	.project-mobile-discovery-actions {
		display: none;
	}

	.project-card-discovery-panel {
		display: grid;
		position: absolute;
		z-index: 8;
		right: 0.7rem;
		bottom: 0.7rem;
		left: 0.7rem;
		visibility: hidden;
		max-height: 58%;
		overflow-y: auto;
		gap: 0.55rem;
		padding: 0.72rem;
		border: 1px solid var(--card-border);
		border-radius: calc(var(--radius-large) * 0.7);
		background: var(--card-bg);
		box-shadow: 0 4px 14px rgb(15 23 42 / 0.12);
		opacity: 0;
		pointer-events: none;
		transform: translateY(0.3rem);
		transition: opacity 140ms ease, transform 140ms ease;
	}

	.project-card-discovery-panel h3 {
		margin: 0 0 0.2rem;
		color: var(--text-muted);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.055em;
		text-transform: uppercase;
	}

	.project-card-discovery-panel p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.77rem;
		line-height: 1.4;
	}

	.project-card-related {
		display: flex;
		flex-wrap: wrap;
		gap: 0.28rem 0.65rem;
	}

	.project-card-related h3 {
		flex-basis: 100%;
	}

	.project-card-related a {
		font-size: 0.74rem;
		font-weight: 700;
		text-underline-offset: 0.18rem;
	}

	.project-ask-menu summary {
		width: max-content;
		color: var(--primary);
		font-size: 0.73rem;
		font-weight: 750;
		cursor: pointer;
	}

	.project-ask-menu > div {
		display: grid;
		gap: 0.22rem;
		margin-top: 0.35rem;
	}

	.project-ask-menu button {
		padding: 0.28rem 0.4rem;
		border: 0;
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--card-bg) 88%, var(--primary));
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.7rem;
		text-align: left;
		cursor: pointer;
	}

	.project-card-section h3 {
		margin: 0 0 0.2rem;
		color: var(--text-muted);
		font-family: var(--font-body);
		font-size: 0.72rem;
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-capability-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.28rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-capability-list li {
		display: inline-flex;
		align-items: center;
		min-height: 1.58rem;
		padding: 0.18rem 0.44rem;
		border: 1px solid color-mix(in srgb, var(--project-accent) 35%, var(--card-border));
		border-radius: 999px;
		background: color-mix(in srgb, var(--project-accent) 10%, var(--card-bg));
		color: color-mix(in srgb, var(--project-accent) 82%, var(--text-primary));
		font-size: 0.68rem;
		font-weight: 650;
		line-height: 1.25;
	}

	.project-capability-list .project-capability-more {
		min-height: 1.3rem;
		padding: 0;
		border: 0;
		background: transparent;
		font-size: 0.66rem;
		font-weight: 600;
	}

	.project-capability-more a {
		display: inline-flex;
		align-items: center;
		min-height: 1.3rem;
		padding: 0.1rem 0.2rem;
		color: var(--text-secondary);
		font-weight: 650;
		text-decoration-line: underline;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		text-underline-offset: 0.18rem;
	}

	.project-capability-more a:hover {
		color: var(--primary);
		text-decoration-color: currentColor;
	}

	.project-evidence {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		gap: 0.26rem;
	}

	.project-evidence h3 {
		margin: 0;
	}

	.project-evidence nav {
		display: flex;
		min-width: 0;
		max-width: 100%;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.2rem 0.3rem;
		color: var(--text-muted);
		font-size: 0.75rem;
		line-height: 1.35;
		white-space: nowrap;
	}

	.project-evidence a {
		color: var(--text-secondary);
		font-weight: 650;
		text-underline-offset: 0.2rem;
	}

	.project-evidence a:hover {
