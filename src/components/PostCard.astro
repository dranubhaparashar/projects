---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { normalizePostId } from "../utils/post-id";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	viewsPath: string;
	postId: string;
	pdf?: string;
}

const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	viewsPath,
	postId,
	pdf = "",
} = Astro.props;

const className = Astro.props.class;
const hasCover = image !== undefined && image !== null && image !== "";
const normalizedPostId = normalizePostId(entry.slug);
const { remarkPluginFrontmatter } = await entry.render();
const coverBasePath = path.join("content/posts/", getDir(entry.id));

const isLocalCover =
	hasCover &&
	!(
		image.startsWith("/") ||
		image.startsWith("http") ||
		image.startsWith("https") ||
		image.startsWith("data:")
	);

let coverWidth = 16;
let coverHeight = 9;

if (isLocalCover) {
	const files = import.meta.glob<ImageMetadata>("../**", {
		import: "default",
	});
	const normalizedPath = path
		.normalize(path.join("../", coverBasePath, image))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];

	if (file) {
		const cover = await file();
		coverWidth = cover.width;
		coverHeight = cover.height;
	}
}

const isPortraitCover = coverHeight > coverWidth;
const coverAspectRatio = `${coverWidth} / ${coverHeight}`;
const coverAspect = coverWidth / coverHeight;

const defaultCoverMaxWidth = isPortraitCover ? 220 : 320;
const defaultCoverMaxHeight = isPortraitCover ? 260 : 220;
const defaultCoverDisplayWidth = Math.round(
	Math.min(defaultCoverMaxWidth, defaultCoverMaxHeight * coverAspect),
);

const cardKey = `${title} ${entry.slug}`.toLowerCase();

const isPoleCard = cardKey.includes("pole") && cardKey.includes("validation");

const isVRPCard =
	cardKey.includes("vrp") ||
	cardKey.includes("vehicle routing") ||
	cardKey.includes("execution-aware");

const isSpecialRightImageCard =
	isPoleCard ||
	(cardKey.includes("predictive") && cardKey.includes("maintenance")) ||
	(cardKey.includes("generator") && cardKey.includes("reliability")) ||
	isVRPCard;

const shouldShowLeftPartOfImage =
	(cardKey.includes("predictive") && cardKey.includes("maintenance")) ||
	(cardKey.includes("generator") && cardKey.includes("reliability"));

function cleanMarkdownPreview(text = "", maxChars = 245) {
	return text
		.replace(/^---[\s\S]*?---/m, "")
		.replace(/```[\s\S]*?```/g, "")
		.replace(/::[\w-]+(?:\{[^}]*\})?/g, " ")
		.replace(/!\[[^\]]*\]\([^)]+\)/g, "")
		.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
		.replace(/^#+\s+/gm, "")
		.replace(/[*_`>#|-]/g, " ")
		.replace(/\s+/g, " ")
		.trim()
		.slice(0, maxChars)
		.replace(/\s+\S*$/, "");
}

const specialPreviewText = cleanMarkdownPreview(
	description || remarkPluginFrontmatter.excerpt || "",
	isPoleCard ? 220 : 245,
)
	.replace(
		/—\s*built in Streamlit with Scikit[- ]learn, Plotly, and multi[- ]platform deployment on.*$/i,
		"",
	)
	.replace(
		/—\s*packaged into a Streamlit benchmark studio with live re[- ]optimization, locked prefix.*$/i,
		"",
	)
	.trim();
---

{
	isSpecialRightImageCard ? (
		<>
			<div
				class:list={[
					"card-base post-card-special-right grid w-full rounded-[var(--radius-large)] overflow-hidden relative",
					isPoleCard ? "post-card-pole-compact" : "",
					hasCover
						? isPoleCard
							? "grid-cols-1 md:grid-cols-[minmax(0,1fr)_190px] items-stretch"
							: "grid-cols-1 md:grid-cols-[minmax(0,1fr)_260px] items-stretch"
						: "grid-cols-1",
					className,
				]}
				style={style}
			>
				<div
					class:list={[
						"post-card-special-content min-w-0 relative",
						isPoleCard
							? "px-6 md:px-7 pt-4 md:pt-4 pb-4"
							: "px-6 md:px-9 pt-6 md:pt-7 pb-6",
					]}
				>
					<a
						href={url}
						class:list={[
							"post-card-title project-title transition group w-full block font-bold text-90 break-words hover:text-[var(--primary)] dark:hover:text-[var(--primary)] active:text-[var(--title-active)] dark:active:text-[var(--title-active)] before:w-1 before:rounded-md before:bg-[var(--primary)] before:absolute before:left-[18px] before:hidden md:before:block",
							isPoleCard
								? "mb-2 text-2xl md:text-[1.7rem] before:h-4 before:top-[27px]"
								: "mb-3 text-3xl before:h-5 before:top-[35px]",
						]}
					>
						{title}

						<Icon
							class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute"
							name="material-symbols:chevron-right-rounded"
						></Icon>

						<Icon
							class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
							name="material-symbols:chevron-right-rounded"
						></Icon>
					</a>

					<PostMetadata
						published={published}
						updated={updated}
						tags={tags}
						category={category}
						viewsPath={viewsPath}
						postId={normalizedPostId || postId}
						postTitle={title}
						pdf={pdf}
						incrementViews={false}
						showLike={false}
						showCommentsCount={false}
						hideTagsForMobile={false}
						hideUpdateDate={true}
						limitTagsToTwoLines={true}
						class={isPoleCard ? "mb-3 post-card-meta-flow pole-meta-tight" : "mb-4 post-card-meta-flow"}
					></PostMetadata>

					<div
						class:list={[
							"transition text-75 mb-0 md:pr-0 leading-relaxed post-card-description-flow special-preview-text",
							isPoleCard ? "pole-preview-tight" : "",
						]}
					>
						{specialPreviewText}
					</div>
				</div>

				{hasCover && (
					<a
						href={url}
						aria-label={title}
						class:list={[
							"post-card-special-cover group relative hidden md:flex items-center justify-center overflow-hidden bg-white active:scale-95 md:col-start-2 md:row-start-1",
							isPoleCard
								? "ml-4 my-4 mr-0 h-[calc(100%-2rem)] w-[calc(100%-1rem)] self-center justify-self-end rounded-l-2xl rounded-r-none"
								: "h-full min-h-full w-full",
						]}
					>
						<div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/20 group-active:bg-black/30 transition"></div>

						<div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl drop-shadow"
							></Icon>
						</div>

						<ImageWrapper
							src={image}
							basePath={coverBasePath}
							alt={title}
							class="post-card-cover post-card-image-frame special-image-frame w-full h-full bg-white"
							imgClass={`post-card-image special-card-image ${
								shouldShowLeftPartOfImage ? "special-card-image-left" : ""
							} ${isVRPCard ? "special-card-image-vrp-map" : ""}`}
							fit="cover"
							overlay={false}
						>
						</ImageWrapper>
					</a>
				)}

				{hasCover && (
					<a
						href={url}
						aria-label={title}
						class="post-card-special-cover group relative mx-auto mb-5 flex md:hidden items-center justify-center overflow-hidden rounded-2xl bg-white active:scale-95"
						style="width: min(220px, calc(100% - 2rem)); aspect-ratio: 220 / 260;"
					>
						<div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/20 group-active:bg-black/30 transition"></div>

						<div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl drop-shadow"
							></Icon>
						</div>

						<ImageWrapper
							src={image}
							basePath={coverBasePath}
							alt={title}
							class="post-card-cover post-card-image-frame special-image-frame w-full h-full bg-white"
							imgClass={`post-card-image special-card-image ${
								shouldShowLeftPartOfImage ? "special-card-image-left" : ""
							} ${isVRPCard ? "special-card-image-vrp-map" : ""}`}
							fit="cover"
							overlay={false}
						>
						</ImageWrapper>
					</a>
				)}
			</div>

			<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>
		</>
	) : (
		<>
			<div
				class:list={[
					"card-base grid w-full rounded-[var(--radius-large)] overflow-hidden relative",
					hasCover
						? "grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(220px,320px)_44px] md:gap-5 lg:gap-6 items-stretch"
						: "grid-cols-1 md:grid-cols-[minmax(0,1fr)_44px] md:gap-5 items-stretch",
					className,
				]}
				style={style}
			>
				<div
					class:list={[
						"min-w-0 overflow-visible px-6 md:pl-9 pt-6 md:pt-7 pb-6 relative",
						hasCover ? "md:pr-0 md:col-start-1" : "md:pr-0 md:col-start-1",
					]}
				>
					<a
						href={url}
						class="post-card-title project-title transition group w-full block font-bold mb-3 text-3xl text-90 break-words
							hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
							active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
							before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
							before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
					>
						{title}

						<Icon
							class="inline text-[2rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute"
							name="material-symbols:chevron-right-rounded"
						></Icon>

						<Icon
							class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
							name="material-symbols:chevron-right-rounded"
						></Icon>
					</a>

					<PostMetadata
						published={published}
						updated={updated}
						tags={tags}
						category={category}
						viewsPath={viewsPath}
						postId={normalizedPostId || postId}
						postTitle={title}
						pdf={pdf}
						incrementViews={false}
						showLike={false}
						showCommentsCount={false}
						hideTagsForMobile={false}
						hideUpdateDate={true}
						limitTagsToTwoLines={true}
						class="mb-4"
					></PostMetadata>

					<div class="transition text-75 mb-3.5 md:pr-0 leading-relaxed line-clamp-3">
						{description || remarkPluginFrontmatter.excerpt}
					</div>
				</div>

				{hasCover && (
					<a
						href={url}
						aria-label={title}
						class:list={[
							"group",
							"relative mx-auto mb-4 flex items-center justify-center self-center overflow-hidden rounded-xl bg-white active:scale-95 md:mx-0 md:my-4 md:justify-self-center md:self-start md:col-start-2",
							isPortraitCover
								? "w-[min(14rem,calc(100%-2rem))] md:w-[var(--cover-width)]"
								: "w-[calc(100%-2rem)] md:w-[var(--cover-width)]",
						]}
						style={`aspect-ratio: ${coverAspectRatio}; --cover-width: ${defaultCoverDisplayWidth}px;`}
					>
						<div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/20 group-active:bg-black/30 transition"></div>

						<div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
							<Icon
								name="material-symbols:chevron-right-rounded"
								class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl drop-shadow"
							></Icon>
						</div>

						<ImageWrapper
							src={image}
							basePath={coverBasePath}
							alt={title}
							class="post-card-cover post-card-image-frame w-full h-full bg-white"
							imgClass="post-card-image"
							fit="contain"
							overlay={false}
						>
						</ImageWrapper>
					</a>
				)}

				<a
					href={url}
					aria-label={title}
					class:list={[
						"!hidden md:!flex btn-regular my-3 md:m-0 rounded-xl bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95 self-stretch md:justify-self-stretch md:h-full md:w-11",
						hasCover ? "md:col-start-3" : "md:col-start-2",
					]}
				>
					<Icon
						name="material-symbols:chevron-right-rounded"
						class="transition text-[var(--primary)] text-4xl mx-auto"
					></Icon>
				</a>
			</div>

			<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>
		</>
	)
}

<style>
	:global(.post-card-special-right) {
		position: relative;
		min-height: 310px;
	}

	:global(.post-card-pole-compact) {
		min-height: 215px;
	}

	:global(.post-card-special-content) {
		min-width: 0;
	}

	:global(.post-card-special-cover) {
		box-shadow: none;
	}

	:global(.post-card-pole-compact .post-card-special-cover) {
		box-shadow: 0 10px 24px rgba(2, 6, 23, 0.12);
	}

	:global(.post-card-pole-compact .post-card-special-content) {
		padding-top: 1rem;
		padding-bottom: 1rem;
	}

	:global(.post-card-image-frame) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background: white;
	}

	:global(.post-card-image-frame picture) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}

	:global(.post-card-image-frame img),
	:global(.post-card-image) {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 100%;
		object-position: center;
		background: white;
		border-radius: 0;
	}

	:global(.post-card-pole-compact .post-card-image),
	:global(.post-card-pole-compact .post-card-image-frame img) {
		border-radius: 1rem 0 0 1rem;
	}

	:global(.special-image-frame img),
	:global(.special-card-image) {
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		object-fit: cover;
		object-position: center;
	}

	:global(.post-card-pole-compact .special-card-image),
	:global(.post-card-pole-compact .special-image-frame img) {
		width: 100%;
		height: 100%;
		object-fit: cover !important;
		object-position: center center !important;
		border-radius: 1rem 0 0 1rem;
	}

	:global(.post-card-pole-compact .post-card-special-cover),
	:global(.post-card-pole-compact .special-image-frame),
	:global(.post-card-pole-compact .post-card-image-frame) {
		height: 100% !important;
		min-height: 100% !important;
	}

	:global(.special-card-image-left) {
		object-position: left center !important;
	}

	:global(.special-card-image-vrp-map) {
		object-fit: cover !important;
		object-position: 58% 16% !important;
		transform: scale(2.05);
		transform-origin: 58% 16%;
	}

	:global(.post-card-meta-flow) {
		max-width: none;
	}

	:global(.post-card-description-flow) {
		max-width: none;
	}

	:global(.special-preview-text) {
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-height: 6.5rem;
	}

	:global(.post-card-pole-compact .special-preview-text) {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		max-height: 3.4rem;
	}

	:global(.pole-meta-tight .tag-two-line-fade) {
		max-height: 3.6rem !important;
		overflow: hidden !important;
		-webkit-mask-image: linear-gradient(
			to bottom,
			black 0%,
			black calc(100% - 0.25rem),
			transparent 100%
		) !important;
		mask-image: linear-gradient(
			to bottom,
			black 0%,
			black calc(100% - 0.25rem),
			transparent 100%
		) !important;
	}

	:global(.pole-meta-tight .tag-two-line-fade a) {
		font-size: 0.78rem;
		line-height: 1.05rem;
		padding: 0.22rem 0.55rem;
	}

	@media (max-width: 767px) {
		:global(.post-card-special-right),
		:global(.post-card-pole-compact) {
			min-height: auto;
		}

		:global(.post-card-special-cover) {
			float: none;
			margin-left: auto;
			margin-right: auto;
			border-radius: 1rem;
			box-shadow: 0 18px 42px rgba(2, 6, 23, 0.16);
		}

		:global(.special-card-image-vrp-map) {
			object-position: 58% 16% !important;
			transform: scale(1.9);
			transform-origin: 58% 16%;
		}

		:global(.special-preview-text) {
			-webkit-line-clamp: 3;
			max-height: 5rem;
		}
	}
</style>
