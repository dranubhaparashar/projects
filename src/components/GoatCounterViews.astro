---
interface Props {
	path: string;
	class?: string;
}

const { path, class: className = "" } = Astro.props;
const elId = `gcviews-${Math.random().toString(36).slice(2)}`;
---

<span id={elId} class={className}>0 views</span>

<script is:inline define:vars={{ elId, path }}>
  (function () {
    async function loadViews() {
      const el = document.getElementById(elId);
      if (!el) return;

      try {
        const endpoint =
          "https://anubhaparashar.goatcounter.com/counter/" +
          encodeURIComponent(path) +
          ".json";

        const res = await fetch(endpoint);
        if (!res.ok) return;

        const data = await res.json();
        el.textContent = `${data.count} views`;
      } catch (e) {
        // leave fallback text
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", loadViews, { once: true });
    } else {
      loadViews();
    }
  })();
</script>