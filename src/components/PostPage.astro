---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import { normalizePostId } from "@utils/post-id";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
---

<div class="project-listing-surface transition flex flex-col rounded-[var(--radius-large)] py-3 md:p-4 md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">) => (
        <PostCard
            entry={entry}
            title={entry.data.title}
            tags={entry.data.tags}
            category={entry.data.category}
            pdf={entry.data.pdf}
            published={entry.data.published}
            updated={entry.data.updated}
            url={getPostUrlBySlug(entry.slug)}
            viewsPath={getPostUrlBySlug(entry.slug)}
            postId={normalizePostId(entry.slug)}
            image={entry.data.image}
            description={entry.data.description}
            draft={entry.data.draft}
            class:list="onload-animation"
            style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>

<style>
	.project-listing-surface {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		background:
			radial-gradient(circle at 18% 8%, rgba(56, 189, 248, 0.18), transparent 28rem),
			radial-gradient(circle at 86% 18%, rgba(124, 58, 237, 0.16), transparent 24rem),
			linear-gradient(135deg, #07111f 0%, #0f172a 48%, #07111f 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
	}

	.project-listing-surface::before,
	.project-listing-surface::after {
		content: "";
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: -1;
	}

	.project-listing-surface::before {
		background-image:
			linear-gradient(rgba(56, 189, 248, 0.11) 1px, transparent 1px),
			linear-gradient(90deg, rgba(56, 189, 248, 0.1) 1px, transparent 1px),
			linear-gradient(120deg, transparent 0 31px, rgba(255, 255, 255, 0.045) 32px, transparent 33px);
		background-size: 42px 42px, 42px 42px, 84px 84px;
		mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.28));
		animation: project-grid-drift 18s linear infinite;
	}

	.project-listing-surface::after {
		background:
			radial-gradient(circle at 28% 78%, rgba(37, 99, 235, 0.2), transparent 17rem),
			radial-gradient(circle at 72% 68%, rgba(56, 189, 248, 0.16), transparent 15rem),
			linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
		filter: blur(2px);
		animation: project-glow-shift 14s ease-in-out infinite alternate;
	}

	.project-listing-surface :global(.card-base) {
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(255, 255, 255, 0.58);
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.26);
		backdrop-filter: blur(16px);
	}

	:global(.dark) .project-listing-surface :global(.card-base) {
		background: rgba(15, 23, 42, 0.88);
		border-color: rgba(148, 163, 184, 0.18);
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.36);
	}

	@keyframes project-grid-drift {
		from {
			background-position: 0 0, 0 0, 0 0;
		}
		to {
			background-position: 42px 42px, 42px 42px, 84px 84px;
		}
	}

	@keyframes project-glow-shift {
		from {
			transform: translate3d(-1rem, 0.5rem, 0) scale(1);
			opacity: 0.82;
		}
		to {
			transform: translate3d(1.25rem, -0.75rem, 0) scale(1.04);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-listing-surface::before,
		.project-listing-surface::after {
			animation: none;
		}
	}
</style>
