---
import type { CollectionEntry } from "astro:content";
import { getPostPdfPath } from "@utils/pdf-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;
let delay = 0;
const interval = 50;

function getPdfUrl(entry: CollectionEntry<"posts">) {
	const pdfPath = getPostPdfPath(entry);
	return /^https?:\/\//i.test(pdfPath) ? pdfPath : url(pdfPath);
}
---

<div class='project-listing-surface'>
	{page.data.map((entry: CollectionEntry<'posts'>) => (
		<PostCard
			entry={entry}
			url={getPostUrlBySlug(entry.slug)}
			pdf={getPdfUrl(entry)}
			class='onload-animation'
			style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
		/>
	))}
</div>

<style>
	.project-listing-surface {
		display: grid;
		min-width: 0;
		grid-template-columns: minmax(0, 1fr);
		align-items: stretch;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	@media (min-width: 700px) {
		.project-listing-surface {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
