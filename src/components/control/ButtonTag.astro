---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="theme-pill inline-flex w-auto min-w-0 max-w-full items-center whitespace-nowrap rounded-full border px-[0.34rem] py-[0.12rem] text-[0.72rem] font-medium leading-[1.05] transition">
    {dot && <div class="h-1 w-1 bg-current transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
