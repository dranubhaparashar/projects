---
import { normalizePostId } from "@utils/post-id";
import { Icon } from "astro-icon/components";
import { url } from "../utils/url-utils";

interface Props {
	postId: string;
	path: string;
	title: string;
	pdf?: string;
	incrementViews?: boolean;
	showLike?: boolean;
	showCommentsCount?: boolean;
	class?: string;
}

const {
	postId,
	path,
	title,
	pdf = "",
	incrementViews = false,
	showLike = false,
	showCommentsCount = false,
	class: className = "",
} = Astro.props;
---

<span
	class:list={["firebase-post-stats inline-flex flex-nowrap items-center gap-[0.65rem] shrink-0 whitespace-nowrap", className]}
	data-firebase-post-stats
	data-post-id={postId}
	data-normalized-post-id={normalizePostId(path || postId || "")}
	data-path={path}
	data-title={title}
	data-increment-views={String(incrementViews)}
	data-show-like={String(showLike)}
	data-show-comments-count={String(showCommentsCount)}
>
	<span class="inline-flex items-center shrink-0 whitespace-nowrap">
		<span class="meta-icon">
			<Icon name="material-symbols:visibility-outline-rounded" class="text-xl"></Icon>
		</span>
		<span data-stat-views class="text-50 text-sm font-medium">0 views</span>
	</span>

	{pdf && (
		<a
			href={url(pdf)}
			target="_blank"
			rel="noopener noreferrer"
			class="theme-pill inline-flex shrink-0 items-center gap-1 rounded-full border px-2 py-0.5 text-[0.7rem] font-semibold leading-none transition"
			aria-label="Open project PDF"
		>
			<Icon name="material-symbols:download-rounded" class="text-[0.95rem]"></Icon>
			<span>PDF</span>
		</a>
	)}

	{showLike && (
		<button
			type="button"
			data-like-button
			data-reaction-key="heart"
			class="inline-flex shrink-0 items-center whitespace-nowrap transition hover:text-[var(--primary)] disabled:cursor-default disabled:hover:text-inherit"
			aria-label="Like this post"
		>
			<span class="meta-icon">
				<Icon name="material-symbols:favorite-outline-rounded" class="text-xl"></Icon>
			</span>
			<span data-stat-likes class="text-50 text-sm font-medium">0 likes</span>
		</button>
	)}

	{showCommentsCount && (
		<span class="inline-flex shrink-0 items-center whitespace-nowrap">
			<span class="meta-icon">
				<Icon name="material-symbols:comment-outline-rounded" class="text-xl"></Icon>
			</span>
			<span data-stat-comments class="text-50 text-sm font-medium">0 comments</span>
		</span>
	)}
</span>

<script>
	import { db } from "../lib/firebase";
	import {
		doc,
		getDoc,
		increment,
		onSnapshot,
		serverTimestamp,
		setDoc,
		updateDoc,
	} from "firebase/firestore";

	const goatCounterBaseUrl = "https://anubhaparashar.goatcounter.com/counter/";

	function numberValue(value: unknown): number {
		return typeof value === "number" && Number.isFinite(value) ? value : 0;
	}

	function plural(value: number, singular: string, pluralLabel: string): string {
		return `${value.toLocaleString()} ${value === 1 ? singular : pluralLabel}`;
	}

	function normalizePath(p: string): string {
		if (!p) return "/";
		if (p.length > 1 && p.endsWith("/")) return p.slice(0, -1);
		return p;
	}

	function normalizeLegacyId(value: string): string {
		return value
			.split("?")[0]
			.replace(/^\/+|\/+$/g, "")
			.toLowerCase()
			.normalize("NFKD")
			.replace(/[\u0300-\u036f]/g, "")
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-+|-+$/g, "");
	}

	async function fetchGoatCounterCount(path: string): Promise<number> {
		const candidates = Array.from(new Set([path, normalizePath(path)]));

		for (const candidate of candidates) {
			try {
				const response = await fetch(goatCounterBaseUrl + encodeURIComponent(candidate) + ".json");
				if (!response.ok) continue;
				const data = await response.json();
				const count = typeof data.count === "number" ? data.count : Number.parseInt(data.count, 10);
				if (Number.isFinite(count)) return count;
			} catch (error) {
				console.warn("GoatCounter fallback failed", error);
			}
		}

		return 0;
	}

	async function showGoatCounterFallback(root: HTMLElement) {
		const viewsEl = root.querySelector<HTMLElement>("[data-stat-views]");
		if (!viewsEl) return;

		const count = await fetchGoatCounterCount(root.dataset.path || "");
		if (count > 0) {
			viewsEl.textContent = plural(count, "view", "views");
		} else {
			viewsEl.textContent = "0 views";
		}
	}

	function showLikesFallback(root: HTMLElement) {
		const likesEl = root.querySelector<HTMLElement>("[data-stat-likes]");
		if (likesEl) likesEl.textContent = "0 likes";
	}

	function readStorage(key: string): string | null {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	}

	function writeStorage(key: string, value: string): void {
		try {
			localStorage.setItem(key, value);
		} catch {
			// Ignore storage failures.
		}
	}

	async function ensurePostDocument(postRef: ReturnType<typeof doc>, root: HTMLElement) {
		if (!db) return;
		const snapshot = await getDoc(postRef);

		if (!snapshot.exists()) {
			await setDoc(
				postRef,
				{
					title: root.dataset.title || "",
					path: root.dataset.path || "",
					slug: root.dataset.normalizedPostId || root.dataset.postId || "",
					views: 0,
					likes: 0,
					comments: 0,
					importedLegacyViews: 0,
					importedGiscusLikes: 0,
					importedGiscusComments: 0,
					createdAt: serverTimestamp(),
					updatedAt: serverTimestamp(),
				},
				{ merge: true },
			);
		}
	}

	async function readFirstDocument(collectionName: string, candidates: string[]) {
		if (!db) return null;
		for (const candidate of candidates) {
			if (!candidate) continue;
			const snapshot = await getDoc(doc(db, collectionName, candidate));
			if (snapshot.exists()) return snapshot.data();
		}
		return null;
	}

	async function readLegacyStats(root: HTMLElement) {
		const postId = root.dataset.normalizedPostId || root.dataset.postId || "";
		const path = root.dataset.path || "";
		const candidates = Array.from(
			new Set([
				postId,
				root.dataset.postId || "",
				normalizeLegacyId(postId),
				normalizeLegacyId(path),
				normalizeLegacyId(normalizePath(path)),
			]),
		);

		return (
			(await readFirstDocument("projectPosts", candidates)) ||
			(await readFirstDocument("postStats", candidates.filter((candidate) => candidate !== postId)))
		);
	}

	async function renderStats(
		root: HTMLElement,
		data: Record<string, unknown>,
		legacyData: Record<string, unknown> | null = null,
	) {
		const importedLegacyViews = numberValue(data.importedLegacyViews);
		const legacyViews = legacyData ? numberValue(legacyData.baseViews) || numberValue(legacyData.views) : 0;
		const firebaseViews = numberValue(data.views);
		const totalViews = importedLegacyViews > 0 ? importedLegacyViews + firebaseViews : firebaseViews + legacyViews;
		const importedLikes = numberValue(data.importedGiscusLikes);
		const legacyLikes = legacyData ? numberValue(legacyData.baseLikes) || numberValue(legacyData.likes) : 0;
		const totalLikes = importedLikes > 0 ? importedLikes + numberValue(data.likes) : numberValue(data.likes) + legacyLikes;
		const importedComments = numberValue(data.importedGiscusComments);
		const legacyComments = legacyData ? numberValue(legacyData.commentsCount) || numberValue(legacyData.comments) : 0;

		const viewsEl = root.querySelector<HTMLElement>("[data-stat-views]");
		const likesEl = root.querySelector<HTMLElement>("[data-stat-likes]");
		const commentsEl = root.querySelector<HTMLElement>("[data-stat-comments]");
		console.debug("[FirebasePostStats] views debug", {
			postId: root.dataset.normalizedPostId || root.dataset.postId || "",
			newPath: `postStats/${root.dataset.normalizedPostId || root.dataset.postId || ""}`,
			legacyPath: `projectPosts/${root.dataset.normalizedPostId || root.dataset.postId || ""}`,
			newViewsValue: firebaseViews,
			legacyViewsValue: legacyViews,
			legacyBaseViewsValue: importedLegacyViews,
			finalDisplayedViews: totalViews,
		});

		if (viewsEl) {
			if (totalViews > 0) {
				viewsEl.textContent = plural(totalViews, "view", "views");
			} else {
				const goatCounterViews = await fetchGoatCounterCount(root.dataset.path || "");
				viewsEl.textContent = plural(goatCounterViews, "view", "views");
			}
		}
		if (likesEl) likesEl.textContent = plural(totalLikes, "like", "likes");
		if (commentsEl) {
			const totalComments = importedComments > 0 ? importedComments + numberValue(data.comments) : numberValue(data.comments) + legacyComments;
			commentsEl.textContent = plural(totalComments, "comment", "comments");
		}
	}

	async function incrementViewsOnce(root: HTMLElement, postRef: ReturnType<typeof doc>) {
		if (!db) return;
		if (root.dataset.incrementViews !== "true") return;

		const postId = root.dataset.normalizedPostId || root.dataset.postId || "";
		const storageKey = `firebase-post-viewed:${postId}`;
		if (!postId || sessionStorage.getItem(storageKey) === "1") return;

		await updateDoc(postRef, {
			views: increment(1),
			updatedAt: serverTimestamp(),
		});
		sessionStorage.setItem(storageKey, "1");
	}

	function setupLike(root: HTMLElement, postRef: ReturnType<typeof doc>) {
		if (!db) return;
		const firestore = db;
		const button = root.querySelector<HTMLButtonElement>("[data-like-button]");
		if (!button) return;

		const postId = root.dataset.normalizedPostId || root.dataset.postId || "";
		const storageKey = `firebase-post-reacted:${postId}:heart`;
		const liked = postId && readStorage(storageKey) === "1";

		if (liked) {
			button.disabled = true;
			button.setAttribute("aria-label", "Post already liked");
		}

		button.addEventListener("click", async () => {
			if (!postId || button.disabled) return;
			button.disabled = true;

			try {
				await updateDoc(postRef, {
					likes: increment(1),
					updatedAt: serverTimestamp(),
				});
				await setDoc(
					doc(firestore, "postReactions", postId),
					{
						heart: increment(1),
						updatedAt: serverTimestamp(),
					},
					{ merge: true },
				);
				writeStorage(storageKey, "1");
				button.setAttribute("aria-label", "Post already liked");
			} catch (error) {
				button.disabled = false;
				console.warn("Firebase like failed", error);
			}
		});
	}

	async function initFirebasePostStats(root: HTMLElement) {
		if (root.dataset.firebaseInitialized === "true") return;
		root.dataset.firebaseInitialized = "true";

		const postId = root.dataset.normalizedPostId || root.dataset.postId || "";
		if (!postId) return;
		if (!db) {
			await showGoatCounterFallback(root);
			showLikesFallback(root);
			return;
		}

		const postRef = doc(db, "postStats", postId);
		const legacyData = await readLegacyStats(root);

		try {
			await ensurePostDocument(postRef, root);
			await incrementViewsOnce(root, postRef);

			onSnapshot(
				postRef,
				(snapshot) => {
					if (snapshot.exists()) void renderStats(root, snapshot.data(), legacyData);
					else if (legacyData) void renderStats(root, legacyData, legacyData);
					else showLikesFallback(root);
				},
				(error) => {
					console.warn("Firebase stats read failed", error);
					if (legacyData) {
						void renderStats(root, legacyData, legacyData);
					} else {
						const viewsEl = root.querySelector<HTMLElement>("[data-stat-views]");
						if (viewsEl) viewsEl.textContent = "0 views";
						showLikesFallback(root);
					}
				},
			);

			setupLike(root, postRef);
		} catch (error) {
			console.warn("Firebase stats unavailable", error);
			await showGoatCounterFallback(root);
			showLikesFallback(root);
		}
	}

	function initAllFirebasePostStats() {
		document
			.querySelectorAll<HTMLElement>("[data-firebase-post-stats]")
			.forEach((root) => {
				void initFirebasePostStats(root);
			});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAllFirebasePostStats, { once: true });
	} else {
		initAllFirebasePostStats();
	}

	document.addEventListener("astro:page-load", initAllFirebasePostStats);
	document.addEventListener("swup:contentReplaced", initAllFirebasePostStats);
	document.addEventListener("swup:page:view", initAllFirebasePostStats);
</script>
