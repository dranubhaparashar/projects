---
interface Props {
	postId: string;
	path: string;
	title: string;
}

const { postId, path, title } = Astro.props;
---

<section
	class="firebase-comments card-base rounded-xl p-5 mb-4"
	data-firebase-comments
	data-post-id={postId}
	data-path={path}
	data-title={title}
>
	<h2 class="text-xl font-bold text-90 mb-4">Comments</h2>
	<form data-comment-form class="flex flex-col gap-3 mb-5">
		<input
			data-comment-name
			type="text"
			maxlength="80"
			placeholder="Name"
			class="w-full rounded-lg bg-black/5 dark:bg-white/10 px-3 py-2 outline-none focus:ring-2 focus:ring-[var(--primary)]"
		/>
		<textarea
			data-comment-message
			maxlength="1000"
			rows="4"
			placeholder="Comment"
			class="w-full rounded-lg bg-black/5 dark:bg-white/10 px-3 py-2 outline-none focus:ring-2 focus:ring-[var(--primary)]"
		></textarea>
		<div class="flex items-center justify-between gap-3">
			<p data-comment-status class="text-sm text-neutral-500 dark:text-neutral-400"></p>
			<button type="submit" class="btn-regular px-4 py-2 rounded-lg font-medium">
				Post comment
			</button>
		</div>
	</form>
	<div data-comments-list class="flex flex-col gap-3"></div>
</section>

<script>
	import { db } from "../lib/firebase";
	import {
		addDoc,
		collection,
		doc,
		getDoc,
		getDocs,
		increment,
		onSnapshot,
		orderBy,
		query,
		serverTimestamp,
		setDoc,
		updateDoc,
	} from "firebase/firestore";

	function escapeHtml(value: string): string {
		return value.replace(/[&<>"']/g, (char) => {
			const entities: Record<string, string> = {
				"&": "&amp;",
				"<": "&lt;",
				">": "&gt;",
				'"': "&quot;",
				"'": "&#039;",
			};
			return entities[char] || char;
		});
	}

	function stringValue(value: unknown): string {
		return typeof value === "string" ? value.trim() : "";
	}

	function commentSourceLabel(source: string): string {
		if (source === "giscus") return "Imported from Giscus";
		if (source === "github") return "Imported from GitHub";
		return "Firebase";
	}

	function mergeCommentDocs(
		currentDocs: Array<{ data: () => Record<string, unknown> }>,
		legacyDocs: Array<{ data: () => Record<string, unknown> }>,
	) {
		const merged = new Map<string, { data: () => Record<string, unknown> }>();

		for (const item of currentDocs) {
			const data = item.data();
			const key = stringValue(data.sourceCommentId) || stringValue(data.id);
			if (key) merged.set(key, item);
		}

		for (const item of legacyDocs) {
			const data = item.data();
			const key = stringValue(data.sourceCommentId) || stringValue(data.id);
			if (key && !merged.has(key)) merged.set(key, item);
		}

		return Array.from(merged.values());
	}

	async function readLegacyComments(postId: string) {
		if (!db) return [];

		const legacyRef = collection(db, "projectPosts", postId, "comments");
		const snapshot = await getDocs(query(legacyRef, orderBy("createdAt", "asc")));
		return snapshot.docs;
	}

	async function ensurePostStatsDocument(statsRef: ReturnType<typeof doc>, root: HTMLElement) {
		if (!db) return;
		const snapshot = await getDoc(statsRef);
		if (snapshot.exists()) return;

		await setDoc(
			statsRef,
				{
					title: root.dataset.title || "",
					path: root.dataset.path || "",
					slug: root.dataset.postId || "",
					views: 0,
					likes: 0,
					comments: 0,
					importedLegacyViews: 0,
					importedGiscusLikes: 0,
					importedGiscusComments: 0,
					createdAt: serverTimestamp(),
					updatedAt: serverTimestamp(),
			},
			{ merge: true },
		);
	}

	function renderComments(root: HTMLElement, docs: Array<{ data: () => Record<string, unknown> }>) {
		const list = root.querySelector<HTMLElement>("[data-comments-list]");
		if (!list) return;

		if (docs.length === 0) {
			list.innerHTML = `<p class="text-sm text-neutral-500 dark:text-neutral-400">No comments yet.</p>`;
			return;
		}

		list.innerHTML = docs
			.map((item) => {
				const data = item.data();
				const name =
					stringValue(data.authorName) || stringValue(data.name) || "Anonymous";
				const message =
					stringValue(data.body) || stringValue(data.message);
				const avatarUrl = stringValue(data.authorAvatarUrl);
				const source = stringValue(data.source) || "firebase";
				const sourceId =
					stringValue(data.sourceCommentId) || stringValue(data.id);
				return `
					<article class="rounded-lg bg-black/5 dark:bg-white/10 px-4 py-3" data-comment-source="${escapeHtml(source)}" data-source-comment-id="${escapeHtml(sourceId)}">
						<div class="flex items-start gap-3">
							${avatarUrl ? `<img src="${escapeHtml(avatarUrl)}" alt="" class="w-9 h-9 rounded-full object-cover shrink-0 bg-black/10 dark:bg-white/10" loading="lazy" />` : ""}
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center justify-between gap-2 mb-1">
									<div class="font-medium text-90">${escapeHtml(name)}</div>
									${source === "giscus" || source === "github" ? `<span class="text-[0.7rem] uppercase tracking-wide text-neutral-500 dark:text-neutral-400">${escapeHtml(commentSourceLabel(source))}</span>` : ""}
								</div>
								<p class="text-75 whitespace-pre-wrap break-words">${escapeHtml(message)}</p>
							</div>
						</div>
					</article>
				`;
			})
			.join("");
	}

	async function initFirebaseComments(root: HTMLElement) {
		if (root.dataset.firebaseCommentsInitialized === "true") return;
		root.dataset.firebaseCommentsInitialized = "true";

		const postId = root.dataset.postId;
		if (!postId) return;
		if (!db) return;

		const statsRef = doc(db, "postStats", postId);
		const commentsRef = collection(db, "postComments", postId, "comments");
		const status = root.querySelector<HTMLElement>("[data-comment-status]");
		const form = root.querySelector<HTMLFormElement>("[data-comment-form]");
		const nameInput = root.querySelector<HTMLInputElement>("[data-comment-name]");
		const messageInput = root.querySelector<HTMLTextAreaElement>("[data-comment-message]");

		try {
			await ensurePostStatsDocument(statsRef, root);
			const legacyDocs = await readLegacyComments(postId);

			onSnapshot(
				query(commentsRef, orderBy("createdAt", "asc")),
				(snapshot) => {
					renderComments(root, mergeCommentDocs(snapshot.docs, legacyDocs));
				},
				(error) => {
					console.warn("Firebase comments read failed", error);
					renderComments(root, legacyDocs);
					if (status) status.textContent = "";
				},
			);
		} catch (error) {
			console.warn("Firebase comments unavailable", error);
			const legacyDocs = await readLegacyComments(postId);
			renderComments(root, legacyDocs);
			if (status) status.textContent = "";
		}

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();

			const name = nameInput?.value.trim() || "";
			const message = messageInput?.value.trim() || "";

			if (!name || !message) {
				if (status) status.textContent = "Name and comment are required.";
				return;
			}

			if (name.length > 80 || message.length > 1000) {
				if (status) status.textContent = "Comment is too long.";
				return;
			}

			const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
			if (button) button.disabled = true;
			if (status) status.textContent = "";

			try {
				await ensurePostStatsDocument(statsRef, root);
				const commentId =
					globalThis.crypto?.randomUUID?.() ||
					`firebase-${Date.now()}-${Math.random().toString(36).slice(2)}`;
				await addDoc(commentsRef, {
					id: commentId,
					postSlug: postId,
					name,
					authorName: name,
					authorAvatarUrl: "",
					message,
					body: message,
					source: "firebase",
					sourceCommentId: null,
					importedAt: null,
					createdAt: serverTimestamp(),
					updatedAt: serverTimestamp(),
				});
				await updateDoc(statsRef, {
					comments: increment(1),
					updatedAt: serverTimestamp(),
				});

				if (nameInput) nameInput.value = "";
				if (messageInput) messageInput.value = "";
				if (status) status.textContent = "Comment posted.";
			} catch (error) {
				console.warn("Firebase comment write failed", error);
				if (status) status.textContent = "Could not post comment.";
			} finally {
				if (button) button.disabled = false;
			}
		});
	}

	function initAllFirebaseComments() {
		document.querySelectorAll<HTMLElement>("[data-firebase-comments]").forEach((root) => {
			void initFirebaseComments(root);
		});
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initAllFirebaseComments, { once: true });
	} else {
		initAllFirebaseComments();
	}

	document.addEventListener("astro:page-load", initAllFirebaseComments);
	document.addEventListener("swup:contentReplaced", initAllFirebaseComments);
	document.addEventListener("swup:page:view", initAllFirebaseComments);
</script>
