---
import FirebasePostStats from "@components/FirebasePostStats.astro";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl, url } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
	viewsPath?: string;
	postId?: string;
	postTitle?: string;
	pdf?: string;
	incrementViews?: boolean;
	showLike?: boolean;
	showCommentsCount?: boolean;
	limitTagsToTwoLines?: boolean;
}

const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
	viewsPath,
	postId,
	postTitle = "",
	pdf = "",
	incrementViews = false,
	showLike = false,
	showCommentsCount = false,
	limitTagsToTwoLines = false,
} = Astro.props;

const className = Astro.props.class;
---

<div class:list={["post-meta flex flex-wrap text-neutral-500 dark:text-neutral-400 items-center gap-3 gap-x-4 gap-y-2 min-w-0", className]}>
	<!-- publish date -->
	<div class="flex items-center shrink-0">
		<div class="meta-icon">
			<Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl"></Icon>
		</div>
		<span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(published)}</span>
	</div>

	<!-- update date -->
	{!hideUpdateDate && updated && updated.getTime() !== published.getTime() && (
		<div class="flex items-center shrink-0">
			<div class="meta-icon">
				<Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl"></Icon>
			</div>
			<span class="text-50 text-sm font-medium">{formatDateToYYYYMMDD(updated)}</span>
		</div>
	)}

	<!-- category -->
	<div class="flex items-center min-w-0">
		<div class="meta-icon">
			<Icon name="material-symbols:book-2-outline-rounded" class="text-xl"></Icon>
		</div>
		<div class="flex flex-row flex-wrap items-center gap-y-1 min-w-0">
			<a
				href={getCategoryUrl(category)}
				aria-label={`View all posts in the ${category} category`}
				class="link-lg transition text-50 text-sm font-medium hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap"
			>
				{category || i18n(I18nKey.uncategorized)}
			</a>
		</div>
	</div>

	<!-- Firebase views, likes, and comments. GoatCounter remains initialized globally during migration. -->
	{viewsPath && postId && (
		<FirebasePostStats
			postId={postId}
			path={viewsPath}
			title={postTitle}
			incrementViews={incrementViews}
			showLike={showLike}
			showCommentsCount={showCommentsCount}
		/>
	)}

	{pdf && (
		<a
			href={url(pdf)}
			download
			target="_blank"
			rel="noopener noreferrer"
			class="inline-flex items-center gap-1 rounded-full border border-sky-500/20 bg-sky-500/10 px-2.5 py-1 text-[0.72rem] font-semibold text-sky-700 transition hover:bg-sky-500/15 hover:text-sky-800 dark:border-sky-300/20 dark:bg-sky-400/10 dark:text-sky-200 dark:hover:bg-sky-400/15"
			aria-label="Open project PDF"
		>
			<Icon name="material-symbols:download-rounded" class="text-[0.95rem]"></Icon>
			<span>PDF</span>
		</a>
	)}

	<!-- tags -->
	<div
		class:list={[
			"items-start min-w-0 max-w-full",
			{ "basis-full": limitTagsToTwoLines },
			{ "flex": !hideTagsForMobile, "hidden md:flex": hideTagsForMobile },
		]}
	>
		<div class="meta-icon shrink-0">
			<Icon name="material-symbols:tag-rounded" class="text-xl"></Icon>
		</div>
		<div
			class:list={[
				"flex flex-row flex-wrap items-center gap-y-1 min-w-0 max-w-full",
				{
					"gap-x-2 gap-y-1 max-h-[4rem] overflow-hidden tag-two-line-fade":
						limitTagsToTwoLines,
				},
			]}
		>
			{(tags && tags.length > 0) && tags.map((tag, i) => (
				<>
					{!limitTagsToTwoLines && (
						<div class:list={[{ "hidden": i == 0 }, "mx-1.5 text-[var(--meta-divider)] text-sm"]}>/</div>
					)}
					<a
						href={getTagUrl(tag)}
						aria-label={`View all posts with the ${tag.trim()} tag`}
						class:list={[
							"transition text-sm font-medium hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap",
							limitTagsToTwoLines
								? "rounded-full border border-sky-500/20 bg-sky-500/10 px-2.5 py-1 leading-5 text-sky-700 dark:text-sky-200 dark:bg-sky-400/10 dark:border-sky-300/20"
								: "link-lg text-50",
						]}
					>
						{tag.trim()}
					</a>
				</>
			))}
			{!(tags && tags.length > 0) && (
				<div class="transition text-50 text-sm font-medium">{i18n(I18nKey.noTags)}</div>
			)}
		</div>
	</div>
</div>

<style>
	.tag-two-line-fade {
		-webkit-mask-image: linear-gradient(
			to bottom,
			black 0%,
			black calc(100% - 0.45rem),
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			black 0%,
			black calc(100% - 0.45rem),
			transparent 100%
		);
	}
</style>
