PROJECT_AI_LLM_PROVIDER=ollama
PROJECT_AI_LLM_MODEL=qwen3:4b
PROJECT_AI_OLLAMA_URL=http://localhost:11434

# Used only when PROJECT_AI_LLM_PROVIDER=openai-compatible.
# This must be a self-hosted vLLM/llama.cpp-compatible service, not OpenAI.
PROJECT_AI_LLM_BASE_URL=

PROJECT_AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
PROJECT_AI_ALLOWED_ORIGINS=http://localhost:4321,https://dranubhaparashar.github.io

PROJECT_AI_SEMANTIC_TOP_K=12
PROJECT_AI_CONTEXT_TOP_K=8
PROJECT_AI_TOP_PROJECTS=5
PROJECT_AI_SEMANTIC_WEIGHT=0.65
PROJECT_AI_LEXICAL_WEIGHT=0.35

PROJECT_AI_MAX_QUESTION_LENGTH=1000
PROJECT_AI_REQUEST_TIMEOUT_SECONDS=25
PROJECT_AI_MAX_CONCURRENCY=2
PROJECT_AI_RATE_LIMIT_PER_MINUTE=20
PROJECT_AI_DEBUG_RETRIEVAL=false

